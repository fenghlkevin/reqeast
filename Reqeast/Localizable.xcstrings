    "No captured request is available. Send the request again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No captured request is available. Send the request again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保存发送时的请求，请重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有儲存傳送時的請求，請重新傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信時の記録がありません。再送信してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune requête capturée. Envoyez-la à nouveau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há registro da requisição. Envie novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una solicitud registrada. Envíala de nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 기록이 없습니다. 요청을 다시 보내세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Anfrage aufgezeichnet. Senden Sie sie erneut."
          }
        }
      }
    },
    "Connection, TLS handshake, redirects, and server wait are measured together. Separate TCP and TLS timings are unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection, TLS handshake, redirects, and server wait are measured together. Separate TCP and TLS timings are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接、TLS 握手、重定向和服务端等待合并计时，尚不支持独立的 TCP 与 TLS 耗时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線、TLS 握手、重新導向和伺服器等待合併計時，尚不支援獨立的 TCP 與 TLS 耗時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続、TLS、リダイレクト、サーバー待機はまとめて計測します。TCP と TLS の個別時間は取得できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion, TLS, redirections et attente serveur sont mesurés ensemble. Les durées TCP et TLS séparées ne sont pas disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexão, TLS, redirecionamentos e espera do servidor são medidos juntos. Tempos separados de TCP e TLS não estão disponíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión, TLS, redirecciones y espera del servidor se miden juntos. No hay tiempos separados de TCP y TLS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결, TLS, 리디렉션, 서버 대기를 함께 측정합니다. TCP와 TLS의 개별 시간은 제공되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung, TLS, Weiterleitungen und Serverwartezeit werden gemeinsam gemessen. Separate TCP- und TLS-Zeiten sind nicht verfügbar."
          }
        }
      }
    },
    "Copied reports omit bodies, cookies, credentials, and URL query values. Review the report before sharing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied reports omit bodies, cookies, credentials, and URL query values. Review the report before sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的报告不包含正文、Cookie、凭据及 URL 查询参数值，分享前请检查内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製的報告不包含本文、Cookie、憑證及 URL 查詢參數值，分享前請檢查內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーするレポートには本文、Cookie、認証情報、URL パラメータ値を含めません。共有前に内容を確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports copiés excluent les corps, cookies, identifiants et valeurs des paramètres URL. Vérifiez-les avant partage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relatórios copiados omitem corpos, cookies, credenciais e valores dos parâmetros da URL. Revise antes de compartilhar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes copiados omiten cuerpos, cookies, credenciales y valores de parámetros URL. Revísalos antes de compartir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 보고서에는 본문, 쿠키, 인증 정보, URL 매개변수 값이 포함되지 않습니다. 공유 전에 검토하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierte Berichte enthalten keine Inhalte, Cookies, Zugangsdaten oder URL-Parameterwerte. Prüfen Sie den Bericht vor dem Teilen."
          }
        }
      }
    },
    "Check the certificate hostname, expiry, and trusted issuer. The full TLS error is shown below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the certificate hostname, expiry, and trusted issuer. The full TLS error is shown below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查证书域名、有效期和受信任的签发机构，下方显示完整 TLS 错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查憑證網域、有效期和受信任的簽發機構，下方顯示完整 TLS 錯誤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書のホスト名、有効期限、信頼できる発行者を確認してください。TLS エラー全文を下に表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le nom d’hôte, la validité et l’émetteur du certificat. L’erreur TLS complète figure ci-dessous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o host, a validade e o emissor confiável do certificado. O erro TLS completo aparece abaixo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el host, la caducidad y el emisor del certificado. El error TLS completo aparece abajo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서의 호스트 이름, 만료일, 신뢰할 수 있는 발급자를 확인하세요. 전체 TLS 오류는 아래에 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Hostname, Gültigkeit und vertrauenswürdigen Aussteller des Zertifikats. Der vollständige TLS-Fehler steht unten."
          }
        }
      }
    },
    "Check the hostname, port, DNS, VPN, and whether the server is listening.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the hostname, port, DNS, VPN, and whether the server is listening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查主机名、端口、DNS、VPN，以及服务端是否正在监听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查主機名稱、連接埠、DNS、VPN，以及伺服器是否正在接聽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト名、ポート、DNS、VPN、サーバーの待ち受け状態を確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’hôte, le port, le DNS, le VPN et l’écoute du serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique host, porta, DNS, VPN e se o servidor está ouvindo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba host, puerto, DNS, VPN y si el servidor acepta conexiones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 이름, 포트, DNS, VPN과 서버 수신 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Hostname, Port, DNS, VPN und ob der Server Verbindungen annimmt."
          }
        }
      }
    },
    "The timeout does not identify a single failed phase. Check connectivity and server response time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeout does not identify a single failed phase. Check connectivity and server response time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超时无法确定具体失败阶段，请检查网络连接和服务端响应时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逾時無法確定具體失敗階段，請檢查網路連線和伺服器回應時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムアウトだけでは失敗した段階を特定できません。接続とサーバー応答時間を確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai dépassé ne précise pas la phase en échec. Vérifiez la connexion et le temps de réponse du serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo limite não identifica a etapa que falhou. Verifique a conexão e o tempo de resposta do servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de espera no identifica la fase fallida. Comprueba la conexión y la respuesta del servidor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 초과만으로 실패 단계를 알 수 없습니다. 연결과 서버 응답 시간을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeitüberschreitung identifiziert keine einzelne Fehlerphase. Prüfen Sie Verbindung und Serverantwortzeit."
          }
        }
      }
    },
