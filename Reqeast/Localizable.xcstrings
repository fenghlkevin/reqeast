    "Select an HTTP request and click the flowchart button in the editor toolbar. The panel contains Variables & Checks, Compare Responses, Run Requests, Inspect Request, and Project Files. You can also open this manual from Settings → User Manual.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an HTTP request and click the flowchart button in the editor toolbar. The panel contains Variables & Checks, Compare Responses, Run Requests, Inspect Request, and Project Files. You can also open this manual from Settings → User Manual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中 HTTP 请求，点击编辑器工具栏的流程图按钮。面板包含变量与检查、响应对比、批量运行、检查请求和项目文件。也可从“设置 → 使用手册”打开本手册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選 HTTP 請求並按工具列流程圖按鈕。面板含變數與檢查、回應比較、批次執行、檢查請求及專案檔案。設定 → 使用手冊也可開手冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエストでツールバーのフローチャートを押します。変数、比較、実行、確認、プロジェクトファイルがあります。設定の ユーザーマニュアルからも開けます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez HTTP et cliquez sur le diagramme de la barre d’outils. Le panneau propose variables, comparaison, exécution, inspection et fichiers. Le manuel est aussi dans Réglages → Manuel d’utilisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione HTTP e clique no fluxograma da barra. O painel tem variáveis, comparação, execução, inspeção e arquivos. O manual também fica em Ajustes → Manual do usuário."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione HTTP y pulse el diagrama de la barra. El panel incluye variables, comparación, ejecución, inspección y archivos. El manual está también en Ajustes → Manual de usuario."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청에서 도구 모음의 흐름도 버튼을 누르세요. 변수, 비교, 일괄 실행, 요청 확인, 프로젝트 파일을 제공합니다. 설정의 사용 설명서에서도 설명서를 열 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Anfrage wählen und Flussdiagramm in der Werkzeugleiste öffnen. Bereiche: Variablen, Vergleich, Lauf, Prüfung, Dateien. Handbuch auch unter Einstellungen → Benutzerhandbuch."
          }
        }
      }
    },
    "%@ has spec changes. Open RHEQ to review and apply them.": {
      "comment": "Push notification body when a linked spec has updates.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Spec-Änderungen. Öffnen Sie RHEQ, um sie zu prüfen und anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene cambios en la especificación. Abre RHEQ para revisarlos y aplicarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a des modifications de la spécification. Ouvrez RHEQ pour les examiner et les appliquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に仕様の変更があります。RHEQ を開いて確認し、適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 사양 변경 사항이 있습니다. RHEQ를 열어 검토하고 적용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem alterações na especificação. Abra o RHEQ para revisar e aplicá-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的规范有更改。打开 RHEQ 以审查并应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的規格有變更。開啟 RHEQ 以審查並套用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has spec changes. Open RHEQ to review and apply them."
          }
        }
      }
    },
    "Authorize RHEQ to read private Git repositories for %@ on %@.": {
      "comment": "A description of the app's access to GitHub.",
      "isCommentAutoGenerated": true,
      "localizations": {
