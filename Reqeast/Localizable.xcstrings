    "Response link saved. Run the source request before the target.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response link saved. Run the source request before the target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应引用已保存，请先运行来源请求，再运行目标请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
