    "Close the workflow panel, change the request or environment, and send again. Reopen Compare Responses and tap Compare with Baseline. Red shows the old value; green shows the new value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie das Fenster, ändern Sie Anfrage oder Umgebung und senden Sie erneut. Öffnen Sie Antworten vergleichen und vergleichen Sie mit der Referenz. Rot zeigt den alten Wert, Grün den neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the workflow panel, change the request or environment, and send again. Reopen Compare Responses and tap Compare with Baseline. Red shows the old value; green shows the new value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre el panel, cambie la solicitud o el entorno y envíe de nuevo. Reabra Comparar respuestas y compare con la referencia. Rojo indica el valor anterior; verde, el nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez le panneau, modifiez la requête ou l’environnement et renvoyez. Rouvrez Comparer les réponses et comparez à la référence. Le rouge montre l’ancienne valeur, le vert la nouvelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルを閉じ、リクエストや環境を変更して再送信します。「レスポンスの比較」を開き直し、「基準と比較」を押します。赤は旧値、緑は新値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널을 닫고 요청이나 환경을 바꾼 뒤 다시 보내세요. 응답 비교를 다시 열고 기준과 비교를 누르세요. 빨간색은 이전 값, 초록색은 새 값입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o painel, altere a requisição ou o ambiente e envie novamente. Reabra Comparar respostas e compare com a referência. Vermelho mostra o valor antigo; verde, o novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭工作流面板，修改请求或切换环境后再次发送。重新打开“响应对比”，点击“与基准对比”。红色显示旧值，绿色显示新值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉工作流程面板，修改請求或切換環境後再次傳送。重新開啟「回應比較」，點按「與基準比較」。紅色顯示舊值，綠色顯示新值。"
          }
        }
      }
    },
