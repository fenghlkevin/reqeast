    "%@ (%lld bytes) exceeds the 900 KB iCloud record limit. This item will not sync.": {
      "comment": "A warning banner at the top of the screen when a SpecDocument is too large to upload. The first argument is the string “SpecDocument/%arg”. The second argument is the size of the record in bytes.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld Bytes) überschreitet das 900-KB-iCloud-Datensatzlimit. Dieses Element wird nicht synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld bytes) exceeds the 900 KB iCloud record limit. This item will not sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld bytes) supera el límite de 900 KB del registro de iCloud. Este elemento no se sincronizará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld octets) dépasse la limite de 900 Ko pour les enregistrements iCloud. Cet élément ne sera pas synchronisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld バイト）は iCloud レコードの 900 KB 制限を超えています。この項目は同期されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$lld바이트)가 iCloud 레코드 900KB 제한을 초과합니다. 이 항목은 동기화되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld bytes) excede o limite de 900 KB do registro do iCloud. Este item não será sincronizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld 字节）超过 900 KB 的 iCloud 记录限制。此项目将不会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld 位元組）超過 900 KB 的 iCloud 記錄限制。此項目將不會同步。"
          }
        }
      }
    },
    "%@ (%lld bytes) exceeds the 900 KB iCloud record limit. This item will not sync. Reduce the body size or move large content to a file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld Bytes) überschreitet das iCloud-Datensatzlimit von 900 KB. Dieses Element wird nicht synchronisiert. Reduzieren Sie die Größe oder verschieben Sie große Inhalte in eine Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld bytes) supera el límite de 900 KB para registros de iCloud. Este elemento no se sincronizará. Reduce el tamaño o mueve el contenido grande a un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld octets) dépasse la limite de 900 Ko pour les enregistrements iCloud. Cet élément ne sera pas synchronisé. Réduisez la taille ou déplacez le contenu volumineux dans un fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld バイト）は iCloud レコードの 900 KB 制限を超えています。この項目は同期されません。サイズを減らすか、大きなコンテンツをファイルに移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$lld 바이트)이(가) iCloud 레코드 한도 900KB를 초과합니다. 이 항목은 동기화되지 않습니다. 크기를 줄이거나 큰 콘텐츠를 파일로 이동하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld bytes) excede o limite de 900 KB para registros do iCloud. Este item não será sincronizado. Reduza o tamanho ou mova o conteúdo grande para um arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld 字节）超过 iCloud 记录的 900 KB 限制。此项目将不会同步。请减小大小或将大内容移至文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld 位元組）超過 iCloud 記錄的 900 KB 限制。此項目將不會同步。請減小大小或將大型內容移至檔案。"
          }
        }
      }
    },
