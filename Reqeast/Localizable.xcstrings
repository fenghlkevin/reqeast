    "%@ support is planned for a future update.": {
      "comment": "A message explaining that a particular authentication type's support is planned for a future update. The argument is the name of the authentication type.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterstützung für %@ ist für ein zukünftiges Update geplant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El soporte para %@ está previsto en una actualización futura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prise en charge de %@ est prévue dans une future mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のサポートは今後のアップデートで追加予定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 지원은 향후 업데이트에서 추가될 예정입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte a %@ está previsto para uma atualização futura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 支持计划在未来的更新中推出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 支援計畫在未來的更新中推出。"
          }
        }
      }
    },
    "%@: server record is missing its data payload. Local edits were preserved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Der Serverdatensatz hat keine Datennutzlast. Lokale Bearbeitungen wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: el registro del servidor no tiene la carga de datos. Se conservaron las ediciones locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : l'enregistrement du serveur n'a pas de charge utile. Les modifications locales ont été conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: サーバーレコードにデータペイロードがありません。ローカルの編集が保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 서버 레코드에 데이터 페이로드가 없습니다. 로컬 편집이 유지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: o registro do servidor não tem a carga de dados. As edições locais foram preservadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：服务器记录缺少数据负载。已保留本地编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：伺服器記錄缺少資料負載。已保留本機編輯。"
          }
        }
      }
    },
