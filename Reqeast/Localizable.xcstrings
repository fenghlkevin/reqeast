    "Linked to %@. Use Check for updates to sync changes from the live spec.": {
      "comment": "A label that appears when a spec is imported from a URL. The argument is the hostname of the URL.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ verknüpft. Verwenden Sie Auf Updates prüfen, um Änderungen aus der verknüpften Spec zu synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado a %@. Usa Buscar actualizaciones para sincronizar cambios de la especificación activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lié à %@. Utilisez Vérifier les mises à jour pour synchroniser les modifications de la spécification active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にリンクされています。「更新を確認」で参照元仕様の変更を同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결되어 있습니다. 「업데이트 확인」으로 연결된 사양의 변경 사항을 동기화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado a %@. Use Verificar atualizações para sincronizar alterações da especificação ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已链接到 %@。使用“检查更新”同步联机规范的变更。"
