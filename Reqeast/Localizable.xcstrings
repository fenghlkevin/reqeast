    "Snapshot from %@ at %@. Changes to the spec won't appear automatically.": {
      "comment": "Disclaimer for URL-imported specs showing host and fetch time.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert von %1$@ um %2$@. Änderungen an der Spec werden nicht automatisch übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado desde %1$@ el %2$@. Los cambios en la especificación no se reflejarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé depuis %1$@ le %2$@. Les modifications de la spécification n'apparaîtront pas automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ から %2$@ にインポートしました。仕様の変更は自動的に反映されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 %2$@에 가져왔습니다. 사양 변경 사항은 자동으로 반영되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado de %1$@ em %2$@. Alterações na especificação não serão aplicadas automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "于 %2$@ 从 %1$@ 导入。规范的更改不会自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於 %2$@ 從 %1$@ 匯入。規格的變更不會自動同步。"
          }
        }
      }
    },
