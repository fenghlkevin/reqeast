          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherten Ablauf aktualisieren"
          }
        }
      }
    },
    "Use a CSV header or a JSON array with matching scalar fields. Limit: 1 MB and 1000 rows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a CSV header or a JSON array with matching scalar fields. Limit: 1 MB and 1000 rows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用含表头的 CSV 或字段一致的 JSON 对象数组，仅支持非空标量值。最大 1 MB、1000 行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用含標題列的 CSV 或欄位一致的 JSON 物件陣列，僅支援非空純量值。上限 1 MB、1000 列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出し付き CSV または同じフィールドの JSON 配列を使ってください。値は非 null の単一値で、1 MB・1000行以内です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un CSV avec en-tête ou un tableau JSON aux champs scalaires identiques. Limites : 1 Mo, 1000 lignes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use CSV com cabeçalho ou array JSON com campos escalares iguais. Limites: 1 MB e 1000 linhas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use CSV con cabecera o array JSON con campos escalares iguales. Límites: 1 MB y 1000 filas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤더가 있는 CSV 또는 같은 스칼라 필드의 JSON 배열을 사용하세요. 최대 1 MB, 1000행입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV mit Kopfzeile oder JSON-Array mit gleichen skalaren Feldern verwenden. Grenzen: 1 MB, 1000 Zeilen."
          }
        }
      }
    },
