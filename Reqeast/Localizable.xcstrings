    "JSON tools support responses up to 1 MB.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON-Werkzeuge unterstützen Antworten bis 1 MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON tools support responses up to 1 MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas JSON admiten respuestas de hasta 1 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils JSON acceptent des réponses jusqu’à 1 Mo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON ツールは 1 MB 以下のレスポンスに対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 도구는 최대 1 MB 응답을 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas JSON aceitam respostas de até 1 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 工具支持最大 1 MB 的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 工具支援最大 1 MB 的回應。"
          }
        }
      }
    },
    "JSON tools support responses up to 1 MB. This comparison checks JSON fields and HTTP status; it does not compare response headers or timing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON-Werkzeuge unterstützen bis 1 MB. Verglichen werden JSON-Felder und HTTP-Status, keine Antwortheader oder Zeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON tools support responses up to 1 MB. This comparison checks JSON fields and HTTP status; it does not compare response headers or timing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas JSON admiten hasta 1 MB. Se comparan campos JSON y estado HTTP, sin cabeceras ni tiempos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils JSON acceptent jusqu’à 1 Mo. La comparaison porte sur les champs JSON et le statut HTTP, sans les en-têtes ni la durée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON ツールは 1 MB 以下に対応します。比較対象は JSON フィールドと HTTP ステータスで、ヘッダーや時間は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 도구는 최대 1 MB를 지원합니다. JSON 필드와 HTTP 상태를 비교하며 응답 헤더와 시간은 비교하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas JSON aceitam até 1 MB. A comparação verifica campos JSON e status HTTP, sem comparar cabeçalhos ou tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 工具支持最大 1 MB 的响应。本功能对比 JSON 字段和 HTTP 状态码，不对比响应头或耗时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 工具支援最大 1 MB 的回應。本功能比較 JSON 欄位和 HTTP 狀態碼，不比較回應標頭或時間。"
          }
        }
      }
    },
