    "Select your test environment, then send a login request. The response must contain a JSON value such as a token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Testumgebung und senden Sie eine Anmeldeanfrage. Die Antwort muss einen JSON-Wert wie ein Token enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select your test environment, then send a login request. The response must contain a JSON value such as a token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione el entorno de prueba y envíe una solicitud de inicio de sesión. La respuesta debe contener un valor JSON, como un token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre environnement de test et envoyez une requête de connexion. La réponse doit contenir une valeur JSON, par exemple un token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト環境を選んでログインリクエストを送信します。レスポンスには token などの JSON 値が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 환경을 선택하고 로그인 요청을 보내세요. 응답에 token 같은 JSON 값이 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o ambiente de teste e envie uma requisição de login. A resposta deve conter um valor JSON, como um token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择测试环境并发送登录请求，响应中需要包含 token 等 JSON 值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇測試環境並傳送登入請求，回應中需包含 token 等 JSON 值。"
          }
        }
      }
    },
    "Send a request and open Compare Responses. Tap Save Current Response as Baseline. This JSON response stays on this device, including after restarting the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie eine Anfrage, öffnen Sie Antworten vergleichen und speichern Sie die aktuelle Antwort als Referenz. Dieses JSON bleibt auch nach einem Neustart auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a request and open Compare Responses. Tap Save Current Response as Baseline. This JSON response stays on this device, including after restarting the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe una solicitud, abra Comparar respuestas y guarde la respuesta actual como referencia. Este JSON permanece en el dispositivo tras reiniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une requête, ouvrez Comparer les réponses et enregistrez la réponse actuelle comme référence. Ce JSON reste sur cet appareil, même après un redémarrage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信後に「レスポンスの比較」を開き、「現在のレスポンスを基準として保存」を押します。JSON レスポンスはアプリを再起動してもこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 보낸 뒤 응답 비교를 열고 현재 응답을 기준으로 저장을 누르세요. 이 JSON 응답은 앱을 다시 시작해도 기기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie uma requisição, abra Comparar respostas e salve a resposta atual como referência. Esse JSON permanece no dispositivo após reiniciar o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送请求，打开“响应对比”，点击“将当前响应保存为基准”。这份 JSON 响应保存在本设备，重启程序后仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送請求，開啟「回應比較」，點按「將目前回應儲存為基準」。這份 JSON 回應儲存在本裝置，重新啟動程式後仍可使用。"
          }
        }
      }
    },
