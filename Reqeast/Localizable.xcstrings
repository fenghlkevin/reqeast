    "Choose a response field, name a variable, then use {{name}} in another request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Antwortfeld, benennen Sie eine Variable und verwenden Sie {{name}} in einer anderen Anfrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a response field, name a variable, then use {{name}} in another request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un campo, nombre una variable y use {{name}} en otra solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un champ, nommez une variable, puis utilisez {{name}} dans une autre requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レスポンスのフィールドに変数名を付け、別のリクエストで {{name}} を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 필드를 선택하고 변수 이름을 지정한 뒤 다른 요청에서 {{name}}을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um campo, nomeie uma variável e use {{name}} em outra requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择响应字段并命名变量，然后在其他请求中使用 {{name}}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇回應欄位並命名變數，再於其他請求中使用 {{name}}。"
          }
        }
      }
    },
