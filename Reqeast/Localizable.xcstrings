        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GET 요청을 사용하여 다른 URL에서 응답을 찾을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta pode ser encontrada em uma URL diferente usando uma requisição GET."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以使用 GET 请求在不同的 URL 找到响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以使用 GET 請求在不同的 URL 找到回應。"
          }
        }
      }
    },
    "The response provides status for multiple independent operations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort enthält den Status für mehrere unabhängige Operationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta proporciona el estado de múltiples operaciones independientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse fournit le statut de plusieurs opérations indépendantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レスポンスは複数の独立した操作のステータスを提供しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 여러 독립적인 작업의 상태를 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta fornece o status de múltiplas operações independentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应提供了多个独立操作的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應提供了多個獨立操作的狀態。"
          }
        }
      }
    },
    "The selected project could not be found.": {
      "comment": "Error when merge import target project is missing.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Projekt konnte nicht gefunden werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar el proyecto seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet sélectionné est introuvable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したプロジェクトが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 프로젝트를 찾을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
