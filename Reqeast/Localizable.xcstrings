    "Notify when the linked spec changes. Updates are never applied automatically.": {
      "comment": "A description of the background check toggle.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn sich die verknüpfte Spec ändert. Aktualisierungen werden niemals automatisch angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar cuando cambie la especificación vinculada. Las actualizaciones nunca se aplican automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsque la spécification liée change. Les mises à jour ne sont jamais appliquées automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクされた仕様が変更されたときに通知します。更新は自動的には適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 사양이 변경되면 알림을 보냅니다. 업데이트는 자동으로 적용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar quando a especificação vinculada mudar. As atualizações nunca são aplicadas automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
