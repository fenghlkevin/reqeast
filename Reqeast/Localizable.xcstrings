          }
        }
      }
    },
    "Rendered app view with fictional data. Click to enlarge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendered app view with fictional data. Click to enlarge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序界面渲染图，使用虚构示例数据。点击放大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式介面繪製圖，使用虛構範例資料。點擊放大。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "架空のデータで描画したアプリ画面です。クリックすると拡大します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue de l’application rendue avec des données fictives. Cliquez pour agrandir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela do aplicativo renderizada com dados fictícios. Clique para ampliar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de la aplicación con datos ficticios. Haz clic para ampliar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 데이터로 렌더링한 앱 화면입니다. 클릭하여 확대하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenderte App-Ansicht mit Beispieldaten. Zum Vergrößern klicken."
          }
        }
      }
    },
    "Import Java Spring Controller interfaces from IDEA without starting the backend. The plugin reads declarations and DTO fields, then opens a local export in RHEQ for review. It never sends API requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Java Spring Controller interfaces from IDEA without starting the backend. The plugin reads declarations and DTO fields, then opens a local export in RHEQ for review. It never sends API requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需启动后端，即可从 IDEA 导入 Java Spring Controller 接口。插件读取接口声明和 DTO 字段，将本地导出文件交给 RHEQ 预览，不会发送接口请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需啟動後端，即可從 IDEA 匯入 Java Spring Controller 介面。外掛讀取介面宣告及 DTO 欄位，將本機匯出檔案交給 RHEQ 預覽，不會傳送介面請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドを起動せず、IDEA から Java Spring Controller を読み込めます。プラグインは宣言と DTO フィールドを読み取り、ローカルファイルを RHEQ で確認します。API リクエストは送信しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez les interfaces Java Spring Controller depuis IDEA sans lancer le serveur. Le plugin lit les déclarations et les champs DTO, puis ouvre un fichier local dans RHEQ pour vérification. Il n’envoie aucune requête API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe interfaces Java Spring Controller do IDEA sem iniciar o servidor. O plugin lê declarações e campos DTO e abre um arquivo local no RHEQ para revisão. Nenhuma requisição à API é enviada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa interfaces Java Spring Controller desde IDEA sin iniciar el servidor. El complemento lee declaraciones y campos DTO y abre un archivo local en RHEQ para revisarlo. No envía solicitudes a la API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드를 실행하지 않고 IDEA의 Java Spring Controller 인터페이스를 가져옵니다. 플러그인은 선언과 DTO 필드를 읽어 로컬 파일을 RHEQ에서 검토하도록 엽니다. API 요청은 보내지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie Java-Spring-Controller aus IDEA, ohne das Backend zu starten. Das Plugin liest Deklarationen und DTO-Felder und öffnet eine lokale Datei zur Prüfung in RHEQ. Es sendet keine API-Anfragen."
          }
        }
      }
    },
    "In RHEQ Settings, open IDEA Integration and click Export IDEA Plugin. In IDEA Settings → Plugins, use the gear menu → Install Plugin from Disk. Select the ZIP and restart IDEA. The package supports IDEA 2026.2 on macOS with the Java plugin enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In RHEQ Settings, open IDEA Integration and click Export IDEA Plugin. In IDEA Settings → Plugins, use the gear menu → Install Plugin from Disk. Select the ZIP and restart IDEA. The package supports IDEA 2026.2 on macOS with the Java plugin enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 RHEQ 设置的「IDEA 集成」中点击「导出 IDEA 插件」。在 IDEA 的 Settings → Plugins 中打开齿轮菜单，选择 Install Plugin from Disk，选中 ZIP 并重启 IDEA。安装包支持 macOS 上的 IDEA 2026.2，需启用 Java 插件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 RHEQ 設定的「IDEA 整合」中點擊「匯出 IDEA 外掛」。在 IDEA 的 Settings → Plugins 中開啟齒輪選單，選擇 Install Plugin from Disk，選取 ZIP 並重新啟動 IDEA。套件支援 macOS 的 IDEA 2026.2，需啟用 Java 外掛。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RHEQ の設定で IDEA 連携からプラグインを書き出します。IDEA の Settings → Plugins の歯車メニューで Install Plugin from Disk を選び、ZIP を指定して再起動します。macOS の IDEA 2026.2 と有効な Java プラグインが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les réglages RHEQ, ouvrez Intégration IDEA et exportez le plugin. Dans IDEA : Settings → Plugins → menu engrenage → Install Plugin from Disk. Choisissez le ZIP et redémarrez IDEA. Le paquet prend en charge IDEA 2026.2 sur macOS avec le plugin Java activé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas configurações do RHEQ, abra Integração com IDEA e exporte o plugin. No IDEA: Settings → Plugins → engrenagem → Install Plugin from Disk. Escolha o ZIP e reinicie o IDEA. O pacote suporta IDEA 2026.2 no macOS com o plugin Java ativado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los ajustes de RHEQ, abre Integración con IDEA y exporta el complemento. En IDEA: Settings → Plugins → engranaje → Install Plugin from Disk. Selecciona el ZIP y reinicia IDEA. Requiere IDEA 2026.2 en macOS con el complemento Java activado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RHEQ 설정의 IDEA 연동에서 플러그인을 내보냅니다. IDEA의 Settings → Plugins → 톱니바퀴 메뉴 → Install Plugin from Disk에서 ZIP을 선택하고 재시작합니다. macOS용 IDEA 2026.2와 활성화된 Java 플러그인이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie das Plugin in den RHEQ-Einstellungen unter IDEA-Integration. In IDEA: Settings → Plugins → Zahnradmenü → Install Plugin from Disk. ZIP auswählen und IDEA neu starten. Unterstützt wird IDEA 2026.2 auf macOS mit aktiviertem Java-Plugin."
          }
        }
      }
    },
    "Wait for IDEA indexing to finish. Right-click inside a Java Controller method and choose RHEQ → Import Method into RHEQ. Use Import Controller into RHEQ for the current class, or select a module in the Project tree and choose Import Module into RHEQ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for IDEA indexing to finish. Right-click inside a Java Controller method and choose RHEQ → Import Method into RHEQ. Use Import Controller into RHEQ for the current class, or select a module in the Project tree and choose Import Module into RHEQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 IDEA 索引完成。在 Java Controller 方法内部右键，选择 RHEQ → 导入当前方法到 RHEQ。导入整个类时选择「导入 Controller 到 RHEQ」；导入模块时，在 Project 树选中模块，再选择「导入模块到 RHEQ」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 IDEA 索引完成。在 Java Controller 方法內按右鍵，選擇 RHEQ → 匯入目前方法至 RHEQ。匯入整個類別時選擇 Controller 動作；匯入模組時，在 Project 樹選取模組再選擇模組匯入動作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDEA のインデックス作成完了を待ちます。Java Controller のメソッド内を右クリックし、RHEQ のメソッド読み込みを選びます。クラス全体は Controller、Project ツリーで選んだモジュール全体は Module の読み込みを使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l’indexation IDEA. Dans une méthode Java Controller, faites un clic droit et choisissez RHEQ → Import Method into RHEQ. Utilisez l’action Controller pour la classe, ou sélectionnez un module dans Project et utilisez l’action Module."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a indexação do IDEA. Clique com o botão direito dentro de um método Java Controller e escolha a ação Method do RHEQ. Use Controller para a classe ou selecione um módulo na árvore Project e use Module."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la indexación de IDEA. Haz clic derecho dentro de un método Java Controller y elige la acción Method de RHEQ. Usa Controller para la clase o selecciona un módulo en Project y usa Module."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IDEA 색인이 끝날 때까지 기다립니다. Java Controller 메서드 안에서 우클릭하여 RHEQ의 Method 가져오기를 선택합니다. 클래스 전체는 Controller, Project 트리에서 선택한 모듈 전체는 Module 작업을 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis IDEA die Indizierung beendet hat. Rechtsklicken Sie in eine Java-Controller-Methode und wählen Sie die RHEQ-Aktion Method. Für die Klasse verwenden Sie Controller; für ein in Project ausgewähltes Modul die Aktion Module."
          }
        }
      }
    },
    "Enter the server address, port, and application context path. This address is independent of the Java package and module name. Review the interface count and warnings, then click Open in RHEQ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the server address, port, and application context path. This address is independent of the Java package and module name. Review the interface count and warnings, then click Open in RHEQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入服务器地址、端口和应用的 context-path，不要把 Java 包名或模块名当作地址。检查接口数量和警告，点击「在 RHEQ 中打开」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入伺服器位址、連接埠及應用程式的 context-path，不要把 Java 套件名或模組名當作位址。檢查介面數量及警告後，在 RHEQ 中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーアドレス、ポート、アプリの context-path を入力します。Java のパッケージ名やモジュール名とは別です。件数と警告を確認し、RHEQ で開きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’adresse du serveur, le port et le context-path de l’application, indépendamment du package Java et du module. Vérifiez le nombre d’interfaces et les avertissements, puis ouvrez dans RHEQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe endereço do servidor, porta e context-path da aplicação, independentemente do pacote Java e do módulo. Revise a quantidade de interfaces e os avisos e abra no RHEQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la dirección del servidor, el puerto y el context-path de la aplicación, independientes del paquete Java y del módulo. Revisa el número de interfaces y los avisos y abre en RHEQ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 주소, 포트, 애플리케이션의 context-path를 입력합니다. Java 패키지나 모듈 이름과는 별개입니다. 인터페이스 수와 경고를 확인하고 RHEQ에서 엽니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Serveradresse, Port und context-path der Anwendung ein. Java-Paket und Modulname sind davon unabhängig. Prüfen Sie Anzahl und Warnungen und öffnen Sie den Export in RHEQ."
          }
        }
      }
    },
    "In the RHEQ preview, choose New Project or an existing local project. Check the base URL, request list, and warnings. Uncheck interfaces you do not need. The + count means new requests; ↻ means matching requests will change. Click Import only after reviewing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the RHEQ preview, choose New Project or an existing local project. Check the base URL, request list, and warnings. Uncheck interfaces you do not need. The + count means new requests; ↻ means matching requests will change. Click Import only after reviewing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 RHEQ 预览中选择新项目或已有本地项目。检查基础地址、请求列表和警告，取消勾选不需要的接口。+ 表示新增请求，↻ 表示匹配请求会更新。检查后点击「导入」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 RHEQ 預覽中選擇新專案或既有本機專案。檢查基礎位址、請求清單及警告，取消勾選不需要的介面。+ 表示新增請求，↻ 表示符合的請求會更新。檢查後點擊「匯入」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RHEQ のプレビューで新規または既存のローカルプロジェクトを選びます。ベース URL、一覧、警告を確認し、不要な項目を外します。+ は追加、↻ は更新するリクエストです。確認後に読み込みます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans RHEQ, choisissez un nouveau projet ou un projet local existant. Vérifiez URL, liste et avertissements, puis décochez les interfaces inutiles. + indique les ajouts et ↻ les requêtes à actualiser. Confirmez ensuite l’importation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No RHEQ, escolha um projeto novo ou local existente. Revise URL, lista e avisos e desmarque interfaces desnecessárias. + indica novas requisições e ↻ as que serão atualizadas. Confirme a importação após revisar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En RHEQ, elige un proyecto nuevo o local existente. Revisa URL, lista y avisos y desmarca las interfaces innecesarias. + indica solicitudes nuevas y ↻ las que se actualizarán. Confirma la importación después de revisar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RHEQ 미리보기에서 새 프로젝트 또는 기존 로컬 프로젝트를 선택합니다. 기본 URL, 목록, 경고를 확인하고 불필요한 항목을 해제합니다. +는 신규 요청, ↻는 갱신될 요청입니다. 확인 후 가져옵니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in RHEQ ein neues oder vorhandenes lokales Projekt. Prüfen Sie URL, Liste und Warnungen und wählen Sie unnötige Schnittstellen ab. + zeigt neue Anfragen, ↻ Aktualisierungen. Bestätigen Sie danach den Import."
          }
        }
      }
    },
    "Select an imported request. Replace path variables such as {{id}} with test values, or define them in the active environment. Check query parameters, headers, and the generated body. DTO examples are placeholders. Configure authentication, start your backend, and click Send when ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an imported request. Replace path variables such as {{id}} with test values, or define them in the active environment. Check query parameters, headers, and the generated body. DTO examples are placeholders. Configure authentication, start your backend, and click Send when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中已导入的请求。把 {{id}} 等路径变量替换成测试值，或在当前环境中定义它们。检查查询参数、请求头和自动生成的请求体。DTO 示例只是占位值。配置认证，启动后端，准备好后点击「发送」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取已匯入的請求。將 {{id}} 等路徑變數替換成測試值，或在目前環境中定義。檢查查詢參數、標頭及產生的本文。DTO 範例僅為預填值。設定認證、啟動後端，準備好後傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだリクエストを選びます。{{id}} などをテスト値に置換するか、環境に定義します。クエリ、ヘッダー、生成されたボディを確認します。DTO の例は仮の値です。認証を設定し、バックエンドを起動してから送信します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une requête importée. Remplacez {{id}} et les autres variables par des valeurs de test ou définissez-les dans l’environnement actif. Vérifiez paramètres, en-têtes et corps généré. Les exemples DTO sont provisoires. Configurez l’authentification, lancez le serveur puis envoyez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma requisição importada. Substitua {{id}} e outras variáveis por valores de teste ou defina-as no ambiente ativo. Confira parâmetros, cabeçalhos e corpo gerado. Os exemplos DTO são provisórios. Configure a autenticação, inicie o servidor e envie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una solicitud importada. Sustituye {{id}} y otras variables por valores de prueba o defínelas en el entorno activo. Revisa parámetros, cabeceras y cuerpo generado. Los ejemplos DTO son provisionales. Configura la autenticación, inicia el servidor y envía."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 요청을 선택합니다. {{id}} 같은 경로 변수를 테스트 값으로 바꾸거나 활성 환경에 정의합니다. 쿼리, 헤더, 생성된 본문을 확인합니다. DTO 예시는 임시 값입니다. 인증을 설정하고 백엔드를 실행한 뒤 전송합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine importierte Anfrage. Ersetzen Sie {{id}} und andere Variablen durch Testwerte oder definieren Sie sie in der aktiven Umgebung. Prüfen Sie Parameter, Header und generierten Body. DTO-Beispiele sind Platzhalter. Richten Sie die Authentifizierung ein, starten Sie das Backend und senden Sie die Anfrage."
          }
        }
      }
    },
    "Run the same IDEA action again and select the same RHEQ project. Matching interfaces keep request IDs, authentication, test parameter values, and workflow references. Locally edited URLs and bodies are retained. Missing interfaces are not deleted. Renaming a class or method, changing its parameter signature, or moving the project may create new requests; review old requests manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the same IDEA action again and select the same RHEQ project. Matching interfaces keep request IDs, authentication, test parameter values, and workflow references. Locally edited URLs and bodies are retained. Missing interfaces are not deleted. Renaming a class or method, changing its parameter signature, or moving the project may create new requests; review old requests manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改代码后，再执行同一个 IDEA 动作，并选择同一个 RHEQ 项目。匹配接口会保留请求 ID、认证、测试参数值和工作流引用。本地改过的地址及请求体保留，消失的接口不删除。类名、方法名、参数签名变化或项目目录移动可能产生新请求，请手动核对旧请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改程式碼後，再執行相同的 IDEA 動作並選擇相同的 RHEQ 專案。符合的介面保留請求 ID、認證、測試參數及工作流程參照。本機修改的位址及本文保留，消失的介面不刪除。名稱、參數簽章或專案位置變更可能新增請求，請手動檢查舊請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更後は同じ IDEA アクションと RHEQ プロジェクトを使います。一致したリクエストの ID、認証、テスト値、ワークフロー参照は保持します。編集済み URL とボディ、消えたインターフェースも残ります。名前、引数の型、プロジェクト位置が変わると新規扱いになる場合があるため、古いリクエストを確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez la même action IDEA et choisissez le même projet RHEQ. Les ID, l’authentification, les valeurs de test et références de workflows sont conservés. Les URL et corps modifiés localement restent, ainsi que les interfaces absentes. Un changement de nom, signature ou emplacement du projet peut créer de nouvelles requêtes : vérifiez les anciennes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute a mesma ação no IDEA e escolha o mesmo projeto RHEQ. IDs, autenticação, valores de teste e referências dos fluxos são preservados. URLs e corpos editados localmente permanecem, assim como interfaces ausentes. Mudanças de nome, assinatura ou local do projeto podem criar novas requisições; revise as antigas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite la misma acción de IDEA y elige el mismo proyecto RHEQ. Se conservan los ID, autenticación, valores de prueba y referencias de flujos. Se mantienen las URL y cuerpos editados y las interfaces ausentes. Cambiar nombres, firmas o la ubicación del proyecto puede crear solicitudes nuevas; revisa las antiguas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 IDEA 작업을 다시 실행하고 같은 RHEQ 프로젝트를 선택합니다. 일치하는 요청의 ID, 인증, 테스트 값, 워크플로 참조를 유지합니다. 수정한 URL과 본문 및 사라진 인터페이스도 보존합니다. 이름, 매개변수 시그니처, 프로젝트 위치가 바뀌면 새 요청이 생길 수 있으므로 기존 요청을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie dieselbe IDEA-Aktion für dasselbe RHEQ-Projekt aus. IDs, Authentifizierung, Testwerte und Workflow-Verweise bleiben erhalten. Lokal bearbeitete URLs und Bodys sowie fehlende Schnittstellen bleiben bestehen. Neue Namen, Signaturen oder Projektpfade können neue Anfragen erzeugen; prüfen Sie alte Anfragen manuell."
          }
        }
      }
    },
    "This integration supports Java and common Spring web annotations. Kotlin, custom annotation aliases, wildcard or regex paths, and runtime path expressions need manual configuration. Inherited parameter annotations and mapping conditions require review. DTO nesting is limited to 8 levels and 100 fields per type; exports are limited to 2000 interfaces and 5 MB. If no preview opens, check that RHEQ is installed in /Applications and inspect the error in IDEA.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This integration supports Java and common Spring web annotations. Kotlin, custom annotation aliases, wildcard or regex paths, and runtime path expressions need manual configuration. Inherited parameter annotations and mapping conditions require review. DTO nesting is limited to 8 levels and 100 fields per type; exports are limited to 2000 interfaces and 5 MB. If no preview opens, check that RHEQ is installed in /Applications and inspect the error in IDEA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Java 和常见 Spring Web 注解。Kotlin、自定义注解别名、通配符或正则路径及运行时路径表达式需要手动配置。继承参数注解和映射条件需要核对。DTO 最多 8 层、每种类型 100 个字段；每次最多 2000 个接口、5 MB。预览未打开时，请检查 /Applications 中的 RHEQ，并查看 IDEA 报错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 Java 及常見 Spring Web 註解。Kotlin、自訂註解別名、萬用字元或正規表示式路徑及執行時期路徑需手動設定。繼承參數註解及對應條件需核對。DTO 最多 8 層、每類型 100 欄位；匯出最多 2000 介面、5 MB。無法開啟預覽時請檢查 /Applications 中的 RHEQ 及 IDEA 錯誤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Java と一般的な Spring Web 注釈に対応します。Kotlin、独自注釈、ワイルドカード・正規表現・実行時のパスは手動設定が必要です。継承した引数注釈とマッピング条件も確認してください。DTO は 8 階層、型ごとに 100 フィールド、書き出しは 2000 件・5 MB までです。開かない場合は /Applications の RHEQ と IDEA のエラーを確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Java et les annotations Spring Web courantes sont pris en charge. Kotlin, alias personnalisés, chemins à jokers, regex ou expressions dynamiques nécessitent une configuration manuelle. Vérifiez les annotations héritées et conditions de mapping. Limites : DTO sur 8 niveaux, 100 champs par type, 2000 interfaces et 5 Mo. Si rien ne s’ouvre, vérifiez RHEQ dans /Applications et l’erreur IDEA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suporta Java e anotações Spring Web comuns. Kotlin, aliases personalizados, caminhos com curingas, regex ou expressões dinâmicas exigem configuração manual. Revise anotações herdadas e condições de mapeamento. Limites: 8 níveis DTO, 100 campos por tipo, 2000 interfaces e 5 MB. Se a prévia não abrir, confira RHEQ em /Applications e o erro no IDEA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admite Java y anotaciones Spring Web comunes. Kotlin, alias personalizados, rutas con comodines, regex o expresiones dinámicas requieren configuración manual. Revisa anotaciones heredadas y condiciones. Límites: DTO de 8 niveles, 100 campos por tipo, 2000 interfaces y 5 MB. Si no se abre la vista previa, comprueba RHEQ en /Applications y el error de IDEA."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Java와 일반적인 Spring Web 어노테이션을 지원합니다. Kotlin, 사용자 정의 별칭, 와일드카드·정규식·동적 경로는 수동 설정이 필요합니다. 상속한 매개변수 어노테이션과 매핑 조건을 검토하세요. DTO는 8단계, 타입별 100필드, 내보내기는 2000개와 5 MB까지입니다. 미리보기가 안 열리면 /Applications의 RHEQ와 IDEA 오류를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Java und übliche Spring-Web-Annotationen werden unterstützt. Kotlin, eigene Aliase, Platzhalter-, Regex- und dynamische Pfade müssen manuell konfiguriert werden. Prüfen Sie geerbte Parameterannotationen und Bedingungen. Grenzen: 8 DTO-Ebenen, 100 Felder pro Typ, 2000 Schnittstellen und 5 MB. Falls keine Vorschau erscheint, prüfen Sie RHEQ in /Applications und den IDEA-Fehler."
          }
        }
      }
    },
