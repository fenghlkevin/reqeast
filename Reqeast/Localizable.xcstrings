    "The request failed because it depended on another request that failed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage ist fehlgeschlagen, weil sie von einer anderen fehlgeschlagenen Anfrage abhing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud falló porque dependía de otra solicitud que falló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête a échoué car elle dépendait d'une autre requête qui a échoué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存する別のリクエストが失敗したため、リクエストが失敗しました。"
