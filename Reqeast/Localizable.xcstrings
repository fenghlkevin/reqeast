    "Required for GitHub Enterprise and self-hosted Git. Trusted hosts may use HTTP and internal IP addresses.": {
      "comment": "A description of the trusted hosts feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich für GitHub Enterprise und selbst gehostetes Git. Vertrauenswürdige Hosts dürfen HTTP und interne IP-Adressen verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requerido para GitHub Enterprise y Git autohospedado. Los hosts de confianza pueden usar HTTP y direcciones IP internas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis pour GitHub Enterprise et Git auto-hébergé. Les hôtes de confiance peuvent utiliser HTTP et des adresses IP internes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Enterprise およびセルフホスト Git に必要です。信頼できるホストは HTTP と内部 IP アドレスを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Enterprise 및 자체 호스팅 Git에 필요합니다. 신뢰할 수 있는 호스트는 HTTP 및 내부 IP 주소를 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para GitHub Enterprise e Git auto-hospedado. Hosts confiáveis podem usar HTTP e endereços IP internos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Enterprise 和自托管 Git 需要此项。受信任的主机可使用 HTTP 和内部 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Enterprise 和自託管 Git 需要此項。受信任的主機可使用 HTTP 和內部 IP 位址。"
          }
        }
      }
    },
    "Reserved for future use. Originally intended for digital payment systems.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
