          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollwert"
          }
        }
      }
    },
    "Captured before redirects; transport-generated headers are not included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured before redirects; transport-generated headers are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的是重定向前的请求配置，不含网络层自动生成的请求头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄的是重新導向前的請求設定，不含網路層自動產生的標頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リダイレクト前の設定です。通信層が自動生成するヘッダーは含まれません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration avant redirections ; les en-têtes générés par le transport ne sont pas inclus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuração antes dos redirecionamentos; cabeçalhos gerados pelo transporte não estão incluídos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración anterior a las redirecciones; no incluye las cabeceras generadas por el transporte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리디렉션 전의 설정이며 전송 계층이 자동 생성한 헤더는 포함하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration vor Weiterleitungen; automatisch erzeugte Transportheader sind nicht enthalten."
          }
        }
      }
    },
    "Choose & Reorder Requests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose & Reorder Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择请求与调整顺序"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇請求與調整順序"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストの選択と並べ替え"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir et réordonner les requêtes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher e ordenar requisições"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir y ordenar solicitudes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 선택 및 순서 변경"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen auswählen und anordnen"
          }
        }
      }
    },
    "Create two HTTP requests in one project and select an environment. Configure the login URL, method and body, then send it. Confirm a successful JSON response with a non-null token field. These paths are examples; use your API's actual fields.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create two HTTP requests in one project and select an environment. Configure the login URL, method and body, then send it. Confirm a successful JSON response with a non-null token field. These paths are examples; use your API's actual fields."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一项目中新建两个 HTTP 请求并选择环境。配置登录接口的 URL、方法和正文后发送，确认成功响应是 JSON 且 token 不为 null。以下路径仅为示例，请使用真实接口字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一專案中建立兩個 HTTP 請求並選擇環境。設定登入的 URL、方法和本文後傳送，確認成功回應為 JSON 且 token 不為 null。以下路徑僅為範例，請使用實際欄位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じプロジェクトに HTTP リクエストを2つ作り、環境を選びます。ログインの URL、メソッド、本文を設定して送信し、成功した JSON 応答に null でない token があることを確認します。パスは例です。実際の API のフィールドを使ってください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez deux requêtes HTTP dans un projet et choisissez un environnement. Configurez URL, méthode et corps de connexion, puis envoyez. Vérifiez une réponse JSON réussie avec un token non nul. Les chemins sont des exemples ; utilisez vos champs réels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie duas requisições HTTP no mesmo projeto e selecione um ambiente. Configure URL, método e corpo do login e envie. Confirme uma resposta JSON bem-sucedida com token não nulo. Os caminhos são exemplos; use os campos reais da API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea dos solicitudes HTTP en el mismo proyecto y selecciona un entorno. Configura URL, método y cuerpo del inicio de sesión y envía. Confirma una respuesta JSON correcta con token no nulo. Las rutas son ejemplos; usa los campos reales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 프로젝트에 HTTP 요청 두 개를 만들고 환경을 선택하세요. 로그인 URL, 메서드, 본문을 설정하고 전송한 뒤 성공한 JSON 응답에 null이 아닌 token이 있는지 확인하세요. 경로는 예시이므로 실제 API 필드를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie zwei HTTP-Anfragen im selben Projekt und wählen Sie eine Umgebung. Konfigurieren Sie Login-URL, Methode und Inhalt und senden Sie. Prüfen Sie eine erfolgreiche JSON-Antwort mit einem nicht leeren token. Pfade sind Beispiele; verwenden Sie Ihre API-Felder."
          }
        }
      }
    },
    "Set the response field to /data/token, variable name to token, target to Orders, and header to Authorization. Click Create Response Link. This saves rules, not the current token. Run Login again before Orders. Authorization replaces the target's previous automatic authentication; other headers keep it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the response field to /data/token, variable name to token, target to Orders, and header to Authorization. Click Create Response Link. This saves rules, not the current token. Run Login again before Orders. Authorization replaces the target's previous automatic authentication; other headers keep it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应字段填 /data/token，变量名填 token，目标选择订单请求，请求头填 Authorization，再点击“创建响应引用”。保存的是规则，不是当前 token，请重新运行登录后再运行订单请求。Authorization 引用会替换目标原有的自动认证，其他请求头保留原认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應欄位填 /data/token，變數名稱填 token，目標選擇訂單請求，標頭填 Authorization，再點擊「建立回應引用」。儲存的是規則而非目前 token，請重新執行登入再執行訂單。Authorization 引用會取代原有自動驗證，其他標頭保留原驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドを /data/token、変数名を token、対象を Orders、ヘッダーを Authorization にして参照を作成します。保存されるのは規則です。現在の token は保存されないので、Login を再実行してから Orders を実行します。Authorization は既存の自動認証を置き換えます。他のヘッダーでは認証を維持します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez /data/token, la variable token, la cible Orders et l’en-tête Authorization, puis créez la référence. Seules les règles sont enregistrées. Relancez Login avant Orders. Authorization remplace l’authentification automatique existante ; les autres en-têtes la conservent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use /data/token, variável token, destino Orders e cabeçalho Authorization; crie a referência. Isso salva regras, não o token atual. Execute Login novamente antes de Orders. Authorization substitui a autenticação automática anterior; outros cabeçalhos a mantêm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa /data/token, variable token, destino Orders y cabecera Authorization; crea la referencia. Se guardan reglas, no el token actual. Ejecuta Login otra vez antes de Orders. Authorization reemplaza la autenticación automática anterior; otras cabeceras la conservan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필드는 /data/token, 변수는 token, 대상은 Orders, 헤더는 Authorization으로 설정하고 참조를 만드세요. 현재 토큰이 아닌 규칙이 저장됩니다. Login을 다시 실행한 뒤 Orders를 실행하세요. Authorization은 기존 자동 인증을 대체하고 다른 헤더는 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie /data/token, Variable token, Ziel Orders und Header Authorization und erstellen Sie die Referenz. Es werden Regeln gespeichert, nicht der aktuelle Token. Führen Sie Login erneut vor Orders aus. Authorization ersetzt die bisherige automatische Authentifizierung; andere Header behalten sie bei."
          }
        }
      }
    },
    "In Run Requests, expand Choose & Reorder Requests. Check Login and Orders, uncheck unrelated requests, and move Login above Orders with the arrows. Numbers show the actual run order. Enter a workflow name, select its environment, and click Save Workflow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Run Requests, expand Choose & Reorder Requests. Check Login and Orders, uncheck unrelated requests, and move Login above Orders with the arrows. Numbers show the actual run order. Enter a workflow name, select its environment, and click Save Workflow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“运行请求”中展开“选择请求与调整顺序”。勾选登录和订单，取消无关请求，用箭头把登录移到订单之前。编号就是实际顺序。填写流程名称，选择环境，点击“保存流程”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「執行請求」中展開「選擇請求與調整順序」。勾選登入和訂單，取消無關請求，用箭頭把登入移到訂單之前。編號就是實際順序。填寫流程名稱、選擇環境並儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト実行で選択と並べ替えを開きます。Login と Orders を選び、無関係な項目を外し、矢印で Login を先に移動します。番号が実行順です。名前と環境を指定して保存します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’exécution, développez le choix et l’ordre des requêtes. Cochez Login et Orders, décochez les autres et placez Login avant Orders avec les flèches. Les numéros donnent l’ordre réel. Nommez le scénario, choisissez l’environnement et enregistrez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na execução, expanda a seleção e ordenação. Marque Login e Orders, desmarque as demais e mova Login antes de Orders com as setas. Os números indicam a ordem real. Informe o nome, selecione o ambiente e salve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la ejecución, abre la selección y ordenación. Marca Login y Orders, desmarca las demás y mueve Login antes de Orders con las flechas. Los números indican el orden real. Introduce nombre y entorno y guarda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 실행에서 요청 선택 및 순서 변경을 펼치세요. Login과 Orders를 선택하고 나머지는 해제한 뒤 화살표로 Login을 앞에 놓으세요. 번호가 실제 실행 순서입니다. 이름과 환경을 지정하고 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie in der Ausführung die Auswahl und Reihenfolge. Aktivieren Sie Login und Orders, deaktivieren Sie andere und verschieben Sie Login mit den Pfeilen vor Orders. Zahlen zeigen die tatsächliche Reihenfolge. Geben Sie Namen und Umgebung an und speichern Sie."
          }
        }
      }
    },
    "If a variable is missing, check the selected environment, enabled extraction rule, spelling, and source order. If no response fields appear, send the source first and check that its response is valid JSON under 1 MB. Field paths start with /; nested fields use /data/token. Links create headers; URL and body references must be entered as {{token}} manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a variable is missing, check the selected environment, enabled extraction rule, spelling, and source order. If no response fields appear, send the source first and check that its response is valid JSON under 1 MB. Field paths start with /; nested fields use /data/token. Links create headers; URL and body references must be entered as {{token}} manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变量缺失时检查所选环境、已启用的提取规则、名称拼写和来源顺序。没有响应字段时，先发送来源请求，确认响应为有效 JSON 且小于 1 MB。字段路径以 / 开头，例如 /data/token。自动引用只创建请求头；URL 和正文中的 {{token}} 需手动填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變數缺少時檢查所選環境、啟用的擷取規則、拼字和來源順序。沒有回應欄位時，先傳送來源請求，確認回應是有效 JSON 且小於 1 MB。路徑以 / 開頭，例如 /data/token。自動引用只建立標頭；URL 和本文的 {{token}} 需手動填入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数不足なら環境、抽出規則の有効状態、名前、順序を確認します。フィールドが表示されない場合は参照元を送信し、1 MB 未満の有効な JSON か確認します。パスは / で始めます。参照作成はヘッダーのみで、URL や本文の {{token}} は手入力します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une variable manque, vérifiez environnement, extraction activée, orthographe et ordre. Sans champs, envoyez la source et vérifiez un JSON valide de moins de 1 Mo. Les chemins commencent par /, comme /data/token. Les références créent des en-têtes ; saisissez {{token}} manuellement dans URL et corps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar variável, verifique ambiente, extração ativa, nome e ordem. Sem campos, envie a origem e confirme JSON válido abaixo de 1 MB. Caminhos começam com /, como /data/token. Referências criam cabeçalhos; insira {{token}} manualmente na URL e no corpo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta una variable, comprueba entorno, extracción activa, nombre y orden. Sin campos, envía el origen y verifica JSON válido de menos de 1 MB. Las rutas empiezan por /, como /data/token. Las referencias crean cabeceras; introduce {{token}} manualmente en URL y cuerpo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수가 없으면 환경, 활성 추출 규칙, 이름, 순서를 확인하세요. 필드가 없으면 원본을 보내고 1 MB 미만의 유효한 JSON인지 확인하세요. 경로는 /로 시작하며 예시는 /data/token입니다. 참조는 헤더만 만들며 URL과 본문의 {{token}}은 직접 입력합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei fehlenden Variablen prüfen Sie Umgebung, aktive Extraktion, Namen und Reihenfolge. Ohne Felder senden Sie die Quelle und prüfen gültiges JSON unter 1 MB. Pfade beginnen mit /, etwa /data/token. Referenzen erstellen Header; {{token}} in URL und Inhalt tragen Sie manuell ein."
          }
        }
      }
    },
    "Expand Sent Request to review the prepared URL, headers and body from that send. Editing the environment afterward does not change this record. It excludes transport-added headers and later redirects. After restarting RHEQ, send again to recreate the record. Opening Diagnostics or Inspect Request never sends a request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand Sent Request to review the prepared URL, headers and body from that send. Editing the environment afterward does not change this record. It excludes transport-added headers and later redirects. After restarting RHEQ, send again to recreate the record. Opening Diagnostics or Inspect Request never sends a request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开“发送时的请求”，查看当时准备的 URL、请求头和正文。之后修改环境不会改变记录。记录不含网络层自动请求头和后续重定向。重启 RHEQ 后需重新发送才能生成记录。打开诊断或检查请求不会发送请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開「傳送時的請求」，查看當時準備的 URL、標頭和本文。之後修改環境不會改變記錄。記錄不含網路層自動標頭和後續重新導向。重啟 RHEQ 後需重新傳送。開啟診斷或檢查請求不會傳送請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信したリクエストを開くと、その時点の URL、ヘッダー、本文を確認できます。後の環境編集では記録は変わりません。自動ヘッダーと後続リダイレクトは含みません。再起動後は再送信が必要です。診断を開くだけでは送信しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez la requête envoyée pour voir URL, en-têtes et corps préparés. Modifier l’environnement ne change pas ce relevé. Il exclut en-têtes automatiques et redirections ultérieures. Après redémarrage, renvoyez pour le recréer. Ouvrir le diagnostic ou l’inspection n’envoie rien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda a requisição enviada para ver URL, cabeçalhos e corpo preparados. Editar o ambiente não altera o registro. Ele exclui cabeçalhos automáticos e redirecionamentos posteriores. Após reiniciar, envie de novo. Abrir diagnóstico ou inspeção não envia requisições."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la solicitud enviada para ver URL, cabeceras y cuerpo preparados. Editar el entorno no cambia el registro. Excluye cabeceras automáticas y redirecciones posteriores. Tras reiniciar, vuelve a enviar. Abrir diagnóstico o inspección no envía solicitudes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송한 요청을 펼쳐 당시 URL, 헤더, 본문을 확인하세요. 이후 환경 수정은 기록을 바꾸지 않습니다. 자동 헤더와 후속 리디렉션은 포함되지 않습니다. 재시작 후에는 다시 보내야 기록됩니다. 진단이나 검사 화면을 여는 것만으로는 전송되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die gesendete Anfrage für vorbereitete URL, Header und Inhalt. Spätere Umgebungsänderungen ändern die Aufzeichnung nicht. Automatische Header und spätere Weiterleitungen fehlen. Nach einem Neustart müssen Sie erneut senden. Diagnose und Prüfung senden keine Anfragen."
          }
        }
      }
    },
    "For connection errors, check DNS, host, port and VPN. For TLS errors, read the certificate cause. A timeout cannot identify one failed phase. HTTP 4xx or 5xx means a response arrived; check status and body. Redirect and certificate details appear only when the completed response includes them. Total duration includes the response download.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For connection errors, check DNS, host, port and VPN. For TLS errors, read the certificate cause. A timeout cannot identify one failed phase. HTTP 4xx or 5xx means a response arrived; check status and body. Redirect and certificate details appear only when the completed response includes them. Total duration includes the response download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接错误先检查 DNS、主机、端口和 VPN；TLS 错误查看证书原因。超时无法确定具体阶段。HTTP 4xx 或 5xx 表示已收到响应，应检查状态码和正文。只有完成的响应带有相应数据时才显示重定向和证书详情。总耗时包含响应下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線錯誤先檢查 DNS、主機、連接埠和 VPN；TLS 錯誤查看憑證原因。逾時無法確定具體階段。HTTP 4xx 或 5xx 表示已收到回應，請檢查狀態碼和本文。只有完成回應帶有資料時才顯示重新導向和憑證詳情。總耗時包含下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続エラーでは DNS、ホスト、ポート、VPN を確認し、TLS エラーでは証明書の原因を読みます。タイムアウトだけでは段階は特定できません。HTTP 4xx/5xx は応答を受信済みなので状態と本文を確認します。リダイレクトと証明書は応答に情報がある場合のみ表示します。総時間にはダウンロードを含みます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une erreur de connexion, vérifiez DNS, hôte, port et VPN ; pour TLS, la cause du certificat. Un délai dépassé n’identifie pas une phase. HTTP 4xx/5xx signifie qu’une réponse est arrivée : vérifiez statut et corps. Redirections et certificat nécessitent des données dans la réponse terminée. La durée inclut le téléchargement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em erro de conexão, verifique DNS, host, porta e VPN; em TLS, a causa do certificado. Tempo limite não identifica uma etapa. HTTP 4xx/5xx indica resposta recebida: verifique status e corpo. Redirecionamentos e certificado aparecem quando há dados na resposta concluída. O total inclui o download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En errores de conexión, comprueba DNS, host, puerto y VPN; en TLS, la causa del certificado. El tiempo de espera no identifica una fase. HTTP 4xx/5xx indica respuesta recibida: revisa estado y cuerpo. Redirecciones y certificado aparecen si la respuesta completa los incluye. El total incluye la descarga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 오류는 DNS, 호스트, 포트, VPN을, TLS 오류는 인증서 원인을 확인하세요. 시간 초과만으로 단계는 알 수 없습니다. HTTP 4xx/5xx는 응답을 받았다는 뜻이므로 상태와 본문을 확인하세요. 리디렉션과 인증서는 완료된 응답에 정보가 있을 때만 표시됩니다. 총 시간은 다운로드를 포함합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Verbindungsfehlern prüfen Sie DNS, Host, Port und VPN, bei TLS die Zertifikatsursache. Eine Zeitüberschreitung identifiziert keine Phase. HTTP 4xx/5xx bedeutet eine empfangene Antwort: prüfen Sie Status und Inhalt. Weiterleitungen und Zertifikat erscheinen nur mit Daten in einer abgeschlossenen Antwort. Die Gesamtdauer enthält den Download."
          }
        }
      }
    },
