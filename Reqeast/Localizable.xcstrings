          "stringUnit": {
            "state": "translated",
            "value": "코드 변경 후 갱신"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Codeänderungen aktualisieren"
          }
        }
      }
    },
    "Check unsupported mappings": {
