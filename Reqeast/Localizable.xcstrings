    "Run sends real requests, including POST and DELETE. Review the selected requests and active environment first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden echte Anfragen gesendet, auch POST und DELETE. Prüfen Sie vorher die Auswahl und die aktive Umgebung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run sends real requests, including POST and DELETE. Review the selected requests and active environment first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución envía solicitudes reales, incluidas POST y DELETE. Revise primero la selección y el entorno activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exécution envoie de vraies requêtes, dont POST et DELETE. Vérifiez d’abord la sélection et l’environnement actif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "POST や DELETE も実際に送信します。選択したリクエストと環境を先に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "POST와 DELETE를 포함한 실제 요청을 보냅니다. 선택한 요청과 활성 환경을 먼저 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução envia requisições reais, incluindo POST e DELETE. Confira a seleção e o ambiente ativo antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行会真实发送请求，包括 POST 和 DELETE。请先核对选中的请求和当前环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行會實際傳送請求，包括 POST 和 DELETE。請先確認所選請求和目前環境。"
          }
        }
      }
    },
    "Run stopped. A request already sent may still complete on the server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführung angehalten. Eine bereits gesendete Anfrage kann auf dem Server noch abgeschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run stopped. A request already sent may still complete on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecución detenida. Una solicitud ya enviada aún puede completarse en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution arrêtée. Une requête déjà envoyée peut encore aboutir sur le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行を停止しました。送信済みのリクエストはサーバーで完了する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행이 중지되었습니다. 이미 보낸 요청은 서버에서 완료될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execução interrompida. Uma requisição já enviada ainda pode ser concluída no servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行已停止，已发送的请求仍可能在服务器上完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行已停止，已傳送的請求仍可能在伺服器上完成。"
          }
        }
      }
    },
