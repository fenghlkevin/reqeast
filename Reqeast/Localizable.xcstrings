        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題の解決"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépannage"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solução de problemas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solución de problemas"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 해결"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlerbehebung"
          }
        }
      }
    },
    "Your First HTTP Request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your First HTTP Request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次发送 HTTP 请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次傳送 HTTP 請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めての HTTP リクエスト"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première requête HTTP"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua primeira requisição HTTP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su primera solicitud HTTP"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 HTTP 요청 보내기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre erste HTTP-Anfrage"
          }
        }
      }
    },
    "Start with a reachable test API. Choose New Project from the welcome screen or the sidebar add menu, enter a name, and create it. Select the project, then add an HTTP request from the add-request menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a reachable test API. Choose New Project from the welcome screen or the sidebar add menu, enter a name, and create it. Select the project, then add an HTTP request from the add-request menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备一个能访问的测试接口。在欢迎页或侧栏添加菜单选择“新建项目”，填写名称并创建。选中该项目，再通过添加请求菜单选择 HTTP，创建一个独立请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備可連線的測試 API。在歡迎頁或側欄新增選單選擇「新增專案」，輸入名稱並建立，再於專案內新增 HTTP 請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続可能なテスト API を用意します。開始画面かサイドバーの追加メニューでプロジェクトを作成し、選択して HTTP リクエストを追加します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez une API de test accessible. Créez un projet depuis l’accueil ou le menu d’ajout, nommez-le, sélectionnez-le puis ajoutez une requête HTTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare uma API de teste acessível. Crie e nomeie um projeto pela tela inicial ou pelo menu de adição. Selecione-o e adicione uma requisição HTTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare una API de prueba accesible. Cree y nombre un proyecto desde el inicio o el menú de añadir. Selecciónelo y añada una solicitud HTTP."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접속 가능한 테스트 API를 준비하세요. 시작 화면이나 추가 메뉴에서 프로젝트를 만들고 이름을 입력한 뒤 선택하여 HTTP 요청을 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine erreichbare Test-API. Erstellen und benennen Sie ein Projekt über die Startseite oder das Hinzufügen-Menü. Wählen Sie es aus und fügen Sie eine HTTP-Anfrage hinzu."
          }
        }
      }
    },
    "Choose GET and enter the complete URL, including http:// or https://. Leave Authentication set to No Auth for a public endpoint. No environment or workflow is required for this first request. The example domain is illustrative; replace it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose GET and enter the complete URL, including http:// or https://. Leave Authentication set to No Auth for a public endpoint. No environment or workflow is required for this first request. The example domain is illustrative; replace it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方法选择 GET，URL 填写完整地址，包含 http:// 或 https://。公开接口的认证保持“无认证”。第一次请求不需要配置环境或工作流；示例域名仅供说明，必须替换为你的真实测试地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 GET，輸入含 http:// 或 https:// 的完整 URL。公開 API 保持無認證，第一次請求不需環境或工作流程。範例網域必須替換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GET と http:// または https:// を含む完全な URL を指定します。公開 API は認証なしにします。環境やワークフローは不要です。例のドメインは置き換えてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez GET et une URL complète avec http:// ou https://. Pour une API publique, gardez sans authentification. Aucun environnement ni workflow n’est nécessaire. Remplacez le domaine d’exemple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha GET e uma URL completa com http:// ou https://. Para API pública, use sem autenticação. Não precisa de ambiente ou fluxo neste passo. Substitua o domínio de exemplo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione GET y una URL completa con http:// o https://. En una API pública, deje sin autenticación. No necesita entorno ni flujo. Sustituya el dominio de ejemplo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GET을 선택하고 http:// 또는 https://를 포함한 전체 URL을 입력하세요. 공개 API는 인증 없음을 사용하세요. 환경이나 실행 흐름은 필요 없습니다. 예시 도메인은 바꾸세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie GET und eine vollständige URL mit http:// oder https://. Öffentliche APIs benötigen keine Authentifizierung. Umgebung und Ablauf sind zunächst unnötig. Ersetzen Sie die Beispieldomain."
          }
        }
      }
    },
    "Click the paper-plane Send button. When the request completes, inspect the status and Body below the editor. A successful response is usually 2xx. If no response appears, read the displayed error before changing other settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the paper-plane Send button. When the request completes, inspect the status and Body below the editor. A successful response is usually 2xx. If no response appears, read the displayed error before changing other settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击纸飞机“发送”按钮。请求完成后，在编辑器下方查看状态码和响应正文。通常 2xx 表示成功。没有收到响应时先读错误信息，确认地址与网络，再调整其他设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊紙飛機傳送按鈕，完成後查看下方狀態碼與回應本文。通常 2xx 表示成功；未收到回應時先讀錯誤，再檢查地址和網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙飛行機の送信ボタンを押し、下のステータスと本文を確認します。通常 2xx は成功です。応答がない場合は、他の設定を変える前にエラーを読みます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton d’envoi. Vérifiez le statut et le corps sous l’éditeur. Un code 2xx indique généralement un succès. Sans réponse, lisez l’erreur avant de modifier les réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão de envio. Confira o status e o corpo abaixo do editor. Normalmente 2xx indica sucesso. Sem resposta, leia o erro antes de alterar configurações."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse enviar. Revise el estado y el cuerpo debajo del editor. Normalmente 2xx indica éxito. Si no hay respuesta, lea el error antes de cambiar ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이비행기 전송 버튼을 누르고 아래의 상태 코드와 응답 본문을 확인하세요. 보통 2xx가 성공입니다. 응답이 없으면 설정을 바꾸기 전에 오류부터 읽으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf Senden. Prüfen Sie Status und Antworttext unter dem Editor. 2xx bedeutet meist Erfolg. Lesen Sie bei fehlender Antwort zuerst die Fehlermeldung."
          }
        }
      }
    },
    "Projects, Folders, and Requests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects, Folders, and Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目、文件夹与请求管理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案、資料夾與請求管理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト・フォルダ・リクエスト"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projets, dossiers et requêtes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetos, pastas e requisições"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyectos, carpetas y solicitudes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트, 폴더와 요청 관리"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte, Ordner und Anfragen"
          }
        }
      }
    },
    "Group related APIs in one project. Use the sidebar folder controls to organize projects or requests at their respective level. Give requests names that describe their purpose; changing a name does not change the target URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group related APIs in one project. Use the sidebar folder controls to organize projects or requests at their respective level. Give requests names that describe their purpose; changing a name does not change the target URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一套 API 放在一个项目内。在相应侧栏使用文件夹功能整理项目或请求；项目文件夹与请求文件夹是不同层级。请求名称写用途，例如“查询订单”，改名不会改变接口 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將同一套 API 放入同一專案，在對應側欄用資料夾整理。專案與請求資料夾層級不同；請求可按用途命名，改名不會改變 URL。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連する API を同じプロジェクトにまとめ、各サイドバーのフォルダで整理します。リクエスト名は用途を示します。名前を変えても URL は変わりません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les API liées dans un projet. Organisez projets et requêtes avec les dossiers de leur barre latérale respective. Un nom descriptif ne modifie pas l’URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe APIs relacionadas em um projeto. Organize projetos e requisições com as pastas da barra lateral correspondente. Alterar o nome não altera a URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe APIs relacionadas en un proyecto. Organice proyectos y solicitudes mediante las carpetas de su barra lateral. Cambiar el nombre no cambia la URL."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 API를 같은 프로젝트에 모으고 각 사이드바의 폴더로 정리하세요. 요청 이름은 용도를 나타내며 이름을 바꿔도 URL은 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppieren Sie verwandte APIs in einem Projekt. Ordnen Sie Projekte und Anfragen über die jeweiligen Seitenleisten. Ein beschreibender Name ändert die URL nicht."
          }
        }
      }
    },
    "Open a request’s context menu to rename or duplicate it. Duplicate before trying a different body or authentication setup so the original remains available. Use the request filter to locate a request in a large collection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a request’s context menu to rename or duplicate it. Duplicate before trying a different body or authentication setup so the original remains available. Use the request filter to locate a request in a large collection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过请求的右键或上下文菜单进行重命名、复制。尝试不同正文或认证前先复制请求，保留原始配置。大型项目可用侧栏“筛选请求”快速定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在請求的右鍵或內容選單重新命名或複製。測試其他本文或認證前先複製，保留原設定；大型專案可使用請求篩選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストメニューで名前変更や複製を行います。本文や認証を試す前に複製して元の設定を残します。大きな一覧ではフィルタを使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommez ou dupliquez via le menu contextuel. Dupliquez avant de tester un autre corps ou une authentification. Utilisez le filtre pour retrouver une requête."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeie ou duplique pelo menu de contexto. Duplique antes de testar outro corpo ou autenticação. Use o filtro para localizar uma requisição."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombre o duplique desde el menú contextual. Duplique antes de probar otro cuerpo o autenticación. Use el filtro para localizar solicitudes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 메뉴에서 이름 변경이나 복제를 하세요. 본문이나 인증을 바꾸기 전에 복제하여 원본을 남기세요. 요청 필터로 항목을 찾을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennen oder duplizieren Sie über das Kontextmenü. Duplizieren Sie vor Änderungen an Text oder Authentifizierung. Nutzen Sie den Filter, um Anfragen zu finden."
          }
        }
      }
    },
    "Review the selected item before deleting it. Removing a project also removes its requests from the active collection. Export a backup first. Saved HTTP workflows that reference deleted requests must be updated before their next run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the selected item before deleting it. Removing a project also removes its requests from the active collection. Export a backup first. Saved HTTP workflows that reference deleted requests must be updated before their next run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除前确认选中的对象。删除项目会让其中请求一并离开当前列表，重要内容先导出备份。若已保存工作流引用了被删除请求，必须修复或重新保存后才能运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除前確認選取項目，專案刪除也會移除其請求。重要內容先匯出備份；引用已刪請求的工作流程必須更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除対象を確認し、重要な内容は先に書き出します。プロジェクトを削除すると含まれるリクエストも一覧から消えます。参照する保存済みフローも更新します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la sélection et exportez une sauvegarde avant suppression. Supprimer un projet retire aussi ses requêtes. Corrigez les workflows qui les référencent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a seleção e exporte um backup antes de excluir. Excluir um projeto remove suas requisições da lista ativa. Atualize fluxos que as referenciam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise la selección y exporte una copia antes de eliminar. Eliminar un proyecto también retira sus solicitudes. Actualice los flujos que las referencian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 대상을 확인하고 중요한 내용은 먼저 내보내세요. 프로젝트를 삭제하면 내부 요청도 목록에서 사라집니다. 해당 요청을 참조하는 흐름을 수정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie die Auswahl und exportieren Sie zuerst eine Sicherung. Beim Löschen eines Projekts verschwinden auch dessen Anfragen. Aktualisieren Sie betroffene Abläufe."
          }
        }
      }
    },
    "HTTP Parameters, Headers, and Bodies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP Parameters, Headers, and Bodies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 参数、请求头与正文"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 參數、標頭與本文"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP パラメータ・ヘッダー・本文"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres, en-têtes et corps HTTP"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parâmetros, cabeçalhos e corpo HTTP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parámetros, cabeceras y cuerpo HTTP"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 매개변수, 헤더와 본문"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Parameter, Header und Text"
          }
        }
      }
    },
    "Open Params to add query keys and values; enabled rows are sent and unchecked rows are skipped. Use Headers for custom headers. Bulk Edit accepts one key:value per line. Check the prepared URL and headers in Inspect Request before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Params to add query keys and values; enabled rows are sent and unchecked rows are skipped. Use Headers for custom headers. Bulk Edit accepts one key:value per line. Check the prepared URL and headers in Inspect Request before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“参数”添加查询键和值，勾选的行才发送；取消勾选可暂时停用。在“标头”添加自定义请求头。批量编辑按每行 key:value 输入。发送前在“检查请求”确认展开后的 URL 与标头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「參數」新增查詢鍵值，只有勾選行會傳送；「標頭」可新增自訂標頭。批次編輯每行輸入 key:value，傳送前在檢查請求確認 URL 與標頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Params でクエリ、Headers でヘッダーを追加します。有効な行だけ送信されます。一括編集は一行に key:value を入力します。送信前にリクエスト確認で展開結果を見ます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les paramètres et les en-têtes dans leurs onglets. Seules les lignes activées sont envoyées. L’édition groupée accepte key:value par ligne. Vérifiez l’URL et les en-têtes préparés avant l’envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione parâmetros e cabeçalhos nas abas correspondentes. Só linhas ativadas são enviadas. A edição em lote aceita key:value por linha. Confira a URL e os cabeçalhos preparados antes de enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada parámetros y cabeceras en sus pestañas. Solo se envían las filas activadas. La edición masiva acepta key:value por línea. Revise la URL y las cabeceras preparadas antes de enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매개변수와 헤더 탭에 키와 값을 추가하세요. 활성화한 행만 전송됩니다. 일괄 편집은 줄마다 key:value를 입력합니다. 전송 전에 완성된 URL과 헤더를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie Parameter und Header in den jeweiligen Tabs ein. Nur aktivierte Zeilen werden gesendet. Die Sammelbearbeitung akzeptiert key:value pro Zeile. Prüfen Sie vor dem Senden die vorbereitete URL und Header."
          }
        }
      }
    },
    "For a POST request, open Body and choose JSON, enter valid JSON, then send. Raw lets you choose a content type. URL-encoded uses text fields; multipart accepts text or file rows; Binary sends one selected file. Select the type expected by the server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a POST request, open Body and choose JSON, enter valid JSON, then send. Raw lets you choose a content type. URL-encoded uses text fields; multipart accepts text or file rows; Binary sends one selected file. Select the type expected by the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "POST 请求打开“正文”，选 JSON 后输入合法 JSON 并发送。Raw 可选择内容类型；URL 编码表单使用键值字段；multipart 可添加文本行或文件行；Binary 发送所选单个文件。类型必须与服务器要求一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "POST 請求在本文選 JSON 並輸入合法 JSON。Raw 可指定內容類型，URL 編碼使用鍵值，multipart 支援文字和檔案行，Binary 傳送單一檔案；請按伺服器要求選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "POST は本文で JSON を選び、有効な JSON を入力します。Raw は内容種別、URL エンコードはテキスト項目、multipart はテキストやファイル、Binary は単一ファイルです。サーバーに合わせます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour POST, choisissez JSON et saisissez un JSON valide. Raw permet de choisir le type. Le formulaire URL-encodé utilise des champs texte ; multipart accepte texte et fichiers ; Binary envoie un fichier. Suivez le format du serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para POST, escolha JSON e informe JSON válido. Raw permite escolher o tipo. O formulário URL-encoded usa campos de texto; multipart aceita texto e arquivos; Binary envia um arquivo. Use o formato esperado pelo servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para POST, elija JSON e introduzca JSON válido. Raw permite elegir el tipo. El formulario URL-encoded usa campos; multipart admite texto y archivos; Binary envía un archivo. Siga el formato del servidor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "POST 본문에서 JSON을 선택하고 올바른 JSON을 입력하세요. Raw는 유형 선택, URL 인코딩은 텍스트 필드, multipart는 텍스트와 파일, Binary는 단일 파일 전송입니다. 서버 형식에 맞추세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie für POST JSON und geben Sie gültiges JSON ein. Raw erlaubt einen Inhaltstyp, URL-kodierte Formulare verwenden Textfelder, multipart Text oder Dateien und Binary eine Datei. Verwenden Sie das Serverformat."
          }
        }
      }
    },
    "Strict HTTP Mode hides and omits bodies for GET, HEAD, and OPTIONS. Change this global default only if your API explicitly requires such a body. A 400 or 415 response often means the body shape or Content-Type differs from the server contract.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict HTTP Mode hides and omits bodies for GET, HEAD, and OPTIONS. Change this global default only if your API explicitly requires such a body. A 400 or 415 response often means the body shape or Content-Type differs from the server contract."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格 HTTP 模式会隐藏并省略 GET、HEAD、OPTIONS 的正文。只有接口明确要求这些方法带正文时才调整全局开关。400 或 415 常表示正文结构或 Content-Type 与接口约定不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格 HTTP 模式隱藏並省略 GET、HEAD、OPTIONS 本文；只在 API 明確要求時調整。400 或 415 通常表示本文結構或 Content-Type 不符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳密 HTTP モードは GET、HEAD、OPTIONS の本文を省きます。API が明示的に必要とする場合だけ変更します。400 や 415 は本文形式や Content-Type の不一致を確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode HTTP strict omet le corps de GET, HEAD et OPTIONS. Ne le modifiez que si l’API exige un corps. Pour 400 ou 415, vérifiez la structure et Content-Type."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo HTTP estrito omite o corpo em GET, HEAD e OPTIONS. Só altere se a API exigir corpo. Em 400 ou 415, confira a estrutura e Content-Type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo HTTP estricto omite cuerpos en GET, HEAD y OPTIONS. Cámbielo solo si la API lo exige. Con 400 o 415, revise la estructura y Content-Type."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격한 HTTP 모드는 GET, HEAD, OPTIONS 본문을 생략합니다. API가 명시적으로 요구할 때만 바꾸세요. 400이나 415이면 본문 구조와 Content-Type을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der strikte HTTP-Modus lässt den Text bei GET, HEAD und OPTIONS weg. Ändern Sie ihn nur bei ausdrücklicher API-Anforderung. Prüfen Sie bei 400 oder 415 Struktur und Content-Type."
          }
        }
      }
    },
    "Authentication and Credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication and Credentials"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证与凭据配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認證與憑證設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証と資格情報"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentification et identifiants"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticação e credenciais"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticación y credenciales"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증과 자격 증명 설정"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung und Zugangsdaten"
          }
        }
      }
    },
    "Open Auth and select Bearer Token. Enter the token itself, such as {{token}}, without adding a second Bearer prefix. Define token in the active environment or extract it from a login response. A 401 response requires checking expiry, environment, and the prepared Authorization header.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Auth and select Bearer Token. Enter the token itself, such as {{token}}, without adding a second Bearer prefix. Define token in the active environment or extract it from a login response. A 401 response requires checking expiry, environment, and the prepared Authorization header."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“认证”选 Bearer Token，填写令牌本身，例如 {{token}}，不要再加一遍 Bearer 前缀。token 应存在于启用的环境，或由登录响应提取。遇到 401，检查有效期、环境和预览中的 Authorization 标头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在認證選 Bearer Token，填令牌本身或 {{token}}，不要重複加 Bearer。令牌應在啟用環境或由登入提取；401 時檢查期限、環境與 Authorization 標頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証で Bearer Token を選び、{{token}} などトークンだけ入力します。Bearer を重ねません。有効な環境に定義するかログインから抽出します。401 は期限・環境・Authorization を確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Bearer Token et saisissez le jeton seul, par exemple {{token}}, sans répéter Bearer. Définissez-le dans l’environnement actif ou extrayez-le après connexion. Pour 401, vérifiez expiration, environnement et Authorization."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Bearer Token e informe apenas o token, como {{token}}, sem repetir Bearer. Defina-o no ambiente ativo ou extraia do login. Em 401, confira validade, ambiente e Authorization."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija Bearer Token e introduzca solo el token, como {{token}}, sin repetir Bearer. Defínalo en el entorno activo o extráigalo del inicio de sesión. Para 401, revise caducidad, entorno y Authorization."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer Token을 선택하고 {{token}}처럼 토큰만 입력하세요. Bearer를 중복 입력하지 마세요. 활성 환경에 정의하거나 로그인에서 추출하세요. 401이면 만료, 환경과 Authorization을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Bearer Token und tragen Sie nur den Token ein, etwa {{token}}, ohne zusätzliches Bearer. Definieren Sie ihn in der aktiven Umgebung oder extrahieren Sie ihn beim Login. Prüfen Sie bei 401 Ablauf, Umgebung und Authorization."
          }
        }
      }
    },
    "Choose Basic Authentication and enter the username and password required by the API. API Key instead needs a key name, value, and placement in Header or Query Params. Keep secret values in named variables and avoid adding duplicate authentication headers manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Basic Authentication and enter the username and password required by the API. API Key instead needs a key name, value, and placement in Header or Query Params. Keep secret values in named variables and avoid adding duplicate authentication headers manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic Authentication 填接口要求的用户名和密码。API Key 则需要填键名、键值，并选择 Header 或 Query Params 放置位置。敏感值建议使用命名变量，不要同时手工添加重复的认证标头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic Authentication 填 API 的帳號密碼；API Key 填鍵名、鍵值並選 Header 或 Query Params。敏感值使用命名變數，避免手動重複新增認證標頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic は API のユーザー名とパスワードを入力します。API Key は名前・値・Header または Query Params の位置を指定します。秘密値には変数を使い、認証ヘッダーを重複させません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic demande le nom d’utilisateur et le mot de passe de l’API. API Key demande un nom, une valeur et une position dans l’en-tête ou la requête. Utilisez des variables secrètes et évitez les en-têtes d’authentification en double."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic exige usuário e senha da API. API Key exige nome, valor e posição em cabeçalho ou consulta. Use variáveis para segredos e evite cabeçalhos de autenticação duplicados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic requiere usuario y contraseña de la API. API Key requiere nombre, valor y ubicación en cabecera o consulta. Use variables para secretos y evite cabeceras de autenticación duplicadas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic에는 API 사용자 이름과 비밀번호를 입력하세요. API Key는 이름, 값과 헤더 또는 쿼리 위치를 지정합니다. 비밀값은 변수로 관리하고 인증 헤더를 중복 추가하지 마세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic verlangt API-Benutzername und Passwort. API Key braucht Namen, Wert und Position im Header oder in der Abfrage. Nutzen Sie Variablen für Geheimnisse und vermeiden Sie doppelte Authentifizierungsheader."
          }
        }
      }
    },
    "Environments and Variable Replacement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environments and Variable Replacement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境与变量替换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境與變數替換"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境と変数の置換"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environnements et substitution"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambientes e substituição de variáveis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entornos y sustitución de variables"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경과 변수 치환"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungen und Variablenersetzung"
          }
        }
      }
    },
    "Open the editor environment menu, choose Manage Environments, and add Test and Production separately. Add an enabled baseUrl to each, then activate the intended environment. Put {{baseUrl}} in request URLs. Compare the resolved host in Inspect Request before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the editor environment menu, choose Manage Environments, and add Test and Production separately. Add an enabled baseUrl to each, then activate the intended environment. Put {{baseUrl}} in request URLs. Compare the resolved host in Inspect Request before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从编辑器环境菜单进入“管理环境”，分别创建 Test 和 Production，为每个添加启用的 baseUrl，再选择本次环境。请求 URL 写 {{baseUrl}}。切换后先在检查请求里核对解析出的主机，确认后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在編輯器環境選單管理環境，分別建立 Test、Production，各自新增啟用的 baseUrl，再選擇環境。URL 使用 {{baseUrl}}，傳送前確認解析後主機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境メニューで環境管理を開き、Test と Production に有効な baseUrl を定義します。目的の環境を選び、URL に {{baseUrl}} を使います。送信前に展開後のホストを確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez Test et Production via le menu des environnements. Ajoutez un baseUrl activé à chacun, puis activez le bon environnement. Utilisez {{baseUrl}} dans les URL et vérifiez l’hôte résolu avant l’envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie Test e Production pelo menu de ambientes. Adicione baseUrl ativado em cada um e selecione o ambiente correto. Use {{baseUrl}} nas URLs e confira o host resolvido antes de enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree Test y Production en el menú de entornos. Añada baseUrl activado en cada uno y elija el entorno correcto. Use {{baseUrl}} en las URL y verifique el host resuelto antes de enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 메뉴에서 Test와 Production을 각각 만들고 활성화된 baseUrl을 추가하세요. 원하는 환경을 선택하고 URL에 {{baseUrl}}을 쓰세요. 전송 전 치환된 호스트를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie Test und Production im Umgebungsmenü. Fügen Sie beiden einen aktiven baseUrl hinzu und wählen Sie die passende Umgebung. Nutzen Sie {{baseUrl}} in URLs und prüfen Sie den aufgelösten Host."
          }
        }
      }
    },
    "Variable names are case-sensitive. A disabled variable does not participate in replacement. Mark passwords and tokens as secret to hide them in inspection and omit their values from safe exports. Missing-variable errors name the values you must define before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable names are case-sensitive. A disabled variable does not participate in replacement. Mark passwords and tokens as secret to hide them in inspection and omit their values from safe exports. Missing-variable errors name the values you must define before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变量名区分大小写，停用的变量不参与替换。密码、token 标记为敏感值后在检查界面默认隐藏，安全导出不带其值。敏感标记不代表所有正文都已脱敏；发送前按缺失变量错误补齐所需值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變數名區分大小寫，停用值不替換。密碼與 token 標為敏感值，在檢查中隱藏且安全匯出省略。敏感標記不代表所有本文已遮蔽；按缺少變數錯誤補齊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数名は大文字小文字を区別し、無効な値は置換されません。パスワードやトークンを秘密値にすると確認画面で隠れ、安全な書き出しから省かれます。不足変数のエラーに従って定義します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms respectent la casse ; les variables désactivées ne sont pas remplacées. Marquez mots de passe et jetons comme secrets pour les masquer et les omettre des exports sûrs. Définissez les valeurs indiquées par les erreurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes diferenciam maiúsculas; variáveis desativadas não são substituídas. Marque senhas e tokens como secretos para ocultar e omitir em exportações seguras. Defina os valores indicados pelos erros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres distinguen mayúsculas; las variables desactivadas no se sustituyen. Marque contraseñas y tokens como secretos para ocultarlos y omitirlos en exportaciones seguras. Defina los valores indicados por los errores."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수 이름은 대소문자를 구분하며 비활성 값은 치환하지 않습니다. 비밀번호와 토큰을 비밀값으로 표시하면 검사 화면에서 숨기고 안전한 내보내기에서 제외합니다. 누락 오류에 나온 값을 정의하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen unterscheiden Groß- und Kleinschreibung; deaktivierte Werte werden nicht ersetzt. Markieren Sie Passwörter und Token als geheim, damit sie verborgen und aus sicheren Exporten ausgelassen werden. Ergänzen Sie fehlende Werte."
          }
        }
      }
    },
    "Reading Responses and History": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading Responses and History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应阅读与历史记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應閱讀與歷史記錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レスポンスと履歴の読み方"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture des réponses et historique"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas e histórico"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuestas e historial"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 읽기와 기록"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten und Verlauf lesen"
          }
        }
      }
    },
    "After sending, open response Body for the content, Headers for server headers, Cookies for returned cookies, and Info for connection details. JSON can be viewed formatted or raw. Enter a jq filter to select fields; clear the filter to restore the full response.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After sending, open response Body for the content, Headers for server headers, Cookies for returned cookies, and Info for connection details. JSON can be viewed formatted or raw. Enter a jq filter to select fields; clear the filter to restore the full response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送后在响应“正文”看内容，“标头”看服务器头，“Cookies”看返回 Cookie，“信息”看连接详情。JSON 可切换格式化或原始显示。jq 栏可筛选字段，清空筛选即可恢复完整响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送後在回應本文看內容、標頭看伺服器頭、Cookies 看 Cookie、資訊看連線詳情。JSON 可格式化或原始顯示；jq 可篩選欄位，清空即恢復完整回應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信後は本文、ヘッダー、Cookies、Info で内容や接続情報を確認します。JSON は整形と元データを切り替えられます。jq で項目を選択し、消去すると全体に戻ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’envoi, consultez corps, en-têtes, cookies et informations de connexion. JSON peut être formaté ou brut. Un filtre jq sélectionne les champs ; effacez-le pour revoir toute la réponse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após enviar, consulte corpo, cabeçalhos, cookies e informações da conexão. JSON pode ser formatado ou bruto. Use jq para selecionar campos; limpe o filtro para ver a resposta completa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras enviar, consulte cuerpo, cabeceras, cookies e información de conexión. JSON puede verse formateado o sin formato. Use jq para seleccionar campos y borre el filtro para ver todo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 후 본문, 헤더, Cookies와 정보 탭에서 응답 및 연결 정보를 확인하세요. JSON은 정리된 형식이나 원본으로 봅니다. jq 필터를 비우면 전체 응답으로 돌아갑니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie nach dem Senden Text, Header, Cookies und Verbindungsinformationen. JSON lässt sich formatiert oder roh anzeigen. jq wählt Felder aus; leeren Sie den Filter für die vollständige Antwort."
          }
        }
      }
    },
    "Open the clock-shaped request history button to review previous executions. Use status, elapsed time, size, and response Info to separate server errors from connection failures. The code-snippet toolbar exports request code; review generated credentials before copying it to another tool.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the clock-shaped request history button to review previous executions. Use status, elapsed time, size, and response Info to separate server errors from connection failures. The code-snippet toolbar exports request code; review generated credentials before copying it to another tool."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击时钟形请求历史按钮回看执行记录。结合状态码、耗时、大小和响应信息，区分服务器错误与连接失败。工具栏代码片段功能可生成请求代码，复制到其他工具前检查其中是否含凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊時鐘歷史按鈕回看執行，結合狀態、耗時、大小及資訊判斷伺服器或連線問題。程式碼片段可產生請求程式碼，複製前檢查憑證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の履歴ボタンで以前の実行を確認します。ステータス・時間・サイズ・Info でサーバーと接続の問題を区別します。コード生成を他ツールへコピーする前に資格情報を確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton d’historique permet de revoir les exécutions. Statut, durée, taille et informations distinguent erreur serveur et connexion. Vérifiez les identifiants avant de copier un extrait de code généré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de histórico mostra execuções anteriores. Status, duração, tamanho e informações distinguem erros do servidor e da conexão. Confira credenciais antes de copiar código gerado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de historial muestra ejecuciones anteriores. Estado, duración, tamaño e información distinguen errores de servidor y conexión. Revise credenciales antes de copiar código generado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 모양 기록 버튼에서 이전 실행을 보세요. 상태, 시간, 크기와 정보를 함께 확인하여 서버 오류와 연결 실패를 구분하세요. 생성된 코드를 복사하기 전에 자격 증명을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlaufsbutton zeigt frühere Ausführungen. Status, Dauer, Größe und Info unterscheiden Serverfehler von Verbindungsproblemen. Prüfen Sie Zugangsdaten, bevor Sie generierten Code kopieren."
          }
        }
      }
    },
    "Cookies and Login Sessions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies and Login Sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie 与登录会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie 與登入工作階段"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie とログイン状態"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies et sessions de connexion"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies e sessões de login"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies y sesiones de acceso"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie와 로그인 세션"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies und Anmeldesitzungen"
          }
        }
      }
    },
    "Send a login request and inspect Set-Cookie in the response headers and Cookies tab. Matching cookies are stored for later requests when the cookie jar is enabled. Cookie matching depends on domain, path, expiry, and Secure; a token login may instead require Bearer authentication.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a login request and inspect Set-Cookie in the response headers and Cookies tab. Matching cookies are stored for later requests when the cookie jar is enabled. Cookie matching depends on domain, path, expiry, and Secure; a token login may instead require Bearer authentication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送登录请求后，查看响应标头的 Set-Cookie 和 Cookies 标签。启用 Cookie 容器时，匹配的 Cookie 可用于后续请求，是否发送取决于域名、路径、有效期及 Secure 属性。token 登录则可能需要 Bearer 认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後查看 Set-Cookie 與 Cookies。啟用 Cookie 容器時，匹配值用於後續請求，依域名、路徑、期限、Secure 判斷；token 登入可能需 Bearer 認證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後に Set-Cookie と Cookies を確認します。Cookie 保存が有効なら、ドメイン・パス・期限・Secure に一致した Cookie を後で使います。トークン方式は Bearer 認証が必要な場合があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après connexion, vérifiez Set-Cookie et l’onglet Cookies. Le stockage activé réutilise les cookies selon domaine, chemin, expiration et Secure. Une connexion par jeton peut exiger Bearer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após login, confira Set-Cookie e Cookies. Com o armazenamento ativado, cookies compatíveis são reutilizados conforme domínio, caminho, validade e Secure. Login por token pode exigir Bearer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras iniciar sesión, revise Set-Cookie y Cookies. El almacén activado reutiliza cookies según dominio, ruta, caducidad y Secure. El acceso con token puede requerir Bearer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 후 Set-Cookie와 Cookies 탭을 확인하세요. 저장 기능이 켜져 있으면 도메인, 경로, 만료와 Secure에 맞는 Cookie를 다시 사용합니다. 토큰 로그인은 Bearer가 필요할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie nach der Anmeldung Set-Cookie und Cookies. Bei aktivem Speicher werden passende Cookies nach Domain, Pfad, Ablauf und Secure wiederverwendet. Token-Anmeldung kann Bearer erfordern."
          }
        }
      }
    },
    "In request Settings, Disable cookie jar prevents this request from storing or sending cookies. Keep it off for a cookie-based login flow. Use Inspect Request to confirm the outgoing Cookie header; switch environments carefully because an environment change alone is not a cookie reset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In request Settings, Disable cookie jar prevents this request from storing or sending cookies. Keep it off for a cookie-based login flow. Use Inspect Request to confirm the outgoing Cookie header; switch environments carefully because an environment change alone is not a cookie reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求“设置”中的“禁用 Cookie 容器”会让该请求不保存、不发送 Cookie。依赖 Cookie 的登录流程应保持此项关闭。用请求预览确认实际 Cookie 标头；切换环境本身不等于清空 Cookie。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求設定的「停用 Cookie 容器」會阻止此請求儲存和傳送 Cookie；Cookie 登入流程保持關閉。預覽確認 Cookie 標頭，切換環境不等於清空 Cookie。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の Cookie 保存無効化は、そのリクエストで Cookie の保存と送信を止めます。Cookie ログインでは無効化しません。プレビューを確認します。環境変更だけでは Cookie は消えません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le stockage empêche cette requête d’enregistrer ou d’envoyer des cookies. Laissez cette option désactivée pour une connexion par cookie. Vérifiez Cookie dans l’aperçu ; changer d’environnement ne les efface pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o armazenamento impede esta requisição de salvar ou enviar cookies. Deixe essa opção desligada em login por cookie. Confira Cookie na prévia; trocar ambiente não limpa os cookies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar el almacén impide guardar o enviar cookies en esta solicitud. Deje esta opción apagada para acceso por cookie. Revise Cookie en la vista previa; cambiar entorno no borra cookies."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 설정의 Cookie 저장 비활성화는 해당 요청에서 Cookie 저장과 전송을 막습니다. Cookie 로그인에서는 끄세요. 미리보기에서 Cookie를 확인하세요. 환경 변경만으로 Cookie가 지워지지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookie-Speicher deaktivieren verhindert das Speichern und Senden für diese Anfrage. Lassen Sie diese Option bei Cookie-Anmeldung aus. Prüfen Sie Cookie in der Vorschau; ein Umgebungswechsel löscht keine Cookies."
          }
        }
      }
    },
    "Backups and Project Transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups and Project Transfer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份与项目迁移"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份與專案移轉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップとプロジェクト移行"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardes et transfert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup e transferência de projetos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias y transferencia de proyectos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업과 프로젝트 이전"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungen und Projektübertragung"
          }
        }
      }
    },
    "Use the project context menu → Export Project to create a .reqeast file. Credentials and secret environment values are excluded by default; enabling either option writes them as plain text. For all projects, use Settings → Data → Export All Projects. Keep backups in a controlled location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the project context menu → Export Project to create a .reqeast file. Credentials and secret environment values are excluded by default; enabling either option writes them as plain text. For all projects, use Settings → Data → Export All Projects. Keep backups in a controlled location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目上下文菜单选择“导出项目”，保存为 .reqeast 文件。默认不含凭据和环境敏感值，主动勾选后会以明文写入。全部项目从“设置 → 数据 → 导出所有项目”备份。备份放在受控位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案內容選單選匯出專案，建立 .reqeast 檔。預設省略憑證與敏感環境值，勾選後以明文寫入。全部備份在設定 → 資料 → 匯出所有專案，請妥善保管。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのメニューから .reqeast を書き出します。資格情報と秘密値は標準で省かれ、選択すると平文になります。全件は設定のデータから書き出し、安全な場所に保存します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez le projet en .reqeast depuis son menu. Identifiants et valeurs secrètes sont exclus par défaut ; les inclure les écrit en clair. Exportez tous les projets depuis les données des réglages. Protégez les sauvegardes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte .reqeast pelo menu do projeto. Credenciais e segredos são excluídos por padrão; incluí-los grava texto simples. Exporte todos em Configurações → Dados. Guarde backups em local controlado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte .reqeast desde el menú del proyecto. Credenciales y secretos se excluyen por defecto; incluirlos los guarda en texto plano. Exporte todos desde Ajustes → Datos. Proteja las copias."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 메뉴에서 .reqeast를 내보내세요. 자격 증명과 비밀값은 기본 제외되며 포함하면 평문으로 저장됩니다. 전체 프로젝트는 설정의 데이터에서 내보내고 안전하게 보관하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie .reqeast über das Projektmenü. Zugangsdaten und Geheimnisse fehlen standardmäßig; eingeschlossen werden sie als Klartext gespeichert. Alle Projekte exportieren Sie unter Einstellungen → Daten. Bewahren Sie Sicherungen geschützt auf."
          }
        }
      }
    },
    "Choose Import Project from the sidebar add menu or Settings → Data, select the backup, and review the import before confirming. Check requests and environments after import and restore omitted secrets. HTTP Project Files export is a separate format for Git and the CLI, not a complete multi-protocol backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Import Project from the sidebar add menu or Settings → Data, select the backup, and review the import before confirming. Check requests and environments after import and restore omitted secrets. HTTP Project Files export is a separate format for Git and the CLI, not a complete multi-protocol backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧栏添加菜单或“设置 → 数据”选择“导入项目”，选备份文件并检查导入预览后确认。导入后检查请求与环境，补回未导出的密钥。HTTP“项目文件”是供 Git 和 CLI 使用的另一种格式，不是完整多协议备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從侧欄新增選單或設定 → 資料匯入備份，檢查預覽後確認，核對請求與環境並補回密鑰。HTTP 專案檔案是 Git、CLI 格式，不是完整多協定備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加メニューか設定のデータからバックアップを選び、プレビューを確認して読み込みます。リクエスト・環境・不足する秘密値を確認します。HTTP プロジェクトファイルは Git/CLI 用の別形式です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez la sauvegarde via le menu d’ajout ou les données des réglages, puis vérifiez l’aperçu. Contrôlez requêtes et environnements, restaurez les secrets omis. Les fichiers HTTP pour Git/CLI ne remplacent pas une sauvegarde multi-protocole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe o backup pelo menu de adição ou pelos dados das configurações e revise a prévia. Confira requisições, ambientes e segredos omitidos. Arquivos HTTP para Git/CLI não são backup completo de todos os protocolos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe la copia desde el menú de añadir o Ajustes → Datos y revise la vista previa. Compruebe solicitudes, entornos y secretos omitidos. Los archivos HTTP para Git/CLI no son una copia completa multiprotocolo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 메뉴나 설정의 데이터에서 백업을 가져오고 미리보기를 확인하세요. 요청, 환경과 빠진 비밀값을 복원하세요. Git/CLI용 HTTP 프로젝트 파일은 전체 프로토콜 백업과 다릅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie die Sicherung über das Hinzufügen-Menü oder die Dateneinstellungen und prüfen Sie die Vorschau. Kontrollieren Sie Anfragen, Umgebungen und fehlende Geheimnisse. HTTP-Dateien für Git/CLI sind keine vollständige Mehrprotokoll-Sicherung."
          }
        }
      }
    },
    "Add a TCP request, enter the host without a URL scheme and a numeric port, then click Connect. Wait for the connected state before sending a message. The conversation log displays incoming and outgoing data; Disconnect closes the persistent connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a TCP request, enter the host without a URL scheme and a numeric port, then click Connect. Wait for the connected state before sending a message. The conversation log displays incoming and outgoing data; Disconnect closes the persistent connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 TCP 请求，Host 只填主机名或 IP，不带 http://，Port 填端口数字。点“连接”，等状态连接成功后发送消息。会话日志区分收发数据，“断开”关闭持久连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 TCP 請求，Host 填主機或 IP、不帶 URL 協定，Port 填數字。連線成功後傳送訊息，記錄顯示收發資料，斷線關閉持續連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP リクエストに URL スキームなしのホストと数値ポートを設定し接続します。接続後に送信します。ログに送受信が表示され、切断すると接続が閉じます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez TCP avec hôte sans schéma URL et port numérique. Connectez-vous, attendez l’état connecté puis envoyez. Le journal affiche les échanges ; déconnecter ferme la connexion persistante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione TCP com host sem esquema URL e porta numérica. Conecte, espere o estado conectado e envie. O log mostra envios e recebimentos; desconectar fecha a conexão persistente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada TCP con host sin esquema URL y puerto numérico. Conecte, espere el estado conectado y envíe. El registro muestra ambos sentidos; desconectar cierra la conexión persistente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP 요청에 URL 접두사 없는 호스트와 숫자 포트를 입력하고 연결하세요. 연결 완료 후 메시지를 보내세요. 로그에서 송수신을 확인하고 연결 해제로 종료하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie TCP mit Host ohne URL-Schema und numerischem Port hinzu. Verbinden Sie sich und senden Sie erst nach erfolgreicher Verbindung. Das Protokoll zeigt beide Richtungen; Trennen schließt die dauerhafte Verbindung."
          }
        }
      }
    },
    "Enable TLS only for a TLS endpoint. In message settings, choose encoding and line ending according to the server protocol. For a line-oriented service choose LF or CRLF; for binary protocols choose Hex. A plain TCP port cannot accept a TLS handshake.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable TLS only for a TLS endpoint. In message settings, choose encoding and line ending according to the server protocol. For a line-oriented service choose LF or CRLF; for binary protocols choose Hex. A plain TCP port cannot accept a TLS handshake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有服务端使用 TLS 时才开启 TLS。消息设置中按服务端协议选择编码、换行符；按行协议通常选 LF 或 CRLF，二进制协议选 Hex。普通 TCP 端口不能接收 TLS 握手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅對 TLS 服務開啟 TLS。在訊息設定選正確編碼與換行；逐行服務常用 LF、CRLF，二進位使用 Hex。普通 TCP 埠不接受 TLS 握手。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS は TLS 対応先だけで有効にします。設定のエンコードと改行をサーバーに合わせ、行形式は LF/CRLF、バイナリは Hex を使います。通常の TCP ポートでは TLS 握手できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez TLS seulement pour un service TLS. Réglez encodage et fin de ligne selon le serveur : LF/CRLF pour les lignes, Hex pour le binaire. Un port TCP simple n’accepte pas la négociation TLS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative TLS apenas em serviço TLS. Ajuste codificação e fim de linha ao servidor: LF/CRLF para linhas, Hex para binário. Uma porta TCP simples não aceita negociação TLS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active TLS solo para un servicio TLS. Ajuste codificación y fin de línea: LF/CRLF para líneas, Hex para binario. Un puerto TCP simple no acepta negociación TLS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 서버에만 TLS를 켜세요. 서버 규약에 맞춰 인코딩과 줄 끝을 설정하세요. 줄 단위는 LF/CRLF, 바이너리는 Hex입니다. 일반 TCP 포트는 TLS 연결을 받지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie TLS nur für TLS-Dienste. Passen Sie Kodierung und Zeilenende an: LF/CRLF für Zeilen, Hex für Binärdaten. Ein normaler TCP-Port akzeptiert keinen TLS-Handshake."
          }
        }
      }
    },
    "Add a UDP request and enter the destination host and port. Choose the message encoding, enter one datagram, and click Send. UDP does not establish a reliable connection, so sending successfully does not prove that the remote service received the message.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a UDP request and enter the destination host and port. Choose the message encoding, enter one datagram, and click Send. UDP does not establish a reliable connection, so sending successfully does not prove that the remote service received the message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 UDP 请求并填写目标主机和端口，选择消息编码，输入一份数据报后点“发送”。UDP 不建立可靠连接，因此本地发送成功不代表远端服务一定收到数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 UDP 請求並填目的主機與埠，選編碼、輸入資料報並傳送。UDP 不建立可靠連線，本機傳送成功不代表遠端收到。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP リクエストに送信先ホストとポートを設定し、エンコードとデータグラムを入力して送信します。信頼できる接続は確立されず、送信成功は受信を保証しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez UDP, indiquez hôte et port, choisissez l’encodage puis envoyez un datagramme. UDP n’établit pas de connexion fiable : un envoi réussi ne prouve pas sa réception."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione UDP, informe host e porta, escolha a codificação e envie um datagrama. UDP não estabelece conexão confiável; envio bem-sucedido não garante recebimento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada UDP, indique host y puerto, elija codificación y envíe un datagrama. UDP no establece conexión fiable; enviar correctamente no garantiza recepción."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP 요청에 대상 호스트와 포트를 입력하고 인코딩을 선택한 뒤 데이터그램을 보내세요. UDP는 신뢰할 수 있는 연결을 만들지 않으므로 전송 성공이 수신을 보장하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie UDP mit Zielhost und Port hinzu, wählen Sie die Kodierung und senden Sie ein Datagramm. UDP erstellt keine zuverlässige Verbindung; erfolgreiches Senden garantiert keinen Empfang."
          }
        }
      }
    },
    "Click Start listening when you need to receive responses and watch the conversation log. Click Stop listening when finished. If replies are absent, verify the server’s reply destination, firewall, port, and encoding; do not assume UDP retries or ordered delivery.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Start listening when you need to receive responses and watch the conversation log. Click Stop listening when finished. If replies are absent, verify the server’s reply destination, firewall, port, and encoding; do not assume UDP retries or ordered delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要接收响应时点击“开始监听”，观察会话日志；结束后点“停止监听”。收不到回复时检查服务端回复地址、防火墙、端口及编码，不要把 UDP 当作自动重试或顺序可靠传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需接收時開始監聽並觀察記錄，結束停止監聽。無回覆時檢查回覆地址、防火牆、埠及編碼；UDP 不保證重試或順序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答を見るには受信開始してログを確認し、終了時に停止します。応答がなければ返信先・ファイアウォール・ポート・エンコードを確認します。再送や順序は保証されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez l’écoute pour recevoir et observer le journal, puis arrêtez-la. Sans réponse, vérifiez destination de retour, pare-feu, port et encodage. UDP ne garantit ni nouvelle tentative ni ordre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie a escuta para receber e observar o log, depois pare. Sem resposta, confira destino de retorno, firewall, porta e codificação. UDP não garante repetição nem ordem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie la escucha para recibir y observar el registro, luego deténgala. Sin respuesta, revise destino de retorno, cortafuegos, puerto y codificación. UDP no garantiza reintentos ni orden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답을 받으려면 수신을 시작하고 로그를 보세요. 끝나면 중지하세요. 답이 없으면 회신 주소, 방화벽, 포트와 인코딩을 확인하세요. UDP는 재시도나 순서를 보장하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie das Empfangen und beobachten Sie das Protokoll; stoppen Sie danach. Prüfen Sie bei fehlenden Antworten Rückadresse, Firewall, Port und Kodierung. UDP garantiert weder Wiederholung noch Reihenfolge."
          }
        }
      }
    },
    "Add a WebSocket request and enter ws:// or wss:// with the complete path. Add headers and required subprotocols before clicking Connect. Wait for the connection to open, then send messages. Incoming messages appear without resending the request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a WebSocket request and enter ws:// or wss:// with the complete path. Add headers and required subprotocols before clicking Connect. Wait for the connection to open, then send messages. Incoming messages appear without resending the request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 WebSocket 请求，填写含完整路径的 ws:// 或 wss:// URL，先补请求头和服务要求的子协议，再点“连接”。连接打开后发送消息；服务端推送消息会自动出现在日志，无需重复发送请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 WebSocket，填完整 ws:// 或 wss:// URL，先加標頭與子協定再連線。連線開啟後傳訊息，服務端推送會自動顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な ws:// または wss:// URL、ヘッダー、必要なサブプロトコルを入力して接続します。接続後にメッセージを送ります。受信メッセージは再送せず表示されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL ws:// ou wss:// complète, les en-têtes et sous-protocoles requis avant de connecter. Attendez l’ouverture, puis envoyez. Les messages entrants s’affichent sans renvoyer la requête."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe URL ws:// ou wss:// completa, cabeçalhos e subprotocolos antes de conectar. Espere abrir e envie mensagens. As recebidas aparecem sem reenviar a requisição."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca URL ws:// o wss:// completa, cabeceras y subprotocolos antes de conectar. Espere la apertura y envíe mensajes. Los entrantes aparecen sin reenviar la solicitud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 ws:// 또는 wss:// URL, 헤더와 필요한 하위 프로토콜을 입력하고 연결하세요. 열린 후 메시지를 보내세요. 수신 메시지는 요청을 다시 보내지 않아도 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie vollständige ws://- oder wss://-URL, Header und benötigte Unterprotokolle vor dem Verbinden ein. Senden Sie nach dem Öffnen Nachrichten. Eingehende Nachrichten erscheinen ohne erneutes Senden."
          }
        }
      }
    },
    "Message settings control encoding and automatic ping. Use the server’s required format; Hex sends binary data. Auto Ping helps keep idle connections active but does not authenticate them. Disconnect when finished; a failed handshake may require correcting the URL, token, or subprotocol.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message settings control encoding and automatic ping. Use the server’s required format; Hex sends binary data. Auto Ping helps keep idle connections active but does not authenticate them. Disconnect when finished; a failed handshake may require correcting the URL, token, or subprotocol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息设置可选编码和自动 Ping，格式按服务端要求；Hex 用于二进制数据。自动 Ping 可维持空闲连接，但不会完成认证。结束时断开；握手失败时核对 URL、token 和子协议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息設定選編碼和自動 Ping，Hex 用於二進位。Ping 可維持閒置連線但不是認證；結束斷線，握手失敗檢查 URL、token、子協定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でエンコードと自動 Ping を選びます。Hex はバイナリです。Ping はアイドル接続維持用で認証は行いません。終わったら切断し、握手失敗は URL・トークン・サブプロトコルを確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez encodage et ping automatique ; Hex envoie du binaire. Le ping maintient une connexion inactive mais n’authentifie pas. Déconnectez après usage ; vérifiez URL, jeton et sous-protocole si la négociation échoue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste codificação e ping automático; Hex envia binário. Ping mantém a conexão ociosa, mas não autentica. Desconecte ao terminar; confira URL, token e subprotocolo se a negociação falhar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste codificación y ping automático; Hex envía binario. Ping mantiene la conexión inactiva, pero no autentica. Desconecte al terminar; revise URL, token y subprotocolo si falla la negociación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 인코딩과 자동 Ping을 선택하세요. Hex는 바이너리입니다. Ping은 유휴 연결을 유지하지만 인증하지 않습니다. 끝나면 해제하고 연결 실패 시 URL, 토큰과 하위 프로토콜을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Kodierung und automatischen Ping; Hex sendet Binärdaten. Ping hält Leerlaufverbindungen offen, authentifiziert aber nicht. Trennen Sie nach Gebrauch und prüfen Sie bei Handshake-Fehlern URL, Token und Unterprotokoll."
          }
        }
      }
    },
    "Add an SSE request with the server’s event-stream URL. Configure headers, including any required Authorization, then connect. SSE receives a stream of server events; it is not a bidirectional message channel like WebSocket. Event IDs, types, and data appear in the event log.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an SSE request with the server’s event-stream URL. Configure headers, including any required Authorization, then connect. SSE receives a stream of server events; it is not a bidirectional message channel like WebSocket. Event IDs, types, and data appear in the event log."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 SSE 请求，填写服务端事件流 URL，配置请求头及需要的 Authorization，再连接。SSE 用于接收服务端事件，不是 WebSocket 那样的双向消息通道。事件日志显示事件 ID、类型和数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 SSE，填事件流 URL 並設定標頭與 Authorization 後連線。SSE 接收服務端事件，非雙向通道；記錄顯示事件 ID、類型和資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSE のイベント URL と必要な Authorization などのヘッダーを設定して接続します。SSE はサーバーイベント受信用で双方向ではありません。ログに ID・種類・データが表示されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez l’URL du flux SSE et les en-têtes, dont Authorization si nécessaire, puis connectez. SSE reçoit des événements serveur, sans canal bidirectionnel. Le journal montre identifiant, type et données."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure a URL SSE e os cabeçalhos, incluindo Authorization se necessário, e conecte. SSE recebe eventos do servidor, não é bidirecional. O log mostra ID, tipo e dados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure URL SSE y cabeceras, incluida Authorization si hace falta, y conecte. SSE recibe eventos del servidor, no es bidireccional. El registro muestra ID, tipo y datos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSE 이벤트 URL과 필요한 Authorization 헤더를 설정하고 연결하세요. SSE는 서버 이벤트 수신용이며 양방향 통신이 아닙니다. 로그에 ID, 유형과 데이터가 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie SSE-URL und erforderliche Header wie Authorization und verbinden Sie sich. SSE empfängt Serverereignisse und ist nicht bidirektional. Das Protokoll zeigt ID, Typ und Daten."
          }
        }
      }
    },
    "Use Connection settings to set the timeout and certificate verification. If the stream ends early, check the server heartbeat, configured timeout, and proxy buffering. A valid event service normally uses Content-Type: text/event-stream. Disconnect explicitly after collecting the events you need.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Connection settings to set the timeout and certificate verification. If the stream ends early, check the server heartbeat, configured timeout, and proxy buffering. A valid event service normally uses Content-Type: text/event-stream. Disconnect explicitly after collecting the events you need."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设置中可调超时与证书校验。事件流过早结束时检查服务心跳、超时值及代理缓冲。正常事件接口通常返回 Content-Type: text/event-stream。收集完需要的事件后主动断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線設定可調逾時和憑證驗證。流過早結束時檢查心跳、逾時及代理緩衝；事件 API 通常用 text/event-stream，完成後主動斷線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続設定でタイムアウトと証明書確認を調整します。早期終了はハートビート・タイムアウト・プロキシのバッファを確認します。通常 text/event-stream を返します。終了時に切断します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez délai et vérification du certificat. Si le flux s’arrête tôt, vérifiez battements du serveur, délai et mise en tampon du proxy. Le type attendu est généralement text/event-stream. Déconnectez après collecte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste tempo limite e verificação de certificado. Se o fluxo acabar cedo, confira heartbeat, limite e buffer do proxy. O tipo esperado costuma ser text/event-stream. Desconecte após coletar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste tiempo de espera y verificación del certificado. Si el flujo termina pronto, revise heartbeat, límite y búfer del proxy. El tipo esperado suele ser text/event-stream. Desconecte tras recoger eventos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 설정에서 시간 제한과 인증서 확인을 정하세요. 일찍 종료되면 서버 heartbeat, 제한 시간과 프록시 버퍼를 확인하세요. 보통 text/event-stream을 사용합니다. 수집 후 연결을 해제하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie Zeitlimit und Zertifikatsprüfung. Prüfen Sie bei frühem Ende Server-Heartbeat, Zeitlimit und Proxy-Puffer. Der erwartete Typ ist meist text/event-stream. Trennen Sie nach der Erfassung."
          }
        }
      }
    },
    "gRPC Schema and Unary Calls": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC Schema and Unary Calls"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 描述与一元调用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 描述與一元呼叫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC スキーマと単項呼び出し"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Schéma gRPC et appels unaires"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquema gRPC e chamadas unárias"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquema gRPC y llamadas unarias"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 스키마와 단일 호출"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC-Schema und unäre Aufrufe"
          }
        }
      }
    },
    "Add a gRPC request with authority host:port and the server’s TLS setting. In Schema, choose Proto bundle and import the .proto library with its dependencies, or choose Server reflection and Discover from server if supported. Select the resulting service and method.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a gRPC request with authority host:port and the server’s TLS setting. In Schema, choose Proto bundle and import the .proto library with its dependencies, or choose Server reflection and Discover from server if supported. Select the resulting service and method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 gRPC 请求，Authority 填 host:port，TLS 与服务端一致。在 Schema 选择 Proto bundle 导入 .proto 库及依赖，或在服务支持时选 Server reflection 并从服务器发现。描述载入后选择服务和方法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 gRPC，Authority 填 host:port，TLS 配合伺服器。Schema 可匯入 .proto 與依賴，或在伺服器支援時用反射探索，再選服務和方法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC に host:port とサーバーの TLS 設定を入力します。Schema で依存を含む .proto を読み込むか、対応サーバーで reflection による発見を行い、サービスとメソッドを選びます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez gRPC avec host:port et le TLS du serveur. Importez la bibliothèque .proto et ses dépendances, ou découvrez par réflexion si disponible. Choisissez ensuite service et méthode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione gRPC com host:port e TLS do servidor. Importe a biblioteca .proto com dependências ou descubra por reflexão se disponível. Escolha serviço e método."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada gRPC con host:port y TLS del servidor. Importe la biblioteca .proto con dependencias o descubra por reflexión si se admite. Elija servicio y método."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC에 host:port와 서버 TLS 설정을 입력하세요. 의존 파일을 포함한 .proto를 가져오거나 지원 서버에서 reflection으로 검색한 뒤 서비스와 메서드를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie gRPC mit host:port und Server-TLS hinzu. Importieren Sie .proto samt Abhängigkeiten oder ermitteln Sie Dienste per Reflection, falls unterstützt. Wählen Sie Dienst und Methode."
          }
        }
      }
    },
    "For a unary method, use JSON body mode with fields defined by the selected message schema. Add required metadata such as authorization, then click Send. Inspect the gRPC status and decoded response. Without descriptors, Hex mode requires correctly encoded protobuf bytes; arbitrary JSON is not a substitute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a unary method, use JSON body mode with fields defined by the selected message schema. Add required metadata such as authorization, then click Send. Inspect the gRPC status and decoded response. Without descriptors, Hex mode requires correctly encoded protobuf bytes; arbitrary JSON is not a substitute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一元方法选 JSON 正文，字段与所选消息描述一致；添加 authorization 等必需 metadata 后发送，查看 gRPC 状态与解码响应。没有描述时，Hex 必须是正确编码的 protobuf 字节，不能把任意 JSON 当作二进制请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一元方法選 JSON，欄位需符合描述，補上 authorization 等 metadata 後傳送，查看 gRPC 狀態和回應。無描述時 Hex 必須為正確 protobuf 位元組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単項メソッドは定義されたフィールドの JSON を入力し、authorization などの metadata を加えて送信します。gRPC 状態と応答を確認します。記述子なしの Hex は正しい protobuf バイトが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’unaire, utilisez les champs JSON du schéma, ajoutez les métadonnées requises puis envoyez. Vérifiez statut gRPC et réponse décodée. Sans descripteurs, Hex exige des octets protobuf valides, pas du JSON arbitraire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para chamada unária, use campos JSON do esquema, adicione metadata e envie. Confira status gRPC e resposta decodificada. Sem descritores, Hex exige bytes protobuf válidos, não JSON arbitrário."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la llamada unaria, use campos JSON del esquema, añada metadata y envíe. Revise estado gRPC y respuesta decodificada. Sin descriptores, Hex exige bytes protobuf válidos, no JSON arbitrario."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 호출은 스키마에 맞는 JSON과 필요한 metadata를 입력하고 보내세요. gRPC 상태와 응답을 확인하세요. 설명자가 없으면 Hex에 올바른 protobuf 바이트가 필요하며 임의 JSON은 대신할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie für unäre Methoden JSON-Felder des Schemas, ergänzen Sie Metadata und senden Sie. Prüfen Sie gRPC-Status und dekodierte Antwort. Ohne Deskriptoren verlangt Hex gültige protobuf-Bytes statt beliebigem JSON."
          }
        }
      }
    },
    "gRPC Streaming and Deadlines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC Streaming and Deadlines"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 流式调用与截止时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 串流呼叫與截止時間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC ストリームと期限"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flux gRPC et échéances"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming gRPC e prazos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming gRPC y plazos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC 스트리밍과 기한"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gRPC-Streaming und Fristen"
          }
        }
      }
    },
    "For server streaming, Send starts one request and the response log receives multiple messages; Stop stream ends listening. For client or bidirectional streaming, Connect first, edit the message body, and Send each message over the open stream.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For server streaming, Send starts one request and the response log receives multiple messages; Stop stream ends listening. For client or bidirectional streaming, Connect first, edit the message body, and Send each message over the open stream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端流式方法点“发送”发起一次请求，响应日志接收多条消息，“停止流”结束接收。客户端流式或双向流式先“连接”，再编辑消息正文，多次“发送”会使用当前打开的流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務端串流傳送一次後接收多條訊息，可停止流。客戶端或雙向串流先連線，再編輯本文，每次傳送使用同一開啟的流。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーストリームは一度送信し複数応答を受信、停止で終了します。クライアントまたは双方向ストリームは先に接続し、本文を編集して同じストリームへ各メッセージを送ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux serveur commence par un envoi et reçoit plusieurs messages ; arrêter termine la réception. Pour flux client ou bidirectionnel, connectez d’abord puis envoyez chaque message sur le flux ouvert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo do servidor começa com um envio e recebe várias mensagens; parar encerra a recepção. Para fluxo cliente ou bidirecional, conecte primeiro e envie cada mensagem no fluxo aberto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo servidor comienza con un envío y recibe varios mensajes; detener termina la recepción. Para flujo cliente o bidireccional, conecte primero y envíe cada mensaje por el flujo abierto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 스트림은 한 번 보내 여러 응답을 받고 중지로 끝냅니다. 클라이언트나 양방향 스트림은 먼저 연결한 후 본문을 편집하여 열린 스트림에 각 메시지를 보내세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server-Streaming startet mit einer Anfrage und empfängt mehrere Nachrichten; Stoppen beendet den Empfang. Bei Client- oder bidirektionalem Streaming verbinden Sie zuerst und senden einzelne Nachrichten im offenen Stream."
          }
        }
      }
    },
    "Half-close finishes only the client’s sending side and allows the server to return its final result. Cancel ends the stream. Configure request timeout and deadline in milliseconds; deadline 0 omits the explicit deadline. When a deadline is exceeded, inspect server processing before increasing it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close finishes only the client’s sending side and allows the server to return its final result. Cancel ends the stream. Configure request timeout and deadline in milliseconds; deadline 0 omits the explicit deadline. When a deadline is exceeded, inspect server processing before increasing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close 仅结束客户端发送方向，仍可等待服务器最终结果；Cancel 结束整个流。按请求配置超时和毫秒级 deadline，deadline 为 0 时不显式设置截止时间。超时先检查服务处理情况，不要只盲目加长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close 結束客戶端傳送方向，仍等待伺服器結果；Cancel 結束流。設定逾時和毫秒 deadline，0 表示不設明確期限。逾時先檢查服務處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close は送信だけを終え最終応答を待ちます。Cancel は全体を終了します。タイムアウトとミリ秒の期限を設定し、0 は明示期限なしです。超過時は延長前に処理を確認します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close termine l’envoi client mais attend le résultat serveur ; Cancel ferme le flux. Réglez délai et échéance en millisecondes ; 0 omet l’échéance explicite. Vérifiez le traitement serveur avant d’augmenter la durée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close encerra apenas o envio do cliente e aguarda o resultado; Cancel encerra o fluxo. Ajuste timeout e prazo em milissegundos; 0 omite prazo explícito. Confira o processamento antes de aumentar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close termina solo el envío del cliente y espera el resultado; Cancel termina el flujo. Ajuste espera y plazo en milisegundos; 0 omite el plazo explícito. Revise el procesamiento antes de aumentarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close는 클라이언트 송신만 끝내고 최종 응답을 기다립니다. Cancel은 스트림을 종료합니다. 시간 제한과 밀리초 기한을 설정하세요. 0은 명시 기한 없음입니다. 초과 시 서버 처리부터 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-close beendet nur das Senden und wartet auf das Serverergebnis; Cancel beendet den Stream. Setzen Sie Zeitlimit und Frist in Millisekunden; 0 lässt die explizite Frist weg. Prüfen Sie vor Verlängerung die Serververarbeitung."
          }
        }
      }
    },
    "Importing API Specifications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing API Specifications"
