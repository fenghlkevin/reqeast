            "state": "translated",
            "value": "找不到所選專案。"
          }
        }
      }
    },
    "The selected project has no requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Projekt hat keine Anfragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto seleccionado no tiene solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet sélectionné n'a aucune requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたプロジェクトにリクエストがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 프로젝트에 요청이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto selecionado não tem requisições."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目没有请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選專案沒有請求。"
          }
        }
      }
    },
    "The server cannot process the request due to a client error (malformed syntax, invalid framing, etc).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kann die Anfrage aufgrund eines Client-Fehlers nicht verarbeiten (fehlerhafte Syntax, ungültiger Rahmen usw.)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no puede procesar la solicitud debido a un error del cliente (sintaxis incorrecta, marco inválido, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne peut pas traiter la requête en raison d'une erreur client (syntaxe incorrecte, cadrage invalide, etc.)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントエラー（構文不正、無効なフレーミングなど）のため、サーバーはリクエストを処理できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 오류(잘못된 구문, 유효하지 않은 프레이밍 등)로 인해 서버가 요청을 처리할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pode processar a requisição devido a um erro do cliente (sintaxe malformada, enquadramento inválido, etc.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于客户端错误（语法错误、无效帧等），服务器无法处理请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於用戶端錯誤（語法錯誤、無效框架等），伺服器無法處理請求。"
          }
        }
      }
    },
    "The server cannot produce a response matching the criteria given by the request headers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kann keine Antwort erzeugen, die den Kriterien der Anfrage-Header entspricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no puede producir una respuesta que coincida con los criterios de las cabeceras de la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne peut pas produire une réponse correspondant aux critères des en-têtes de la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストヘッダーの条件に一致するレスポンスを生成できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청 헤더에 지정된 기준과 일치하는 응답을 생성할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pode produzir uma resposta que corresponda aos critérios dos cabeçalhos da requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法生成与请求头中指定条件匹配的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器無法產生與請求標頭中指定條件相符的回應。"
          }
        }
      }
    },
    "The server cannot store the representation needed to complete the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server kann die zur Erfüllung der Anfrage benötigte Darstellung nicht speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no puede almacenar la representación necesaria para completar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne peut pas stocker la représentation nécessaire pour compléter la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストの完了に必要な表現を保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 완료하는 데 필요한 표현을 저장할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pode armazenar a representação necessária para completar a requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法存储完成请求所需的表示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器無法儲存完成請求所需的表示。"
          }
        }
      }
    },
    "The server detected an infinite loop while processing the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat beim Verarbeiten der Anfrage eine Endlosschleife erkannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor detectó un bucle infinito al procesar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a détecté une boucle infinie lors du traitement de la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストの処理中に無限ループを検出しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 처리하는 중 무한 루프를 감지했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor detectou um loop infinito ao processar a requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器在处理请求时检测到无限循环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器在處理請求時偵測到無限迴圈。"
          }
        }
      }
    },
    "The server does not support the functionality required to fulfill the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server unterstützt die für die Anfrage erforderliche Funktionalität nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no soporta la funcionalidad necesaria para completar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne prend pas en charge la fonctionnalité nécessaire pour traiter la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストの処理に必要な機能をサポートしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 처리하는 데 필요한 기능을 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não suporta a funcionalidade necessária para atender a requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不支持完成请求所需的功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不支援完成請求所需的功能。"
          }
        }
      }
    },
    "The server does not support the HTTP version used in the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server unterstützt die in der Anfrage verwendete HTTP-Version nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no soporta la versión HTTP utilizada en la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne prend pas en charge la version HTTP utilisée dans la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストで使用されたHTTPバージョンをサポートしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청에 사용된 HTTP 버전을 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não suporta a versão HTTP usada na requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不支持请求中使用的 HTTP 版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不支援請求中使用的 HTTP 版本。"
          }
        }
      }
    },
    "The server encountered an unexpected condition that prevented it from fulfilling the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat einen unerwarteten Zustand festgestellt, der die Verarbeitung der Anfrage verhindert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor encontró una condición inesperada que le impidió completar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rencontré une condition inattendue qui l'a empêché de traiter la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが予期しない状態に遭遇し、リクエストを処理できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 예기치 않은 상황이 발생하여 요청을 처리할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor encontrou uma condição inesperada que o impediu de atender a requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器遇到了意外情况，无法完成请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器遇到了意外狀況，無法完成請求。"
          }
        }
      }
    },
    "The server has an internal configuration error: content negotiation resulted in a circular reference.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat einen internen Konfigurationsfehler: Die Inhaltsverhandlung hat zu einem Zirkelverweis geführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tiene un error de configuración interna: la negociación de contenido resultó en una referencia circular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a une erreur de configuration interne : la négociation de contenu a entraîné une référence circulaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに内部設定エラーがあります：コンテンツネゴシエーションにより循環参照が発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 내부 구성 오류가 있습니다: 콘텐츠 협상이 순환 참조를 발생시켰습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor tem um erro de configuração interna: a negociação de conteúdo resultou em uma referência circular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器存在内部配置错误：内容协商导致了循环引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器存在內部設定錯誤：內容協商導致了循環參考。"
          }
        }
      }
    },
    "The server has fulfilled a GET request and the response is a representation of one or more instance manipulations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine GET-Anfrage erfüllt und die Antwort ist eine Darstellung einer oder mehrerer Instanzmanipulationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha completado una solicitud GET y la respuesta es una representación de una o más manipulaciones de instancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a satisfait une requête GET et la réponse représente une ou plusieurs manipulations d'instances."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがGETリクエストを処理し、レスポンスは1つ以上のインスタンス操作の表現です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 GET 요청을 처리했으며 응답은 하나 이상의 인스턴스 조작의 표현입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor atendeu uma requisição GET e a resposta é uma representação de uma ou mais manipulações de instância."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已完成 GET 请求，响应是一个或多个实例操作的表示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器已完成 GET 請求，回應是一個或多個實例操作的表示。"
          }
        }
      }
    },
    "The server has received and is processing the request, but no response is available yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage empfangen und verarbeitet sie, aber es ist noch keine Antwort verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha recibido y está procesando la solicitud, pero aún no hay respuesta disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a reçu et traite la requête, mais aucune réponse n'est encore disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストを受信して処理中ですが、まだレスポンスがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 수신하고 처리 중이지만 아직 응답이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recebeu e está processando a requisição, mas nenhuma resposta está disponível ainda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已接收并正在处理请求，但尚无可用的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器已接收並正在處理請求，但尚無可用的回應。"
          }
        }
      }
    },
    "The server has received the request headers. The client should proceed to send the request body.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage-Header empfangen. Der Client sollte mit dem Senden des Anfrage-Bodys fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha recibido las cabeceras de la solicitud. El cliente debe proceder a enviar el cuerpo de la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a reçu les en-têtes de la requête. Le client doit poursuivre l'envoi du corps de la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストヘッダーを受信しました。クライアントはリクエストボディの送信を続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청 헤더를 수신했습니다. 클라이언트는 요청 본문 전송을 계속해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recebeu os cabeçalhos da requisição. O cliente deve prosseguir com o envio do corpo da requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已接收请求头。客户端应继续发送请求正文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器已接收請求標頭。用戶端應繼續傳送請求主體。"
          }
        }
      }
    },
    "The server is delivering only part of the resource due to a range header sent by the client.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server liefert aufgrund eines vom Client gesendeten Range-Headers nur einen Teil der Ressource."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor entrega solo parte del recurso debido a una cabecera Range enviada por el cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne délivre qu'une partie de la ressource en raison d'un en-tête Range envoyé par le client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントが送信したRangeヘッダーにより、サーバーはリソースの一部のみを配信しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트가 보낸 Range 헤더로 인해 서버가 리소스의 일부만 전달하고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está entregando apenas parte do recurso devido a um cabeçalho Range enviado pelo cliente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于客户端发送了范围头，服务器仅提供资源的一部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於用戶端傳送了範圍標頭，伺服器僅提供資源的一部分。"
          }
        }
      }
    },
    "The server is not ready to handle the request (overloaded or down for maintenance).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht bereit, die Anfrage zu bearbeiten (überlastet oder in Wartung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no está listo para manejar la solicitud (sobrecargado o en mantenimiento)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'est pas prêt à traiter la requête (surchargé ou en maintenance)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストを処理する準備ができていません（過負荷またはメンテナンス中）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 처리할 준비가 되지 않았습니다 (과부하 또는 유지보수 중)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não está pronto para tratar a requisição (sobrecarregado ou em manutenção)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器尚未准备好处理请求（过载或正在维护中）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器尚未準備好處理請求（過載或正在維護中）。"
          }
        }
      }
    },
    "The server is sending preliminary headers before the final response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server sendet vorläufige Header vor der endgültigen Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está enviando cabeceras preliminares antes de la respuesta final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur envoie des en-têtes préliminaires avant la réponse finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが最終レスポンスの前に予備ヘッダーを送信しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 최종 응답 전에 예비 헤더를 전송하고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está enviando cabeçalhos preliminares antes da resposta final."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器正在最终响应之前发送预备头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器正在最終回應之前傳送預備標頭。"
          }
        }
      }
    },
    "The server is switching protocols as requested by the client.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wechselt das Protokoll wie vom Client angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está cambiando de protocolo como solicitó el cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur change de protocole comme demandé par le client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントの要求に応じてサーバーがプロトコルを切り替えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트의 요청에 따라 서버가 프로토콜을 전환하고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está trocando de protocolo conforme solicitado pelo cliente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器正在按客户端请求切换协议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器正在按用戶端請求切換協定。"
          }
        }
      }
    },
    "The server is unwilling to process a request that might be replayed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht bereit, eine Anfrage zu verarbeiten, die wiederholt werden könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no está dispuesto a procesar una solicitud que podría ser repetida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur refuse de traiter une requête qui pourrait être rejouée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリプレイされる可能性のあるリクエストの処理を拒否しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 재생될 수 있는 요청을 처리하지 않으려 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não está disposto a processar uma requisição que pode ser repetida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不愿意处理可能被重放的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不願意處理可能被重放的請求。"
          }
        }
      }
    },
    "The server refuses to brew coffee because it is, permanently, a teapot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server weigert sich, Kaffee zu brühen, weil er dauerhaft eine Teekanne ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se niega a preparar café porque es, permanentemente, una tetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur refuse de préparer du café car il est, de façon permanente, une théière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはコーヒーを淹れることを拒否します。なぜなら、それは永遠にティーポットだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 영원히 찻주전자이므로 커피 내리기를 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor se recusa a preparar café porque ele é, permanentemente, um bule de chá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝冲泡咖啡，因为它永远是一只茶壶。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕沖泡咖啡，因為它永遠是一只茶壺。"
          }
        }
      }
    },
    "The server refuses to perform the request using the current protocol.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server weigert sich, die Anfrage mit dem aktuellen Protokoll auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se niega a realizar la solicitud con el protocolo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur refuse d'exécuter la requête avec le protocole actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは現在のプロトコルでリクエストの実行を拒否しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 현재 프로토콜을 사용한 요청 실행을 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor se recusa a executar a requisição usando o protocolo atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝使用当前协议执行请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕使用目前協定執行請求。"
          }
        }
      }
    },
    "The server requires a Content-Length header in the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server erfordert einen Content-Length-Header in der Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor requiere una cabecera Content-Length en la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur exige un en-tête Content-Length dans la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストにContent-Lengthヘッダーを要求しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청에 Content-Length 헤더를 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor requer um cabeçalho Content-Length na requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求请求中包含 Content-Length 头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器要求請求中包含 Content-Length 標頭。"
          }
        }
      }
    },
    "The server requires the request to be conditional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server erfordert eine bedingte Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor requiere que la solicitud sea condicional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur exige que la requête soit conditionnelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは条件付きリクエストを要求しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 조건부 요청을 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor requer que a requisição seja condicional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求请求为条件性的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器要求請求為條件式的。"
          }
        }
      }
    },
    "The server timed out waiting for the request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat beim Warten auf die Anfrage die Zeitüberschreitung erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor agotó el tiempo de espera de la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a expiré en attendant la requête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストの待機中にタイムアウトしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 기다리다 시간이 초과되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor expirou aguardando a requisição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器等待请求超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器等待請求逾時。"
          }
        }
      }
    },
    "The server understood the request but refuses to authorize it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage verstanden, verweigert aber die Autorisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor entendió la solicitud pero se niega a autorizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a compris la requête mais refuse de l'autoriser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはリクエストを理解しましたが、承認を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 이해했지만 승인을 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor entendeu a requisição, mas se recusa a autorizá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器理解了请求但拒绝授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器理解了請求但拒絕授權。"
          }
        }
      }
    },
    "The server, while acting as a gateway, did not receive a timely response from the upstream server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat als Gateway keine rechtzeitige Antwort vom Upstream-Server erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor, actuando como puerta de enlace, no recibió una respuesta oportuna del servidor upstream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur, agissant comme passerelle, n'a pas reçu de réponse en temps voulu du serveur en amont."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲートウェイとして動作中のサーバーが上流サーバーからタイムリーなレスポンスを受信できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이로 작동 중인 서버가 업스트림 서버로부터 적시에 응답을 받지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor, atuando como gateway, não recebeu uma resposta em tempo do servidor upstream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器作为网关时，未能从上游服务器收到及时的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器作為閘道時，未能從上游伺服器收到及時的回應。"
          }
        }
      }
    },
    "The server, while acting as a gateway, received an invalid response from the upstream server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat als Gateway eine ungültige Antwort vom Upstream-Server erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor, actuando como puerta de enlace, recibió una respuesta inválida del servidor upstream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur, agissant comme passerelle, a reçu une réponse invalide du serveur en amont."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲートウェイとして動作中のサーバーが上流サーバーから無効なレスポンスを受信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이로 작동 중인 서버가 업스트림 서버로부터 잘못된 응답을 받았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor, atuando como gateway, recebeu uma resposta inválida do servidor upstream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器作为网关时，从上游服务器收到了无效的响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器作為閘道時，從上游伺服器收到了無效的回應。"
          }
        }
      }
    },
    "The URL is invalid.": {
      "comment": "Validation error for malformed URL input.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL ist ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL no es válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL n'est pas valide."
          }
        },
        "ja": {
          "stringUnit": {
