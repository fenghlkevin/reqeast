    "Open Settings → Appearance and choose Follow System, Light, or Dark. The choice is saved and applies to the workspace and Settings. Follow System switches with your device appearance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Appearance and choose Follow System, Light, or Dark. The choice is saved and applies to the workspace and Settings. Follow System switches with your device appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置 → 外观”，选择跟随系统、浅色或深色。选择会保存，并应用于工作空间和设置窗口。跟随系统会随设备外观切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「設定 → 外觀」，選跟隨系統、淺色或深色。選擇會儲存並套用至工作空間與設定視窗。跟隨系統會依裝置外觀切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 外観で、システムに合わせる、ライト、ダークを選びます。選択は保存され、ワークスペースと設定に適用されます。システム設定に合わせると端末の外観に従います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages → Apparence, choisissez système, clair ou sombre. Le choix est conservé pour l’espace de travail et les réglages. Le mode système suit votre appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes → Aparência, escolha sistema, claro ou escuro. A escolha é salva para o espaço de trabalho e os ajustes. O modo sistema acompanha o dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes → Apariencia, elija sistema, claro u oscuro. La elección se guarda para el espacio de trabajo y los ajustes. El modo sistema sigue al dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 모양에서 시스템 설정 따르기, 라이트 또는 다크를 선택하세요. 선택은 저장되고 작업 공간과 설정에 적용됩니다. 시스템 모드는 기기 모양을 따릅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in Einstellungen → Darstellung System, Hell oder Dunkel. Die Auswahl wird für Arbeitsbereich und Einstellungen gespeichert. System folgt dem Gerät."
          }
        }
      }
    },
