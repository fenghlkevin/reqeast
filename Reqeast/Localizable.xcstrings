    "Spec file exceeds the 5 MiB iCloud asset limit and will not sync.": {
      "comment": "Error message displayed when a spec file is too large to upload.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spec-Datei überschreitet das 5-MiB-iCloud-Assetlimit und wird nicht synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de especificación supera el límite de 5 MiB de activos de iCloud y no se sincronizará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de spécification dépasse la limite de 5 Mio pour les ressources iCloud et ne sera pas synchronisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕様ファイルが 5 MiB の iCloud アセット制限を超えているため、同期されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사양 파일이 5MiB iCloud 자산 제한을 초과하여 동기화되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de especificação excede o limite de 5 MiB de ativos do iCloud e não será sincronizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规范文件超过 5 MiB 的 iCloud 资源限制，将不会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規格檔案超過 5 MiB 的 iCloud 資產限制，將不會同步。"
          }
        }
      }
    },
    "Spec file is missing on disk and cannot be uploaded to iCloud.": {
      "comment": "Error message when a spec file is missing on disk and cannot be uploaded to iCloud.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spec-Datei fehlt auf der Festplatte und kann nicht in iCloud hochgeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de especificación no está en el disco y no se puede subir a iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de spécification est absent du disque et ne peut pas être téléversé vers iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕様ファイルがディスクに存在しないため、iCloud にアップロードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사양 파일이 디스크에 없어 iCloud에 업로드할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de especificação local está ausente e não pode ser enviado ao iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地规范文件缺失，无法上传到 iCloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地規格檔案遺失，無法上傳到 iCloud。"
          }
        }
      }
    },
    "Spec file is unavailable on this device. Requests are read-only until the spec can be downloaded from iCloud or the source URL.": {
      "comment": "A message that indicates that the spec is unavailable on this device.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spec-Datei ist auf diesem Gerät nicht verfügbar. Anfragen sind schreibgeschützt, bis die Spec von iCloud oder der Quell-URL heruntergeladen werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de especificación no está disponible en este dispositivo. Las solicitudes son de solo lectura hasta que la especificación se pueda descargar de iCloud o la URL de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de spécification n'est pas disponible sur cet appareil. Les requêtes sont en lecture seule jusqu'à ce que la spécification puisse être téléchargée depuis iCloud ou l'URL source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは仕様ファイルを利用できません。iCloud またはソース URL から仕様をダウンロードできるまで、リクエストは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 사양 파일을 사용할 수 없습니다. iCloud 또는 소스 URL에서 사양을 다운로드할 때까지 요청은 읽기 전용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de especificação não está disponível neste dispositivo. As requisições são somente leitura até que a especificação possa ser baixada do iCloud ou da URL de origem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上无法使用规范文件。在可从 iCloud 或来源 URL 下载规范之前，请求为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
