    },
    "Add the exported folder to your repository and review the JSON diff. Request filenames and keys remain stable. Export later edits to another folder, compare the files, and replace the tracked copies you intend to update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the exported folder to your repository and review the JSON diff. Request filenames and keys remain stable. Export later edits to another folder, compare the files, and replace the tracked copies you intend to update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把导出文件夹加入 Git，检查 JSON 改动。文件名与字段顺序稳定。后续导出到新文件夹，比较后替换需要更新的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將匯出資料夾加入 Git，檢查 JSON 變更。檔名與欄位順序固定。之後匯出到新資料夾，比較後替換需更新的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したフォルダを Git に追加し、JSON の差分を確認します。ファイル名とキー順は固定です。後の変更は別フォルダに書き出し、比較して対象を置き換えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le dossier à Git et vérifiez le diff JSON. Les noms et clés restent stables. Exportez les modifications ailleurs, comparez puis remplacez les fichiers voulus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a pasta ao Git e revise o diff JSON. Nomes e chaves são estáveis. Exporte alterações em outra pasta, compare e substitua os arquivos desejados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada la carpeta a Git y revise el diff JSON. Nombres y claves son estables. Exporte cambios a otra carpeta, compare y sustituya los archivos deseados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 Git에 추가하고 JSON 차이를 확인하세요. 파일명과 키 순서는 고정됩니다. 다음 변경은 다른 폴더로 내보내 비교한 뒤 필요한 파일을 교체하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Ordner zu Git hinzu und prüfen Sie den JSON-Diff. Namen und Schlüssel bleiben stabil. Spätere Änderungen separat exportieren, vergleichen und gewünschte Dateien ersetzen."
          }
        }
      }
    },
    "An extracted variable shows the source request, response field, and update time. A manually entered variable says Defined in the environment. Secret values remain hidden unless you enable Show Secret Values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An extracted variable shows the source request, response field, and update time. A manually entered variable says Defined in the environment. Secret values remain hidden unless you enable Show Secret Values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取的变量显示来源请求、响应字段和更新时间；手动填写的值显示“在环境中手动设置”。敏感值默认隐藏，开启“显示敏感值”才会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取的變數顯示來源請求、回應欄位與更新時間；手動值顯示「在環境中手動設定」。啟用「顯示敏感值」才會顯示敏感值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得した変数はリクエスト名、フィールド、更新時刻を表示します。手入力は環境の設定と表示されます。秘密の値は表示スイッチを有効にするまで非表示です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs extraites affichent requête, champ et date. Les valeurs manuelles indiquent leur définition dans l’environnement. Activez l’affichage des secrets pour les voir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores extraídos mostram requisição, campo e data. Valores manuais indicam definição no ambiente. Ative Mostrar valores secretos para vê-los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores extraídos muestran solicitud, campo y fecha. Los manuales indican su definición en el entorno. Active Mostrar valores secretos para verlos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출한 변수는 요청, 필드, 업데이트 시간을 표시합니다. 수동 값은 환경에서 설정했다고 표시합니다. 비밀 값은 표시 옵션을 켜야 보입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahierte Werte zeigen Anfrage, Feld und Zeitpunkt. Manuelle Werte zeigen die Definition in der Umgebung. Geheime Werte werden erst nach Aktivieren der Anzeige sichtbar."
          }
        }
      }
    },
    "Build reqeast-cli from the repository, then run an exported workflow by name. Use --data for CSV or JSON rows and --report for a JSON report. Exit codes: 0 passed, 1 failed checks or requests, 2 configuration error.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build reqeast-cli from the repository, then run an exported workflow by name. Use --data for CSV or JSON rows and --report for a JSON report. Exit codes: 0 passed, 1 failed checks or requests, 2 configuration error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从仓库构建 reqeast-cli，按名称执行导出的工作流。--data 指定 CSV/JSON，--report 保存 JSON 报告。退出码 0 为通过，1 为测试失败，2 为配置错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從儲存庫建置 reqeast-cli，依名稱執行匯出的工作流程。--data 指定 CSV/JSON，--report 儲存 JSON 報告。結束碼 0 通過、1 測試失敗、2 設定錯誤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli をビルドし、書き出した手順を名前で実行します。--data は CSV/JSON、--report は JSON レポートです。終了コードは0が成功、1がテスト失敗、2が設定エラーです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilez reqeast-cli et lancez le workflow exporté par son nom. --data fournit CSV/JSON, --report écrit le rapport. Codes : 0 réussite, 1 échec des tests, 2 erreur de configuration."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compile reqeast-cli e execute o fluxo exportado pelo nome. --data fornece CSV/JSON; --report grava o relatório. Códigos: 0 sucesso, 1 falha nos testes, 2 erro de configuração."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compile reqeast-cli y ejecute el flujo exportado por nombre. --data aporta CSV/JSON y --report guarda el informe. Códigos: 0 éxito, 1 fallo de pruebas, 2 error de configuración."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli를 빌드하고 내보낸 흐름을 이름으로 실행하세요. --data는 CSV/JSON, --report는 JSON 보고서입니다. 종료 코드: 0 통과, 1 테스트 실패, 2 설정 오류."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauen Sie reqeast-cli und starten Sie den exportierten Ablauf nach Namen. --data für CSV/JSON, --report für JSON-Berichte. Codes: 0 Erfolg, 1 Testfehler, 2 Konfigurationsfehler."
          }
        }
      }
    },
    "CSV column names or JSON object keys are variable names. Every row must have the same fields. JSON values must be strings, numbers, or booleans. CSV supports quoted commas and newlines. Limits are 1 MB and 1000 rows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV column names or JSON object keys are variable names. Every row must have the same fields. JSON values must be strings, numbers, or booleans. CSV supports quoted commas and newlines. Limits are 1 MB and 1000 rows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 表头或 JSON 对象键就是变量名。各行字段必须一致；JSON 值仅支持字符串、数字或布尔值。CSV 支持引号中的逗号和换行。最大 1 MB、1000 行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 標題列或 JSON 物件鍵即變數名。各列欄位須一致；JSON 僅接受字串、數字或布林值。CSV 支援引號內的逗號與換行。上限 1 MB、1000 列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 見出しや JSON キーが変数名です。全行のフィールドを揃え、JSON 値は文字列・数値・真偽値にします。CSV は引用符内のカンマや改行に対応します。上限は1 MB、1000行です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les en-têtes CSV ou clés JSON sont les variables. Gardez les mêmes champs partout, avec des valeurs JSON texte, nombre ou booléen. CSV accepte virgules et retours cités. Limites : 1 Mo, 1000 lignes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeçalhos CSV ou chaves JSON são variáveis. Todas as linhas devem ter campos iguais; JSON aceita texto, número ou booleano. CSV aceita vírgulas e quebras entre aspas. Limites: 1 MB, 1000 linhas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cabeceras CSV o claves JSON son variables. Use los mismos campos en cada fila; JSON admite texto, números y booleanos. CSV admite comas y saltos entre comillas. Límites: 1 MB, 1000 filas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV 헤더나 JSON 키가 변수명입니다. 모든 행의 필드는 같아야 하며 JSON 값은 문자열, 숫자, 불리언만 허용합니다. CSV는 따옴표 안의 쉼표와 줄바꿈을 지원합니다. 최대 1 MB, 1000행입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV-Kopfzeilen oder JSON-Schlüssel sind Variablennamen. Alle Zeilen brauchen gleiche Felder; JSON-Werte sind Text, Zahlen oder Boolesche Werte. CSV unterstützt zitierte Kommas und Zeilenumbrüche. Grenzen: 1 MB, 1000 Zeilen."
          }
        }
      }
    },
    "Click Clear Test Data before running without data rows. Data files are not embedded in saved workflows or exported project folders. Choose the input file again when reopening the panel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Clear Test Data before running without data rows. Data files are not embedded in saved workflows or exported project folders. Choose the input file again when reopening the panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用数据行时，先点击“清除测试数据”。数据文件不随工作流保存，也不随项目导出。重新打开面板后需要再次选择文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用資料列時，先按「清除測試資料」。資料檔不隨工作流程儲存或專案匯出。重開面板後須再次選檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の実行に戻すにはテストデータを解除します。データファイルは手順や書き出しに保存されません。パネルを開き直したら再選択してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez les données de test pour un lancement simple. Elles ne sont ni enregistrées dans le workflow ni exportées. Resélectionnez le fichier après réouverture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe os dados para executar normalmente. O arquivo não é salvo no fluxo nem exportado. Selecione-o novamente ao reabrir o painel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quite los datos para ejecutar normalmente. El archivo no se guarda en el flujo ni se exporta. Selecciónelo de nuevo al reabrir el panel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 실행 전 테스트 데이터를 지우세요. 데이터 파일은 흐름에 저장되거나 내보내지지 않습니다. 패널을 다시 열면 파일을 다시 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für normale Läufe Testdaten entfernen. Die Datei wird weder im Ablauf gespeichert noch exportiert. Beim erneuten Öffnen nochmals auswählen."
          }
        }
      }
    },
    "Click Import Project Folder and choose a folder containing reqeast.json. A new project is created, with new internal IDs and restored workflow references. Existing projects are kept. Select the imported project in the sidebar and set its secret values before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Import Project Folder and choose a folder containing reqeast.json. A new project is created, with new internal IDs and restored workflow references. Existing projects are kept. Select the imported project in the sidebar and set its secret values before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“导入项目文件夹”，选择包含 reqeast.json 的目录。程序会创建新项目，重建内部 ID 和工作流引用，保留原项目。到侧栏选中新项目，补齐敏感值后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「匯入專案資料夾」，選含 reqeast.json 的目錄。程式建立新專案並重建 ID 與引用，保留原專案。從側欄選新專案，補齊敏感值再傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast.json を含むフォルダを読み込みます。新しい ID と参照で新規プロジェクトを作り、既存のものは保持します。サイドバーで選び、秘密の値を設定してから送信します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un dossier contenant reqeast.json. Un nouveau projet avec de nouveaux ID et références est créé. L’existant reste intact. Sélectionnez la copie et renseignez les secrets avant l’envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe a pasta com reqeast.json. Um novo projeto terá novos IDs e referências. Os existentes são mantidos. Selecione a cópia e preencha os segredos antes de enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe la carpeta con reqeast.json. Se crea un proyecto con nuevos ID y referencias, conservando los existentes. Seleccione la copia y complete los secretos antes de enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast.json이 있는 폴더를 가져오세요. 새 ID와 참조를 가진 프로젝트가 만들어지고 기존 프로젝트는 유지됩니다. 사이드바에서 사본을 선택하고 비밀 값을 채운 뒤 전송하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie den Ordner mit reqeast.json. Ein neues Projekt mit neuen IDs und Referenzen entsteht; bestehende bleiben erhalten. Kopie auswählen und vor dem Senden Geheimnisse ergänzen."
          }
        }
      }
    },
    "Click Run Selected Requests. Requests are actually sent one at a time. Each result shows status, time, checks, and errors. A non-2xx response or failed extraction/check counts as failure. Stop Run prevents later sends, but an in-flight request may still finish. Export Run Report saves results as JSON without response bodies or variable values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Run Selected Requests. Requests are actually sent one at a time. Each result shows status, time, checks, and errors. A non-2xx response or failed extraction/check counts as failure. Stop Run prevents later sends, but an in-flight request may still finish. Export Run Report saves results as JSON without response bodies or variable values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“运行选中请求”会逐个真实发送，结果显示状态、耗时、检查与错误。非 2xx、提取失败或检查失败均算失败。“停止运行”阻止后续请求，已发送的仍可能完成。可导出不含响应正文和变量值的 JSON 报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「執行所選請求」會逐一實際傳送，結果含狀態、時間、檢查與錯誤。非 2xx、擷取或檢查失敗均算失敗。停止僅阻止後續請求。JSON 報告不含回應本文與變數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したリクエストを順に送信します。結果は状態、時間、チェック、エラーを表示します。2xx 以外や取得・チェックの失敗は失敗です。停止は後続の送信を止めます。JSON レポートは本文と変数値を含みません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez les requêtes sélectionnées. Les résultats affichent statut, durée, contrôles et erreurs. Hors 2xx ou extraction/contrôle raté = échec. L’arrêt bloque les envois suivants. Le rapport JSON exclut corps et valeurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute as requisições selecionadas. Resultados mostram status, tempo, verificações e erros. Fora de 2xx ou erro de extração/verificação conta como falha. Parar bloqueia os próximos envios. O relatório JSON exclui corpos e valores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecute las solicitudes seleccionadas. Los resultados muestran estado, tiempo, comprobaciones y errores. Fuera de 2xx o extracción/comprobación fallida es fallo. Detener bloquea envíos posteriores. El informe JSON excluye cuerpos y valores."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요청을 순서대로 실제 전송합니다. 상태, 시간, 검사, 오류를 표시합니다. 2xx 외 응답이나 추출·검사 실패는 실패입니다. 중지는 후속 전송을 막습니다. JSON 보고서에는 본문과 변수 값이 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Anfragen werden einzeln gesendet. Ergebnisse zeigen Status, Dauer, Prüfungen und Fehler. Nicht-2xx oder Extraktions-/Prüffehler zählen als Fehler. Stopp verhindert weitere Sends. JSON-Berichte enthalten keine Körper oder Variablenwerte."
          }
        }
      }
    },
    "Click Run Selected Requests. Row values replace environment variables during that row, and response extractions are available to its later requests. Each new row starts from the original environment. Result numbers identify the data row. Stop on first failure stops the remaining rows too.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Run Selected Requests. Row values replace environment variables during that row, and response extractions are available to its later requests. Each new row starts from the original environment. Result numbers identify the data row. Stop on first failure stops the remaining rows too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“运行选中请求”。每行数据临时覆盖环境值，提取的响应值供该行后续请求使用。新行从原环境重新开始。结果编号表示数据行；“首次失败时停止”也会停止剩余数据行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「執行所選請求」。每列資料暫時覆寫環境值，擷取值供同列後續請求使用。新列從原環境開始。結果編號是資料列；首次失敗停止也會停止其餘列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行の値で環境を一時上書きし、その行内で取得値を共有します。次の行は元の環境から開始します。結果番号はデータ行です。最初の失敗で停止すると残りの行も止まります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne remplace temporairement l’environnement et partage les valeurs extraites avec ses requêtes suivantes. La ligne suivante repart de l’original. Les numéros désignent les lignes. L’arrêt au premier échec stoppe aussi les lignes restantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha substitui temporariamente o ambiente e compartilha valores extraídos com suas próximas requisições. A próxima começa do original. Os números são linhas. Parar na primeira falha também interrompe as restantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fila sustituye temporalmente el entorno y comparte valores extraídos con sus solicitudes siguientes. La próxima empieza desde el original. Los números indican filas. Detener al primer fallo para también las restantes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 행은 환경 값을 임시로 덮어쓰고 추출한 값을 같은 행의 후속 요청에 전달합니다. 다음 행은 원래 환경에서 시작합니다. 결과 번호는 데이터 행입니다. 첫 실패 시 중지는 남은 행도 중단합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile überschreibt die Umgebung vorübergehend und teilt extrahierte Werte mit ihren Folgeanfragen. Die nächste beginnt mit dem Original. Nummern bezeichnen Datenzeilen. Stopp beim ersten Fehler beendet auch übrige Zeilen."
          }
        }
      }
    },
    "Create a project, then use the add-request menu to add three separate HTTP requests. Name them Login, Create order, and Query order. Set their methods and URLs to POST /login, POST /orders, and GET /orders/{{orderId}}. Replace the example host and paths with your API.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a project, then use the add-request menu to add three separate HTTP requests. Name them Login, Create order, and Query order. Set their methods and URLs to POST /login, POST /orders, and GET /orders/{{orderId}}. Replace the example host and paths with your API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建项目，通过添加请求菜单新建三个独立的 HTTP 请求，分别命名 Login、Create order、Query order。方法与路径设为 POST /login、POST /orders、GET /orders/{{orderId}}。按实际 API 修改主机和路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立專案，透過新增請求選單建立三個 HTTP 請求：Login、Create order、Query order。方法路徑為 POST /login、POST /orders、GET /orders/{{orderId}}，主機與路徑請依 API 調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトを作成し、追加メニューで Login、Create order、Query order の3件を作ります。POST /login、POST /orders、GET /orders/{{orderId}} を設定し、ホストとパスを API に合わせます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un projet puis trois requêtes HTTP via le menu d’ajout : Login, Create order, Query order. Configurez POST /login, POST /orders et GET /orders/{{orderId}}. Adaptez hôte et chemins à votre API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um projeto e três requisições pelo menu: Login, Create order, Query order. Configure POST /login, POST /orders e GET /orders/{{orderId}}. Adapte host e caminhos à sua API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree un proyecto y tres solicitudes mediante el menú: Login, Create order, Query order. Configure POST /login, POST /orders y GET /orders/{{orderId}}. Adapte servidor y rutas a su API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 만들고 추가 메뉴에서 Login, Create order, Query order 요청을 각각 만드세요. POST /login, POST /orders, GET /orders/{{orderId}}를 설정하고 호스트와 경로를 실제 API에 맞추세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt und drei HTTP-Anfragen über das Hinzufügen-Menü erstellen: Login, Create order, Query order. POST /login, POST /orders und GET /orders/{{orderId}} festlegen. Host und Pfade an Ihre API anpassen."
          }
        }
      }
    },
    "Each data row runs the whole workflow. Column names replace variables for that row. Extracted values stay within the row; your saved environment is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each data row runs the whole workflow. Column names replace variables for that row. Extracted values stay within the row; your saved environment is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行数据都会运行整个工作流。列名对应变量名，只覆盖当前行；提取值在该行内传递，不修改保存的环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每列資料執行完整工作流程。欄名對應變數，只覆寫目前列；擷取值僅在該列傳遞，不更改儲存環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各データ行で全手順を実行します。列名の変数をその行だけ上書きし、取得値も行内で共有します。保存済み環境は変えません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne exécute tout le workflow. Les colonnes remplacent les variables de cette ligne. Les valeurs extraites restent dans la ligne, sans modifier l’environnement sauvegardé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha executa todo o fluxo. Colunas substituem variáveis apenas nessa linha. Valores extraídos ficam nela, sem alterar o ambiente salvo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fila ejecuta todo el flujo. Las columnas sustituyen variables solo en esa fila. Los valores extraídos quedan en ella sin cambiar el entorno guardado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 데이터 행이 전체 흐름을 실행합니다. 열 이름은 해당 행의 변수를 덮어씁니다. 추출 값은 그 행에만 전달되며 저장한 환경은 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datenzeile führt den ganzen Ablauf aus. Spalten überschreiben Variablen nur für diese Zeile. Extrahierte Werte bleiben darin; die gespeicherte Umgebung bleibt unverändert."
          }
        }
      }
    },
    "Enter Order test in Workflow Name, choose Test in Environment, and enable Stop on first failure. Click Save Workflow. Saved workflows belong to this project and sync with its project record. Choose one from the Workflow picker to restore its order and settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Order test in Workflow Name, choose Test in Environment, and enable Stop on first failure. Click Save Workflow. Saved workflows belong to this project and sync with its project record. Choose one from the Workflow picker to restore its order and settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流名称填 Order test，环境选 Test，开启“首次失败时停止”，点击“保存工作流”。它保存在当前项目中，随项目记录同步。之后从工作流菜单选择它即可恢复顺序和设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱填 Order test，環境選 Test，啟用首次失敗停止並儲存。工作流程存於目前專案，隨專案記錄同步。之後從選單選取即可還原順序與設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を Order test、環境を Test にし、最初の失敗で停止を有効にして保存します。プロジェクトに保存・同期されます。選択メニューから順序と設定を復元できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez Order test, choisissez Test, activez l’arrêt au premier échec et enregistrez. Le workflow est stocké et synchronisé avec le projet. Le sélecteur restaure ordre et réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomeie Order test, escolha Test, ative Parar na primeira falha e salve. O fluxo é salvo e sincronizado com o projeto. O seletor restaura ordem e opções."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre Order test, elija Test, active Detener al primer fallo y guarde. El flujo se guarda y sincroniza con el proyecto. El selector restaura orden y ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 Order test, 환경은 Test로 설정하고 첫 실패 시 중지를 켠 뒤 저장하세요. 흐름은 프로젝트와 함께 저장·동기화됩니다. 선택 메뉴에서 순서와 설정을 복원할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Order test benennen, Test wählen, Stopp beim ersten Fehler aktivieren und speichern. Der Ablauf wird mit dem Projekt gespeichert und synchronisiert. Die Auswahl stellt Reihenfolge und Einstellungen wieder her."
          }
        }
      }
    },
    "Exit code 0 means every executed request and check passed. Code 1 means a request, extraction, or check failed. Code 2 means invalid input or configuration. --report writes JSON results without response bodies or variable values. Use your CI secret store for credentials and collect the report as an artifact.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit code 0 means every executed request and check passed. Code 1 means a request, extraction, or check failed. Code 2 means invalid input or configuration. --report writes JSON results without response bodies or variable values. Use your CI secret store for credentials and collect the report as an artifact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出码 0 表示执行的请求和检查全部通过；1 表示请求、提取或检查失败；2 表示输入或配置错误。--report 输出不含正文和变量值的 JSON 报告。在 CI 密钥库配置凭据，并收集报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束碼 0 表示請求與檢查全通過；1 為請求、擷取或檢查失敗；2 為輸入或設定錯誤。--report 輸出不含本文與變數值的 JSON。CI 用密鑰庫設定憑證並收集報告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了コード0は全件成功、1は送信・取得・チェック失敗、2は入力や設定の誤りです。--report の JSON は本文や変数値を含みません。CI の秘密情報ストアで認証し、レポートを保存します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code 0 : tout réussi ; 1 : requête, extraction ou contrôle échoué ; 2 : entrée ou configuration invalide. --report exclut corps et valeurs. Utilisez les secrets de la CI et conservez le rapport."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código 0: tudo passou; 1: falha de requisição, extração ou verificação; 2: entrada ou configuração inválida. --report exclui corpos e valores. Use segredos do CI e colete o relatório."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código 0: todo pasó; 1: fallo de solicitud, extracción o comprobación; 2: entrada o configuración inválida. --report excluye cuerpos y valores. Use secretos de CI y recopile el informe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 코드 0은 모두 통과, 1은 요청·추출·검사 실패, 2는 입력·설정 오류입니다. --report는 본문과 변수 값을 제외합니다. CI 비밀 저장소로 인증하고 보고서를 수집하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code 0: alles bestanden; 1: Anfrage-, Extraktions- oder Prüffehler; 2: Eingabe- oder Konfigurationsfehler. --report ohne Körper und Werte. CI-Geheimnisspeicher verwenden und Bericht sammeln."
          }
        }
      }
    },
    "Export HTTP requests, environments, and saved workflows into a folder. Each request has a separate JSON file with stable names and sorted keys for Git review. Other protocols and attached files are not included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export HTTP requests, environments, and saved workflows into a folder. Each request has a separate JSON file with stable names and sorted keys for Git review. Other protocols and attached files are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 HTTP 请求、环境和已保存工作流导出为文件夹。每个请求单独一个 JSON，文件名与键顺序稳定，便于 Git 检查。不包含其他协议和附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 HTTP 請求、環境與工作流程匯出為資料夾。每個請求獨立 JSON，檔名與鍵順序固定，便於 Git 檢查。不含其他協定與附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエスト、環境、手順をフォルダに書き出します。各リクエストは個別 JSON で、名前とキー順は固定です。他のプロトコルや添付は含みません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez requêtes HTTP, environnements et workflows dans un dossier. Un JSON stable par requête facilite Git. Les autres protocoles et pièces jointes sont exclus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte requisições HTTP, ambientes e fluxos para uma pasta. Um JSON estável por requisição facilita o Git. Outros protocolos e anexos são excluídos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte solicitudes HTTP, entornos y flujos a una carpeta. Un JSON estable por solicitud facilita Git. Otros protocolos y adjuntos quedan excluidos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청, 환경, 저장한 흐름을 폴더로 내보냅니다. 각 요청의 JSON 파일명과 키 순서가 고정되어 Git 검토가 쉽습니다. 다른 프로토콜과 첨부는 제외됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Anfragen, Umgebungen und Abläufe in einen Ordner exportieren. Stabiles JSON pro Anfrage erleichtert Git. Andere Protokolle und Anhänge werden ausgeschlossen."
          }
        }
      }
    },
    "Follow this example with your own API. Screenshots show the macOS app using fictional demo data. On iPhone and iPad, the same actions may appear in menus. Nothing in this manual sends a request automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow this example with your own API. Screenshots show the macOS app using fictional demo data. On iPhone and iPad, the same actions may appear in menus. Nothing in this manual sends a request automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用自己的 API 按步骤操作。截图来自 macOS 程序，使用虚构演示数据；iPhone/iPad 上相同操作可能位于菜单中。阅读手册不会自动发送请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用自己的 API 依步驟操作。截圖來自 macOS，使用虛構資料；iPhone/iPad 的相同操作可能在選單中。閱讀手冊不會傳送請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の API で手順を試してください。画面は macOS の架空データです。iPhone/iPad では同じ操作がメニュー内にある場合があります。読むだけで送信されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez avec votre API. Captures macOS avec données fictives ; sur iPhone/iPad, les actions peuvent être dans des menus. Lire le manuel n’envoie rien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga com sua API. Capturas do macOS usam dados fictícios; no iPhone/iPad, ações podem estar em menus. Ler o manual não envia requisições."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga con su API. Las capturas macOS usan datos ficticios; en iPhone/iPad, las acciones pueden estar en menús. Leer el manual no envía solicitudes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 API에 맞춰 따라 하세요. macOS 스크린샷은 가상 데이터를 사용합니다. iPhone/iPad에서는 같은 작업이 메뉴에 있을 수 있습니다. 설명서를 읽어도 요청은 전송되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie mit Ihrer API. macOS-Screenshots zeigen Beispieldaten; auf iPhone/iPad liegen Aktionen eventuell in Menüs. Das Lesen sendet keine Anfrage."
          }
        }
      }
    },
    "If the host, token, or body is wrong, close the panel and fix the environment or request. Reopen the preview to verify, then click Send in the editor. Opening a preview never sends the request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the host, token, or body is wrong, close the panel and fix the environment or request. Reopen the preview to verify, then click Send in the editor. Opening a preview never sends the request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址、token 或正文有误时，关闭面板并修改环境或请求，再打开预览核对。确认后回到编辑器点击发送。预览本身不发送请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址、token 或本文有誤時，關閉面板修改環境或請求，再開預覽確認。確認後返回編輯器傳送。預覽不會傳送請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト、token、本文に誤りがあれば閉じて修正し、再度プレビューします。確認後エディタで送信します。プレビューは送信しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez hôte, token ou corps dans l’éditeur ou l’environnement, puis revérifiez l’aperçu. Envoyez depuis l’éditeur. L’aperçu ne transmet rien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija host, token ou corpo no editor ou ambiente e confira novamente a prévia. Envie pelo editor. A prévia não envia nada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija servidor, token o cuerpo en el editor o entorno y revise otra vez. Envíe desde el editor. La vista previa no envía nada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트, token, 본문이 틀리면 패널을 닫고 환경이나 요청을 수정한 뒤 다시 확인하세요. 편집기에서 전송하세요. 미리보기는 요청을 보내지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host, Token oder Körper im Editor bzw. in der Umgebung korrigieren und Vorschau erneut prüfen. Danach im Editor senden. Die Vorschau sendet nichts."
          }
        }
      }
    },
    "Import creates a new project. Existing projects are kept. Export again to a new folder and review changes in Git before replacing tracked files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import creates a new project. Existing projects are kept. Export again to a new folder and review changes in Git before replacing tracked files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入会创建新项目，保留现有项目。后续请导出到新文件夹，用 Git 比较改动后再替换跟踪的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入建立新專案並保留既有專案。之後匯出至新資料夾，以 Git 比較後替換追蹤檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みは既存を保ち、新規プロジェクトを作ります。更新は別フォルダに書き出し、Git で比較してから置き換えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’import crée un nouveau projet sans supprimer l’existant. Exportez ailleurs et vérifiez le diff Git avant de remplacer les fichiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação cria outro projeto e mantém os existentes. Exporte em outra pasta e confira o diff Git antes de substituir arquivos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación crea otro proyecto y conserva los existentes. Exporte a otra carpeta y revise el diff Git antes de sustituir archivos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기는 기존 프로젝트를 유지하고 새 프로젝트를 만듭니다. 다른 폴더로 내보내 Git 차이를 확인한 뒤 파일을 교체하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import erstellt ein neues Projekt und erhält vorhandene. Separat exportieren und Git-Diff prüfen, bevor Dateien ersetzt werden."
          }
        }
      }
    },
    "Inspect Request shows the variables referenced by this request and explains where their current values came from.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect Request shows the variables referenced by this request and explains where their current values came from."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“检查请求”列出当前请求引用的变量，并说明当前值的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「檢查請求」列出目前請求引用的變數及其值的來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト確認では、参照している変数と現在の値の取得元を表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inspection liste les variables référencées et la provenance de leurs valeurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A inspeção lista variáveis usadas e a origem dos valores atuais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inspección lista variables usadas y el origen de sus valores actuales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 확인은 참조하는 변수와 현재 값의 출처를 표시합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrageprüfung zeigt referenzierte Variablen und die Herkunft ihrer aktuellen Werte."
          }
        }
      }
    },
    "Install the stable Rust toolchain, open a terminal at the Reqeast repository root, and build the release executable. The executable is rust/target/release/reqeast-cli. You can copy it into your preferred tools directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the stable Rust toolchain, open a terminal at the Reqeast repository root, and build the release executable. The executable is rust/target/release/reqeast-cli. You can copy it into your preferred tools directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装稳定版 Rust，在 Reqeast 仓库根目录打开终端，构建 release 可执行文件。输出为 rust/target/release/reqeast-cli，可复制到常用工具目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝穩定版 Rust，在 Reqeast 根目錄開終端機建置 release。輸出為 rust/target/release/reqeast-cli，可複製到工具目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定版 Rust を用意し、リポジトリのルートで release ビルドします。rust/target/release/reqeast-cli が生成され、任意のツール用フォルダへコピーできます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Rust stable et compilez en release depuis la racine du dépôt. Le binaire rust/target/release/reqeast-cli peut être copié dans votre dossier d’outils."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale Rust estável e compile release na raiz do repositório. Copie rust/target/release/reqeast-cli para sua pasta de ferramentas se desejar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale Rust estable y compile release desde la raíz del repositorio. Puede copiar rust/target/release/reqeast-cli a su carpeta de herramientas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정 버전 Rust를 설치하고 저장소 루트에서 release 빌드하세요. rust/target/release/reqeast-cli 실행 파일을 원하는 도구 폴더로 복사할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabiles Rust installieren und im Repository-Root release bauen. Die Datei rust/target/release/reqeast-cli kann in Ihren Werkzeugordner kopiert werden."
          }
        }
      }
    },
    "Missing Variable means the active environment has no enabled value. Choose the correct environment, add the value there, or run the earlier extraction request first. Send stops before making a network request when required variables are missing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing Variable means the active environment has no enabled value. Choose the correct environment, add the value there, or run the earlier extraction request first. Send stops before making a network request when required variables are missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“缺少变量”表示当前环境没有启用的值。切换环境、补齐值，或先运行提取它的请求。必需变量缺失时，发送会在联网前停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少變數表示目前環境沒有啟用值。切換環境、補值或先執行擷取請求。必要變數缺少時會在連線前停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定は、現在の環境に有効な値がないことを示します。環境を選び直すか値を設定し、取得元を先に実行します。不足時は通信前に停止します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une variable manquante n’a pas de valeur active. Changez d’environnement, définissez-la ou lancez son extraction. L’envoi est bloqué avant la connexion si elle manque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variável ausente não tem valor ativo. Troque o ambiente, defina-a ou execute sua extração. O envio para antes da conexão se faltar um valor necessário."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una variable ausente no tiene valor activo. Cambie el entorno, defínala o ejecute su extracción. El envío se detiene antes de conectar si falta un valor necesario."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누락된 변수는 활성 환경에 유효한 값이 없다는 뜻입니다. 환경을 바꾸거나 값을 채우거나 먼저 추출 요청을 실행하세요. 필수 값이 없으면 네트워크 요청 전에 중단됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Variablen haben keinen aktiven Wert. Umgebung wechseln, Wert setzen oder Extraktion starten. Bei fehlenden Pflichtwerten stoppt das Senden vor der Verbindung."
          }
        }
      }
    },
    "Open HTTP Workflows → Project Files and click Export Project Folder. Choose a new destination folder. The export contains reqeast.json, requests/<request-id>.json, and .gitignore. Saved workflows and environments are in reqeast.json.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open HTTP Workflows → Project Files and click Export Project Folder. Choose a new destination folder. The export contains reqeast.json, requests/<request-id>.json, and .gitignore. Saved workflows and environments are in reqeast.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“HTTP 工作流 → 项目文件”，点击“导出项目文件夹”，选择新目录。包含 reqeast.json、requests/<request-id>.json 和 .gitignore；环境和工作流保存在 reqeast.json。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 HTTP 工作流程 → 專案檔案並匯出至新目錄。內含 reqeast.json、requests/<request-id>.json 與 .gitignore；環境和流程在 reqeast.json。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 手順のプロジェクトファイルから新しいフォルダに書き出します。reqeast.json、requests/<request-id>.json、.gitignore を含みます。環境と手順は reqeast.json に入ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Fichiers du projet et exportez vers un nouveau dossier. Il contient reqeast.json, requests/<request-id>.json et .gitignore. Environnements et workflows sont dans reqeast.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Arquivos do projeto e exporte para nova pasta. Ela contém reqeast.json, requests/<request-id>.json e .gitignore. Ambientes e fluxos ficam em reqeast.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Archivos del proyecto y exporte a una carpeta nueva. Contiene reqeast.json, requests/<request-id>.json y .gitignore. Entornos y flujos están en reqeast.json."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 파일에서 새 폴더로 내보내세요. reqeast.json, requests/<request-id>.json, .gitignore가 포함됩니다. 환경과 흐름은 reqeast.json에 저장됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektdateien öffnen und in neuen Ordner exportieren. Enthält reqeast.json, requests/<request-id>.json und .gitignore. Umgebungen und Abläufe liegen in reqeast.json."
          }
        }
      }
    },
    "Open Inspect Request and scroll to Request Preview. Check the method, resolved URL, query parameters, headers, Cookie header, and body. GET, HEAD, and OPTIONS bodies follow the HTTP strict-mode setting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Inspect Request and scroll to Request Preview. Check the method, resolved URL, query parameters, headers, Cookie header, and body. GET, HEAD, and OPTIONS bodies follow the HTTP strict-mode setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“检查请求”，滚动到“发送预览”，核对方法、替换后的 URL、参数、请求头、Cookie 和正文。GET、HEAD、OPTIONS 正文遵循 HTTP 严格模式设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟檢查請求，捲至傳送預覽，確認方法、替換後 URL、參數、標頭、Cookie 與本文。GET、HEAD、OPTIONS 本文依 HTTP 嚴格模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト確認からプレビューへスクロールし、メソッド、展開後 URL、パラメータ、ヘッダー、Cookie、本文を確認します。GET・HEAD・OPTIONS の本文は厳格モード設定に従います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’inspection, faites défiler jusqu’à l’aperçu. Vérifiez méthode, URL résolue, paramètres, en-têtes, Cookie et corps. GET/HEAD/OPTIONS suivent le mode HTTP strict."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na inspeção, role até a prévia. Confira método, URL resolvida, parâmetros, cabeçalhos, Cookie e corpo. GET/HEAD/OPTIONS seguem o modo HTTP estrito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la inspección, desplácese a la vista previa. Revise método, URL resuelta, parámetros, cabeceras, Cookie y cuerpo. GET/HEAD/OPTIONS siguen el modo HTTP estricto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 확인에서 미리보기로 스크롤하세요. 메서드, 치환된 URL, 매개변수, 헤더, Cookie, 본문을 확인하세요. GET/HEAD/OPTIONS 본문은 HTTP 엄격 모드 설정을 따릅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Anfrageprüfung zur Vorschau scrollen. Methode, aufgelöste URL, Parameter, Header, Cookie und Körper prüfen. GET/HEAD/OPTIONS folgen dem strikten HTTP-Modus."
          }
        }
      }
    },
    "Open Run Requests and choose New Workflow. Select All HTTP Requests or a folder. Check Login, Create order, and Query order. Use the up and down arrows to put them in that order. The first checked row is request 1, the next is request 2; unchecked rows are skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Run Requests and choose New Workflow. Select All HTTP Requests or a folder. Check Login, Create order, and Query order. Use the up and down arrows to put them in that order. The first checked row is request 1, the next is request 2; unchecked rows are skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“批量运行”中选“新工作流”，选择全部 HTTP 或文件夹，勾选 Login、Create order、Query order，用上下箭头依次排序。最上面的勾选项是第 1 个，下一个是第 2 个；未勾选项跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在批次執行選新工作流程，選全部 HTTP 或資料夾，勾選 Login、Create order、Query order，用上下箭頭排序。首個勾選項是第 1 個，下一個第 2 個；未勾選略過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行画面で新しい手順と全 HTTP またはフォルダを選び、Login、Create order、Query order を選択します。上下矢印で並べます。最上位の選択済みが1番、次が2番です。未選択は飛ばします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un workflow, choisissez tous les HTTP ou un dossier, cochez Login, Create order, Query order et ordonnez-les avec les flèches. La première ligne cochée est 1, la suivante 2 ; les autres sont ignorées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um fluxo, escolha todos HTTP ou uma pasta, marque Login, Create order, Query order e ordene com as setas. A primeira linha marcada é 1, a próxima é 2; as demais são puladas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree un flujo, elija todos HTTP o carpeta, marque Login, Create order, Query order y ordene con flechas. La primera fila marcada es 1, la siguiente 2; las demás se omiten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 흐름을 선택하고 전체 HTTP나 폴더를 고른 뒤 Login, Create order, Query order를 체크해 화살표로 정렬하세요. 첫 체크 행이 1번, 다음이 2번이며 미선택 행은 건너뜁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuen Ablauf und alle HTTP oder einen Ordner wählen. Login, Create order, Query order markieren und mit Pfeilen ordnen. Erste markierte Zeile ist 1, nächste 2; unmarkierte werden übersprungen."
          }
        }
      }
    },
    "Open Run Requests, choose your saved workflow, and click Import CSV or JSON under Test Data. Check Data Rows and the column names. Values are hidden in the panel. Review the source file before running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Run Requests, choose your saved workflow, and click Import CSV or JSON under Test Data. Check Data Rows and the column names. Values are hidden in the panel. Review the source file before running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“批量运行”，选择保存的工作流，在“测试数据”中点击“导入 CSV 或 JSON”。核对行数和列名，值不会显示。运行前请检查源文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟批次執行選儲存流程，在測試資料按匯入 CSV 或 JSON。核對列數與欄名，值不顯示。執行前請檢查原檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み手順を選び、テストデータで CSV/JSON を読み込みます。行数と列名を確認します。値は表示しません。実行前に元ファイルを確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le workflow puis importez CSV/JSON dans Données de test. Vérifiez nombre de lignes et colonnes. Les valeurs sont masquées ; contrôlez le fichier source."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o fluxo e importe CSV/JSON em Dados de teste. Confira quantidade de linhas e colunas. Valores ficam ocultos; revise o arquivo original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione el flujo e importe CSV/JSON en Datos de prueba. Revise número de filas y columnas. Los valores se ocultan; compruebe el archivo original."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 흐름의 테스트 데이터에서 CSV/JSON을 가져오세요. 행 수와 열 이름을 확인하세요. 값은 숨겨지므로 원본 파일을 검토하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherten Ablauf wählen und CSV/JSON unter Testdaten importieren. Zeilenanzahl und Spalten prüfen. Werte sind verborgen; Quelldatei kontrollieren."
          }
        }
      }
    },
    "Open Variables & Checks. Click Add Response Variable, choose /data/token, name the variable token, and enable Secret variable. Click Save Variables from Current Response. Future successful sends extract enabled rules automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Variables & Checks. Click Add Response Variable, choose /data/token, name the variable token, and enable Secret variable. Click Save Variables from Current Response. Future successful sends extract enabled rules automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“变量与检查”，添加响应变量。选择 /data/token，变量名填 token，启用敏感变量，再点击“从当前响应保存变量”。以后成功发送会自动执行启用的提取规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟變數與檢查，新增回應變數，選 /data/token，名稱 token，啟用敏感變數並從目前回應儲存。之後成功傳送會自動執行擷取規則。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数とチェックで取得ルールを追加し、/data/token、名前 token、秘密変数を設定します。現在のレスポンスから保存を押します。以後、成功時に有効なルールで自動取得します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une variable de réponse dans Variables et vérifications : /data/token, nom token, secret activé. Enregistrez depuis la réponse actuelle. Les règles actives s’appliquent ensuite automatiquement après réussite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione variável de resposta em Variáveis e verificações: /data/token, nome token, segredo ativado. Salve da resposta atual. Regras ativas passam a extrair automaticamente após sucesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada variable de respuesta en Variables y comprobaciones: /data/token, nombre token, secreto activo. Guarde desde la respuesta actual. Las reglas activas extraen automáticamente tras el éxito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수 및 검사에서 응답 변수를 추가하고 /data/token, 이름 token, 비밀 변수를 설정하세요. 현재 응답에서 저장을 누르면 이후 성공 시 활성 규칙이 자동 추출합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwortvariable unter Variablen und Prüfungen hinzufügen: /data/token, Name token, geheim aktiv. Aus aktueller Antwort speichern. Aktive Regeln extrahieren künftig automatisch bei Erfolg."
          }
        }
      }
    },
    "Open the environment picker and manage environments. Create Test and add baseUrl, username, password, and product. Mark password as secret. Activate Test. Use {{baseUrl}} in the URL and variable references in the request body.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the environment picker and manage environments. Create Test and add baseUrl, username, password, and product. Mark password as secret. Activate Test. Use {{baseUrl}} in the URL and variable references in the request body."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开环境菜单并管理环境，创建 Test，添加 baseUrl、username、password、product，把 password 标为敏感值并启用 Test。URL 用 {{baseUrl}}，正文也使用变量引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開環境選單管理環境，建立 Test，新增 baseUrl、username、password、product。password 標為敏感值並啟用 Test。URL 用 {{baseUrl}}，本文使用變數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境管理で Test を作り、baseUrl、username、password、product を追加します。password を秘密にし Test を有効化します。URL は {{baseUrl}}、本文も変数参照を使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez Test dans la gestion des environnements avec baseUrl, username, password, product. Marquez password secret et activez Test. Utilisez {{baseUrl}} dans l’URL et les variables dans le corps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie Test no gerenciador com baseUrl, username, password, product. Marque password como segredo e ative Test. Use {{baseUrl}} na URL e variáveis no corpo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree Test en el gestor con baseUrl, username, password, product. Marque password secreto y active Test. Use {{baseUrl}} en URL y variables en el cuerpo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 관리에서 Test를 만들고 baseUrl, username, password, product를 추가하세요. password를 비밀로 설정하고 Test를 활성화하세요. URL에 {{baseUrl}}, 본문에도 변수 참조를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Test in der Umgebungsverwaltung mit baseUrl, username, password, product erstellen. password geheim markieren und Test aktivieren. {{baseUrl}} in URL und Variablen im Körper verwenden."
          }
        }
      }
    },
    "Preview prepares the request through the same path as Send, so you can check variable replacement and credentials before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview prepares the request through the same path as Send, so you can check variable replacement and credentials before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览与发送使用相同的请求准备逻辑，可以在发送前核对变量替换和认证内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽與傳送共用準備邏輯，可在傳送前確認變數替換與認證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューは送信と同じ準備処理を使い、変数展開と認証を事前確認できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu utilise la même préparation que l’envoi pour vérifier variables et authentification."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia usa a mesma preparação do envio para conferir variáveis e autenticação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa usa la misma preparación del envío para comprobar variables y autenticación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기는 전송과 같은 준비 로직으로 변수 치환과 인증을 확인합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau verwendet dieselbe Vorbereitung wie das Senden, um Variablen und Authentifizierung zu prüfen."
          }
        }
      }
    },
    "Preview uses the same request preparation as Send. It shows the current environment, headers, cookies, and body before redirects. Signed credentials are generated again when sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview uses the same request preparation as Send. It shows the current environment, headers, cookies, and body before redirects. Signed credentials are generated again when sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览与发送共用准备逻辑，显示当前环境替换后的地址、请求头、Cookie 和正文，内容是重定向之前的请求。签名凭据会在发送时重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽與傳送共用準備邏輯，顯示目前環境替換後的位址、標頭、Cookie 與本文，為重新導向前的內容。簽章憑證傳送時重新產生。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューは送信と同じ処理で環境、ヘッダー、Cookie、本文を準備します。表示はリダイレクト前です。署名情報は送信時に再生成します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu prépare environnement, en-têtes, cookies et corps comme l’envoi, avant redirections. Les signatures sont régénérées à l’envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia prepara ambiente, cabeçalhos, cookies e corpo como o envio, antes de redirecionar. Assinaturas são geradas novamente ao enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista prepara entorno, cabeceras, cookies y cuerpo igual que el envío, antes de redirigir. Las firmas se generan de nuevo al enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기는 전송과 같은 방식으로 환경, 헤더, Cookie, 본문을 준비하며 리디렉션 전 내용을 표시합니다. 서명은 전송 시 다시 생성합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau bereitet Umgebung, Header, Cookies und Körper wie das Senden vor, vor Umleitungen. Signaturen werden beim Senden neu erzeugt."
          }
        }
      }
    },
    "Save Order test in the app and export its project folder. Workflow and environment names must match exactly. Use --environment to choose an environment explicitly; otherwise the saved environment or first exported environment is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Order test in the app and export its project folder. Workflow and environment names must match exactly. Use --environment to choose an environment explicitly; otherwise the saved environment or first exported environment is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序保存 Order test 并导出项目。工作流、环境名称必须完全一致。--environment 可显式指定环境；未指定时使用工作流保存的环境或第一个导出环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在程式儲存 Order test 並匯出。流程與環境名稱須完全一致。--environment 可指定環境；否則使用流程的環境或首個匯出環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリで Order test を保存して書き出します。手順と環境名は完全一致させます。--environment 指定がなければ、保存環境または最初の環境を使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez Order test puis exportez. Les noms doivent correspondre exactement. --environment choisit l’environnement ; sinon celui enregistré ou le premier exporté est utilisé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve Order test e exporte. Nomes devem coincidir exatamente. --environment escolhe o ambiente; sem ele usa o salvo ou o primeiro exportado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde Order test y exporte. Los nombres deben coincidir exactamente. --environment elige el entorno; sin él se usa el guardado o el primero exportado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Order test를 저장하고 내보내세요. 흐름과 환경 이름은 정확히 일치해야 합니다. --environment가 없으면 저장한 환경 또는 첫 내보낸 환경을 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Order test speichern und exportieren. Namen müssen exakt übereinstimmen. --environment wählt die Umgebung; sonst gespeicherte oder erste exportierte Umgebung."
          }
        }
      }
    },
    "Save a named sequence and its environment. Requests keep their own extraction and check rules; editing a request changes future runs of the workflow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a named sequence and its environment. Requests keep their own extraction and check rules; editing a request changes future runs of the workflow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存命名的请求顺序和环境。提取和检查规则仍保存在各请求上；修改请求会影响工作流的后续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存具名順序與環境。擷取與檢查規則仍在各請求；修改請求會影響後續執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きの順序と環境を保存します。取得・チェックは各リクエストに属し、編集は次の実行に反映されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez séquence nommée et environnement. Les règles restent sur les requêtes ; leurs modifications affectent les prochains lancements."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve sequência nomeada e ambiente. Regras ficam nas requisições; alterações afetam as próximas execuções."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde secuencia con nombre y entorno. Las reglas quedan en solicitudes; sus cambios afectan próximas ejecuciones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 있는 순서와 환경을 저장합니다. 추출·검사 규칙은 요청에 저장되며 수정하면 이후 실행에 반영됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benannte Reihenfolge und Umgebung speichern. Regeln bleiben an den Anfragen; Änderungen wirken auf künftige Läufe."
          }
        }
      }
    },
    "Secret environment values and credential headers are hidden by default. Enable Show Secret Values only when needed. File bodies show attachment names and sizes. This preview is before redirects; signed credentials are generated again at send time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secret environment values and credential headers are hidden by default. Enable Show Secret Values only when needed. File bodies show attachment names and sizes. This preview is before redirects; signed credentials are generated again at send time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感环境值和认证请求头默认隐藏，必要时可开启显示。文件正文显示名称和大小。预览发生在重定向之前，签名凭据在发送时重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感環境值與認證標頭預設隱藏，可按需顯示。檔案本文顯示名稱與大小。預覽為重新導向前內容，簽章傳送時重產。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密環境値と認証ヘッダーは初期状態で非表示です。必要時のみ表示します。添付は名前とサイズです。プレビューはリダイレクト前で、署名は送信時に再生成します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets et en-têtes d’authentification sont masqués par défaut. Affichez-les au besoin. Les fichiers indiquent nom et taille. Aperçu avant redirections ; signatures recréées à l’envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segredos e cabeçalhos de autenticação são ocultos por padrão. Mostre só se necessário. Arquivos mostram nome e tamanho. Prévia antes de redirecionar; assinaturas refeitas ao enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secretos y cabeceras de autenticación se ocultan por defecto. Muestre solo si necesita. Archivos indican nombre y tamaño. Vista antes de redirecciones; firmas regeneradas al enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 값과 인증 헤더는 기본적으로 숨깁니다. 필요할 때만 표시하세요. 파일은 이름과 크기를 보여줍니다. 미리보기는 리디렉션 전이며 서명은 전송 시 다시 생성됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse und Authentifizierungsheader sind standardmäßig verborgen. Bei Bedarf anzeigen. Dateien zeigen Namen und Größe. Vorschau vor Umleitungen; Signaturen beim Senden erneuert."
          }
        }
      }
    },
    "Secret variables are empty and inline credentials become variable references. Review URLs, headers, and bodies before sharing. Refill missing secrets locally or through CLI environment variables.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secret variables are empty and inline credentials become variable references. Review URLs, headers, and bodies before sharing. Refill missing secrets locally or through CLI environment variables."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感变量导出为空，内联凭据改为变量引用。共享前请检查 URL、请求头和正文。缺失密钥需在本地或 CLI 环境变量中补齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感變數匯出為空，內嵌憑證改為變數引用。分享前檢查 URL、標頭與本文。密鑰需於本機或 CLI 環境變數補齊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密変数は空で書き出し、直接の認証値は変数参照にします。共有前に URL、ヘッダー、本文を確認し、秘密情報をローカルや CLI 環境変数で設定します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets sont vides et les identifiants deviennent des références. Vérifiez URL, en-têtes et corps avant partage. Renseignez les secrets localement ou via l’environnement CLI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segredos ficam vazios e credenciais viram referências. Revise URL, cabeçalhos e corpo antes de compartilhar. Preencha segredos localmente ou no ambiente CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos quedan vacíos y credenciales pasan a referencias. Revise URL, cabeceras y cuerpo antes de compartir. Complete secretos localmente o mediante entorno CLI."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 변수는 빈 값으로 내보내고 자격 증명은 변수 참조로 바꿉니다. 공유 전 URL, 헤더, 본문을 확인하세요. 비밀 값은 로컬이나 CLI 환경 변수로 채우세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse bleiben leer, Zugangsdaten werden Referenzen. URL, Header und Körper vor dem Teilen prüfen. Geheimnisse lokal oder per CLI-Umgebung ergänzen."
          }
        }
      }
    },
    "Secret variables are exported empty. Inline authentication credentials and recognized sensitive fields become variable references. Review URLs, headers, and bodies for other private data. Attached files and non-HTTP requests are not exported. Fill required secrets locally after importing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secret variables are exported empty. Inline authentication credentials and recognized sensitive fields become variable references. Review URLs, headers, and bodies for other private data. Attached files and non-HTTP requests are not exported. Fill required secrets locally after importing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感变量导出为空。内联认证凭据和识别出的敏感字段替换为变量引用。分享前继续检查 URL、请求头和正文中的其他私密数据。非 HTTP 和附件不导出；导入后补齐密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感變數匯出為空，認證憑證及識別的敏感欄位改為引用。分享前檢查 URL、標頭與本文中其他私密資料。非 HTTP 與附件不匯出；匯入後補齊密鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密変数は空、認証値や既知の秘密フィールドは参照に置き換えます。他の私的情報がないか URL、ヘッダー、本文を確認します。非 HTTP と添付は除外し、読み込み後に秘密情報を補います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets vides ; identifiants et champs sensibles reconnus deviennent des références. Vérifiez les autres données privées dans URL, en-têtes et corps. Non-HTTP et pièces jointes exclus ; complétez les secrets après import."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segredos vazios; credenciais e campos sensíveis reconhecidos viram referências. Revise outros dados privados em URL, cabeçalhos e corpo. Não-HTTP e anexos excluídos; preencha segredos após importar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secretos vacíos; credenciales y campos sensibles reconocidos se convierten en referencias. Revise otros datos privados en URL, cabeceras y cuerpo. No-HTTP y adjuntos excluidos; complete secretos al importar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 값은 비우고 인증과 알려진 민감 필드는 변수 참조로 대체합니다. URL, 헤더, 본문에 다른 개인정보가 없는지 확인하세요. 비 HTTP와 첨부는 제외되며 가져온 후 비밀 값을 채워야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse leer; Zugangsdaten und erkannte sensible Felder werden Referenzen. Andere private Daten in URL, Headern und Körper prüfen. Nicht-HTTP und Anhänge ausgeschlossen; nach Import Geheimnisse ergänzen."
          }
        }
      }
    },
    "Select Create order, open Authentication, choose Bearer Token and enter {{token}}. Use the same Test environment. Send it after Login has succeeded. To capture the created order ID, add a rule on Create order from /data/id to orderId, then use {{orderId}} in Query order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Create order, open Authentication, choose Bearer Token and enter {{token}}. Use the same Test environment. Send it after Login has succeeded. To capture the created order ID, add a rule on Create order from /data/id to orderId, then use {{orderId}} in Query order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选 Create order，在认证中选 Bearer Token，填 {{token}}，使用同一 Test 环境，在 Login 成功后发送。在 Create order 上增加 /data/id → orderId 的提取规则，再在 Query order 使用 {{orderId}}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選 Create order，認證用 Bearer Token 與 {{token}}，同一 Test 環境，在 Login 成功後傳送。加 /data/id → orderId 擷取，再於 Query order 用 {{orderId}}。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Create order の認証を Bearer Token、{{token}} にし、同じ Test 環境で Login 成功後に送信します。/data/id を orderId に取得し、Query order で {{orderId}} を使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Create order, choisissez Bearer Token et {{token}}, même environnement Test, après Login. Extrayez /data/id vers orderId, puis utilisez {{orderId}} dans Query order."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Create order, use Bearer Token e {{token}}, no mesmo Test, após Login. Extraia /data/id para orderId e use {{orderId}} em Query order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Create order, use Bearer Token y {{token}}, mismo Test, después de Login. Extraiga /data/id a orderId y use {{orderId}} en Query order."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Create order 인증을 Bearer Token, {{token}}으로 설정하고 같은 Test 환경에서 Login 성공 후 전송하세요. /data/id를 orderId로 추출해 Query order에 {{orderId}}를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Create order Bearer Token und {{token}} setzen, gleiche Test-Umgebung nach Login. /data/id nach orderId extrahieren und {{orderId}} in Query order verwenden."
          }
        }
      }
    },
    "Select Login in the sidebar, activate Test, enter the login body and click Send. Confirm a 2xx response with a token. The example response is below; your response field may differ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Login in the sidebar, activate Test, enter the login body and click Send. Confirm a 2xx response with a token. The example response is below; your response field may differ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧栏选 Login，启用 Test，填写登录正文并发送。确认返回 2xx 且包含 token。下面是示例响应，实际字段以你的 API 为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側欄選 Login，啟用 Test，填登入本文並傳送。確認 2xx 且含 token。以下僅示範，欄位依實際 API。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーで Login を選び Test を有効にし、本文を入力して送信します。2xx と token を確認します。下は例で、フィールドは API に合わせます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez Login, activez Test, saisissez le corps et envoyez. Vérifiez une réponse 2xx avec token. L’exemple ci-dessous dépend de votre API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione Login, ative Test, preencha o corpo e envie. Confira resposta 2xx com token. O exemplo abaixo depende da sua API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione Login, active Test, complete cuerpo y envíe. Compruebe respuesta 2xx con token. El ejemplo depende de su API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 Login을 선택하고 Test를 켠 뒤 본문을 채워 전송하세요. token이 포함된 2xx 응답을 확인하세요. 아래 필드는 예시이므로 API에 맞추세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Login wählen, Test aktivieren, Körper eingeben und senden. 2xx mit Token prüfen. Beispiel unten; Felder an Ihre API anpassen."
          }
        }
      }
    },
    "Select a saved workflow, change the selection or order, and click Save Workflow to replace it. Delete Workflow removes only the saved sequence. If a request or its selected environment was deleted, repair the workflow before running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a saved workflow, change the selection or order, and click Save Workflow to replace it. Delete Workflow removes only the saved sequence. If a request or its selected environment was deleted, repair the workflow before running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已保存工作流，调整勾选项或顺序，再点击保存即可覆盖。删除工作流只移除流程，不删除请求。请求或指定环境被删除时，请先修复工作流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選已儲存流程，調整勾選或順序後再儲存覆寫。刪除流程不刪請求。請求或環境被刪除時，先修復流程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み手順を選び、選択や順序を変えて再保存します。削除は手順のみでリクエストは残ります。リクエストや指定環境が消えたら先に修正してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez la sélection ou l’ordre puis enregistrez pour remplacer. Supprimer le workflow conserve les requêtes. Réparez les références si une requête ou l’environnement a été supprimé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere seleção ou ordem e salve para substituir. Excluir fluxo mantém requisições. Corrija referências se uma requisição ou ambiente foi removido."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie selección u orden y guarde para sustituir. Eliminar flujo conserva solicitudes. Corrija referencias si se eliminó una solicitud o entorno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 흐름을 선택해 순서나 선택을 바꾸고 다시 저장하세요. 흐름 삭제는 요청을 삭제하지 않습니다. 요청이나 지정 환경이 삭제되면 먼저 참조를 수정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl oder Reihenfolge ändern und erneut speichern. Ablauf löschen erhält Anfragen. Referenzen reparieren, wenn Anfrage oder Umgebung entfernt wurde."
          }
        }
      }
    },
    "Select a variable to see its value, source request, response field, and last update. Missing variables must be defined before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a variable to see its value, source request, response field, and last update. Missing variables must be defined before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击变量可查看值、来源请求、响应字段和更新时间。缺少的变量需要在发送前补齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按變數可看值、來源請求、回應欄位與更新時間。傳送前須補齊缺少變數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数を選ぶと値、取得元、フィールド、更新時刻を確認できます。不足する変数は送信前に設定してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une variable pour voir valeur, requête source, champ et date. Complétez les variables manquantes avant envoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione variável para ver valor, origem, campo e data. Defina as ausentes antes de enviar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione variable para ver valor, origen, campo y fecha. Complete las ausentes antes de enviar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수를 눌러 값, 출처 요청, 필드, 시간을 확인하세요. 누락된 변수는 전송 전에 채우세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable wählen, um Wert, Quelle, Feld und Zeitpunkt zu sehen. Fehlende Variablen vor dem Senden ergänzen."
          }
        }
      }
    },
    "Select an HTTP request and click the flowchart button in the editor toolbar. The panel contains Variables & Checks, Compare Responses, Run Requests, Inspect Request, and Project Files. You can also open this manual from Settings → HTTP Workflow Guide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an HTTP request and click the flowchart button in the editor toolbar. The panel contains Variables & Checks, Compare Responses, Run Requests, Inspect Request, and Project Files. You can also open this manual from Settings → HTTP Workflow Guide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中 HTTP 请求，点击编辑器工具栏的流程图按钮。面板包含变量与检查、响应对比、批量运行、检查请求和项目文件。也可从“设置 → HTTP 工作流指南”打开本手册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選 HTTP 請求並按工具列流程圖按鈕。面板含變數與檢查、回應比較、批次執行、檢查請求及專案檔案。設定 → HTTP 工作流程指南也可開手冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエストでツールバーのフローチャートを押します。変数、比較、実行、確認、プロジェクトファイルがあります。設定の HTTP ガイドからも開けます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez HTTP et cliquez sur le diagramme de la barre d’outils. Le panneau propose variables, comparaison, exécution, inspection et fichiers. Le manuel est aussi dans Réglages → Guide HTTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione HTTP e clique no fluxograma da barra. O painel tem variáveis, comparação, execução, inspeção e arquivos. O manual também fica em Ajustes → Guia HTTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione HTTP y pulse el diagrama de la barra. El panel incluye variables, comparación, ejecución, inspección y archivos. El manual está también en Ajustes → Guía HTTP."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청에서 도구 모음의 흐름도 버튼을 누르세요. 변수, 비교, 일괄 실행, 요청 확인, 프로젝트 파일을 제공합니다. 설정의 HTTP 안내에서도 설명서를 열 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Anfrage wählen und Flussdiagramm in der Werkzeugleiste öffnen. Bereiche: Variablen, Vergleich, Lauf, Prüfung, Dateien. Handbuch auch unter Einstellungen → HTTP-Anleitung."
          }
        }
      }
    },
    "Select the request that uses {{token}} and open HTTP Workflows → Inspect Request. Under Variable Sources, click {{token}} to expand its details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the request that uses {{token}} and open HTTP Workflows → Inspect Request. Under Variable Sources, click {{token}} to expand its details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择使用 {{token}} 的请求，打开“HTTP 工作流 → 检查请求”。在变量来源中点击 {{token}} 展开详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選使用 {{token}} 的請求，開 HTTP 工作流程 → 檢查請求，在變數來源點 {{token}} 展開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{token}} を使うリクエストで確認画面を開き、変数の取得元で {{token}} を展開します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez la requête utilisant {{token}} et développez {{token}} dans la provenance des variables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione a requisição que usa {{token}} e expanda {{token}} em Origem das variáveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeccione la solicitud que usa {{token}} y expanda {{token}} en Origen de variables."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{token}}을 사용하는 요청의 확인 화면을 열고 변수 출처에서 {{token}}을 펼치세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage mit {{token}} prüfen und {{token}} unter Variablenherkunft aufklappen."
          }
        }
      }
    },
    "Set secret values with REQEAST_VAR_name environment variables, or pass a local JSON object with --secrets. Environment variables override the secret file. Add --data cases.csv or cases.json for row-based tests. Data-row values override environment values for that row.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set secret values with REQEAST_VAR_name environment variables, or pass a local JSON object with --secrets. Environment variables override the secret file. Add --data cases.csv or cases.json for row-based tests. Data-row values override environment values for that row."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 REQEAST_VAR_name 环境变量或 --secrets 指定的本地 JSON 对象提供密钥。环境变量覆盖密钥文件。--data 可指定 cases.csv 或 cases.json；数据行值覆盖该行的环境值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 REQEAST_VAR_name 或 --secrets 的本機 JSON 提供密鑰。環境變數優先於密鑰檔。--data 指定 cases.csv/json；每列資料覆寫該列環境值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "REQEAST_VAR_name または --secrets のローカル JSON で秘密情報を指定します。環境変数がファイルより優先です。--data で CSV/JSON を指定し、行の値が環境値を上書きします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournissez les secrets par REQEAST_VAR_name ou JSON local --secrets. L’environnement prime sur le fichier. --data accepte cases.csv/json ; les valeurs de ligne remplacent l’environnement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forneça segredos por REQEAST_VAR_name ou JSON local --secrets. Ambiente tem prioridade sobre arquivo. --data aceita cases.csv/json; valores da linha substituem o ambiente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporcione secretos con REQEAST_VAR_name o JSON local --secrets. El entorno tiene prioridad sobre el archivo. --data acepta cases.csv/json; los valores de fila sustituyen al entorno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "REQEAST_VAR_name 또는 --secrets 로컬 JSON으로 비밀 값을 제공하세요. 환경 변수는 파일보다 우선합니다. --data로 CSV/JSON을 지정하면 행 값이 환경 값을 덮어씁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse per REQEAST_VAR_name oder lokalem JSON mit --secrets angeben. Umgebung hat Vorrang vor Datei. --data akzeptiert CSV/JSON; Zeilenwerte überschreiben Umgebungswerte."
          }
        }
      }
    },
    "Set secrets with REQEAST_VAR_token or a local JSON object via --secrets. Secret files are excluded by the exported .gitignore. Reports contain status and checks without response bodies or variable values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set secrets with REQEAST_VAR_token or a local JSON object via --secrets. Secret files are excluded by the exported .gitignore. Reports contain status and checks without response bodies or variable values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 REQEAST_VAR_token 或 --secrets 的本地 JSON 提供密钥。导出的 .gitignore 会排除密钥文件。报告只含状态与检查，不含响应正文和变量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 REQEAST_VAR_token 或 --secrets 本機 JSON 提供密鑰。.gitignore 排除密鑰檔。報告含狀態與檢查，不含本文或變數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "REQEAST_VAR_token または --secrets の JSON で秘密情報を設定します。書き出した .gitignore は秘密ファイルを除外します。レポートは状態とチェックのみで本文や変数値を含みません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez REQEAST_VAR_token ou JSON --secrets. Le .gitignore exporté exclut les fichiers secrets. Les rapports incluent statuts et contrôles, sans corps ni valeurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use REQEAST_VAR_token ou JSON --secrets. O .gitignore exportado exclui segredos. Relatórios incluem status e verificações, sem corpos ou valores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use REQEAST_VAR_token o JSON --secrets. El .gitignore exportado excluye secretos. Los informes incluyen estados y comprobaciones sin cuerpos ni valores."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "REQEAST_VAR_token 또는 --secrets JSON을 사용하세요. 내보낸 .gitignore는 비밀 파일을 제외합니다. 보고서는 상태와 검사만 포함하고 본문과 변수 값은 제외합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "REQEAST_VAR_token oder JSON --secrets verwenden. Exportiertes .gitignore schließt Geheimnisdateien aus. Berichte enthalten Status und Prüfungen, keine Körper oder Werte."
          }
        }
      }
    },
    "Share HTTP projects through readable JSON files and review their changes with Git. This is an explicit export and import, not a live filesystem sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share HTTP projects through readable JSON files and review their changes with Git. This is an explicit export and import, not a live filesystem sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用可读的 JSON 文件共享 HTTP 项目，以 Git 检查改动。这里是手动导出和导入，不会实时同步文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用可讀 JSON 分享 HTTP 專案，以 Git 檢查變更。此處為手動匯入匯出，不會即時同步資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすい JSON で HTTP プロジェクトを共有し Git で差分を確認します。手動の書き出しと読み込みで、リアルタイム同期ではありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez les projets HTTP en JSON lisible et vérifiez les changements avec Git. Import/export explicite, sans synchronisation en direct."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe projetos HTTP em JSON legível e revise com Git. Importação/exportação explícita, sem sincronização ao vivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparta proyectos HTTP en JSON legible y revise con Git. Importación/exportación explícita, sin sincronización en vivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 쉬운 JSON으로 HTTP 프로젝트를 공유하고 Git으로 검토합니다. 수동 가져오기·내보내기이며 실시간 폴더 동기화가 아닙니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Projekte mit lesbarem JSON teilen und mit Git prüfen. Expliziter Export/Import, keine Live-Synchronisierung."
          }
        }
      }
    },
    "The first request produces a value that a later request uses. Guide step numbers describe operations; request execution numbers are shown in Run Requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first request produces a value that a later request uses. Guide step numbers describe operations; request execution numbers are shown in Run Requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一个请求产生后一个请求要用的值。手册编号表示操作步骤；实际请求顺序显示在批量运行列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前一請求產生後一請求要用的值。手冊編號是操作步驟；實際請求順序在批次執行列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先のリクエストが後で使う値を生成します。説明の番号は操作手順で、実際の実行順序はリストに表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une requête produit la valeur utilisée ensuite. Les numéros du guide sont les étapes ; l’ordre réel figure dans la liste d’exécution."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma requisição produz valor usado depois. Números do guia são etapas; a ordem real aparece na lista de execução."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una solicitud produce un valor usado después. Los números de la guía son pasos; el orden real está en la lista de ejecución."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 요청이 다음 요청에 필요한 값을 생성합니다. 설명서 번호는 작업 단계이며 실제 요청 순서는 실행 목록에 표시합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anfrage erzeugt den Wert für die nächste. Handbuchnummern sind Schritte; die tatsächliche Reihenfolge steht in der Laufliste."
          }
        }
      }
    },
    "Use a CSV or JSON file to run the whole workflow once per data row. Rows are isolated and do not overwrite the saved environment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a CSV or JSON file to run the whole workflow once per data row. Rows are isolated and do not overwrite the saved environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行 CSV/JSON 数据执行一遍整个工作流。各行相互独立，不会覆盖保存的环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每列 CSV/JSON 執行一次完整流程，各列獨立，不覆寫儲存環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV/JSON の各行で全手順を実行します。行は独立し、保存した環境は変わりません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne CSV/JSON exécute le workflow entier, isolément, sans modifier l’environnement sauvegardé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha CSV/JSON executa todo o fluxo de forma isolada, sem alterar o ambiente salvo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fila CSV/JSON ejecuta todo el flujo de forma aislada sin cambiar el entorno guardado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV/JSON의 각 행마다 전체 흐름을 실행하며 행은 독립적이고 저장한 환경은 바뀌지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede CSV/JSON-Zeile führt den ganzen Ablauf isoliert aus, ohne die gespeicherte Umgebung zu ändern."
          }
        }
      }
    },
    "reqeast-cli runs exported HTTP workflows using the Rust networking core. It supports none, Bearer, Basic, and API Key authentication with JSON, raw, URL-encoded, and text multipart bodies. Attached files and signed authentication require the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli runs exported HTTP workflows using the Rust networking core. It supports none, Bearer, Basic, and API Key authentication with JSON, raw, URL-encoded, and text multipart bodies. Attached files and signed authentication require the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli 使用 Rust 网络核心运行导出的 HTTP 工作流。支持无认证、Bearer、Basic、API Key，以及 JSON、原始文本、URL 编码和纯文本 multipart 正文。附件及签名认证请在程序中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli 用 Rust 核心執行匯出 HTTP 流程。支援無認證、Bearer、Basic、API Key 及 JSON、原始文字、URL 編碼、純文字 multipart。附件與簽章認證請用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli は Rust コアで HTTP 手順を実行します。認証なし、Bearer、Basic、API Key と JSON、raw、URL エンコード、テキスト multipart に対応します。添付と署名認証はアプリを使ってください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli exécute les workflows HTTP avec le cœur Rust. Auth : aucune, Bearer, Basic, API Key. Corps : JSON, brut, URL-encodé, multipart texte. Pièces jointes et signatures nécessitent l’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli executa fluxos HTTP pelo núcleo Rust. Auth: nenhuma, Bearer, Basic, API Key. Corpo: JSON, texto, URL-encoded e multipart textual. Anexos e assinaturas precisam do app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli ejecuta flujos HTTP con núcleo Rust. Auth: ninguna, Bearer, Basic, API Key. Cuerpo: JSON, texto, URL-encoded y multipart textual. Adjuntos y firmas requieren la app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli는 Rust 코어로 HTTP 흐름을 실행합니다. 인증 없음/Bearer/Basic/API Key, JSON/원시 텍스트/URL 인코딩/텍스트 multipart를 지원합니다. 첨부와 서명 인증은 앱을 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "reqeast-cli führt HTTP-Abläufe mit Rust-Kern aus. Auth: keine, Bearer, Basic, API Key. Körper: JSON, Raw, URL-kodiert, Text-Multipart. Anhänge und signierte Auth brauchen die App."
          }
        }
      }
    },
