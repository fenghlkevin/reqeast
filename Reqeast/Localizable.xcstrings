    "Requests run one at a time in the order below. Extracted variables are available to the next request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen laufen einzeln in dieser Reihenfolge. Extrahierte Variablen stehen der nächsten Anfrage zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests run one at a time in the order below. Extracted variables are available to the next request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes se ejecutan una a una en este orden. Las variables extraídas están disponibles para la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes s’exécutent une à une dans cet ordre. Les variables extraites sont disponibles pour la suivante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の順序で一つずつ実行します。取得した変数は次のリクエストで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 순서대로 하나씩 실행됩니다. 추출된 변수는 다음 요청에서 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As requisições são executadas uma por vez nesta ordem. As variáveis extraídas ficam disponíveis para a próxima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求按以下顺序逐个执行，提取的变量可用于下一个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求依以下順序逐一執行，擷取的變數可用於下一個請求。"
          }
        }
      }
    },
